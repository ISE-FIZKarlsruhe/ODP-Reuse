    skos:exactMatch lpbfo:LPBFO_00809 ;
    mds:hasStudyStage "Formulation" ;
    mds:inDomain mdsdom:LPBF .

mds:Segmentation a owl:Class ;
    rdfs:label "Segmentation"@en ;
    rdfs:subClassOf mds:ImageProcessing ;
    skos:altLabel "" ;
    skos:definition "An image analysis process that divides an image into meaningful regions or objects."@en ;
    mds:hasStudyStage "Data Processing" ;
    mds:inDomain mdsdom:SEM .

mds:SegmentsPerParallelString a owl:Class ;
    rdfs:label "SegmentsPerParallelString" ;
    rdfs:subClassOf mds:AnalyticalResult ;
    skos:altLabel "Segs per Par" ;
    skos:definition "Number of cells in a parallel string." ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:Electrical .

mds:SelectiveLaserMelting a owl:Class ;
    rdfs:label "SelectiveLaserMelting"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:isDefinedBy " ISO/ASTM 52900"@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "According to ISO/ASTM 52900, the Selective Laser Melting process is now commonly called LaserPowderBedFusion (L-PBF). Additive manufacturing process, in which thermal energy provided by a laser specifically melts areas of a powder bed."@en ;
    skos:exactMatch lpbfo:LPBFO_00005 ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:LPBF .

mds:Selectivity a owl:Class ;
    rdfs:label "Selectivity"@en ;
    rdfs:subClassOf bfo:BFO_0000016 ;
    skos:altLabel " " ;
    skos:definition "It sometimes refers to the discrimination shown by a given reactant A when it reacts with two alternative reactants B and C, or in two different ways (e.g. at two different sites) with a reactant B. The term also sometimes refers to the ratio of products obtained from given reactants. This meaning is of importance for catalysts, which can have a wide range of selectivities. Selectivity is quantitatively expressed by ratios of rate constants for the alternative reactions, or by the decadic logarithms of such ratios.[IUPAC]"@en ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Reactions ;
    cco:ont00001754 "https://doi.org/10.1351/goldbook.S05563"@en .

mds:SelectorVector a owl:Class ;
    rdfs:label "SelectorVector"@en ;
    rdfs:subClassOf cco:ont00000958 ;
    skos:definition "One-hot-encoding of properties of interest" ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:EnerMat .

mds:SEMdetector a owl:Class ;
    rdfs:label "ScanningElectronMicroscopeDetector" ;
    rdfs:subClassOf mds:Detector ;
    skos:altLabel "SEM Detector" ;
    skos:definition "A detector used in a scanning electron microscope to collect signals produced by interactions between an electron beam and a sample." ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:SEM .

