    mds:inDomain mdsdom:EnerMat .

mds:Potting a owl:Class ;
    rdfs:label "Potting" ;
    rdfs:subClassOf cco:ont00000908 ;
    skos:altLabel " " ;
    skos:definition "Process of encapsulating sample's components with a material to protect them from environmental stresses; in PV module, PV is usually done on the junction box." ;
    mds:hasStudyStage "Formulation",
        "Materials Processing",
        "Sample" ;
    mds:inDomain mdsdom:PV-Cell .

mds:PouringTemperature a owl:Class ;
    rdfs:label "PouringTemperature"@en ;
    qudt:applicableUnit unit:DEG_C ;
    rdfs:subClassOf mds:ProcessingTemperature ;
    skos:definition "The temperature of molten material when poured into a mold."@en ;
    mds:hasStudyStage "Process" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:PowderBedFusionLaserBeamMetalMachine a owl:Class ;
    rdfs:label "PowderBedFusionLaserBeamMetalMachine" ;
    dcmi:source "Expert"@en ;
    rdfs:comment "This term is reused from https://github.com/ThomasBjarsch/ODE_AM/blob/main/PBFAO.ttl"@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <https://w3id.org/ODE_AM/AMAO#AdditiveManufacturingMachine> [ a owl:Restriction ;
                        owl:onProperty <http://www.ontologyrepository.com/CommonCoreOntologies/is_input_of> ;
                        owl:someValuesFrom pbfa:ActOfPowderBedFusionLaserBeamMetal ] ) ] ;
    skos:altLabel "PBF-LB/M machine"@en ;
    skos:definition "Machine that uses a high-powered laser to selectively melt and fuse metal powder particles layer by layer to build complex parts and components"@en ;
    skos:exactMatch pbfa:PowderBedFusionLaserBeamMetalMachine ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:LPBF .

mds:PowderDiameter a owl:Class ;
    rdfs:label "PowderDiameter"@en ;
    qudt:applicableUnit unit:MicroM ;
    rdfs:subClassOf mds:PowderParticleSize ;
    skos:altLabel "D50",
        "Median Particle Size",
        "Particle Diameter" ;
    skos:definition "The mean or median diameter of powder particles, characterizing the particle size distribution."@en ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:PowderFeedRate a owl:Class ;
    rdfs:label "PowderFeedRate"@en ;
    qudt:applicableUnit unit:GM-PER-MIN ;
    rdfs:subClassOf mds:ProcessingParameter ;
    skos:altLabel "Feed Rate",
        "Powder Flow Rate" ;
    skos:definition "The mass or volume rate at which powder material is delivered to the processing zone in powder-based manufacturing."@en ;
    mds:hasStudyStage "Process" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:PowderLoss a owl:Class ;
    rdfs:label "PowderLoss"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "The powder loss is the quantity of powder lost (such as when collecting the powder) or exciting somewhere else (such as a filter, a vacuum cleaner)."@en ;
    skos:exactMatch lpbfo:LPBFO_00816 ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:LPBF .

mds:PowderParticleSize a owl:Class ;
    rdfs:label "PowderParticleSize"@en ;
    qudt:applicableUnit unit:MicroM ;
    rdfs:subClassOf mds:ProcessingParameter ;
    skos:altLabel "Grain Size",
        "Particle Size",
        "Powder Size" ;
    skos:definition "The characteristic dimension or size distribution of powder particles used in powder-based processing."@en ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:PowerAtStandardTestConditions a owl:Class ;
    rdfs:label "PowerAtStandardTestConditions" ;
    qudt:applicableUnit unit:W ;
    rdfs:subClassOf cco:ont00000503 ;
    skos:altLabel "PowerAtStandardTestConditions",
        "PowerSTC" ;
    skos:definition "Power at reference conditions." ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:PV-Cell .

mds:PowerAtVoltageLoad a owl:Class ;
    rdfs:label "PowerAtVoltageLoad" ;
    qudt:applicableUnit unit:V ;
    rdfs:subClassOf mds:AnalyticalResult ;
    skos:altLabel "Pvld" ;
    skos:definition "The power at voltage load, measured in Volts." ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:Electrical .

mds:PowerDensity a owl:Class ;
    rdfs:label "PowerDensity"@en ;
    qudt:applicableUnit unit:W-PER-M2 ;
    rdfs:subClassOf mds:ProcessingParameter ;
    skos:altLabel "Intensity",
        "Irradiance" ;
    skos:definition "The power delivered per unit area at the processing zone."@en ;
    mds:hasStudyStage "Process" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:PrecipitationHardening a owl:Class ;
    rdfs:label "PrecipitationHardening"@en ;
    dcmi:source "ISO 4885:2018" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:AgingTemperature ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:AgingTime ],
        mds:MaterialsProcessing ;
    skos:altLabel "Age Hardening",
        "Precipitation Heat Treatment" ;
    skos:definition "A heat treatment technique used to increase the yield strength of malleable materials by forming uniformly dispersed precipitates within the material's crystal structure through controlled aging."@en ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:MaterialsProcessing .

