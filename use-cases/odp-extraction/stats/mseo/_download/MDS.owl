    skos:definition "The site from which the satellite was launched." ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Satellite .

mds:LayerCount a owl:Class ;
    rdfs:label "LayerCount" ;
    rdfs:subClassOf mds:ProcessParameter ;
    skos:altLabel " " ;
    skos:definition "A Geometric Specification that prescribes the number of layers in a printed part." ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:LayerFusion a owl:Class ;
    rdfs:label "LayerFusion"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "The sub-process of moving the laser focus along the hatch and contour vectors for that layer according to the specified scanning speed, laser power and focus position."@en ;
    skos:exactMatch lpbfo:LPBFO_720 ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:LPBF .

mds:LayerFusionProcessDataSet a owl:Class ;
    rdfs:label "LayerFusionProcessDataSet"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "The Layer Fusion Process Data Set refers to the data extracted from the building process. This includes, for example, the data recorded with the pyrometers and high-resolution images of the powder layer."@en ;
    skos:exactMatch lpbfo:LPBFO_00753 ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:LPBF .

mds:LayerThickness a owl:Class ;
    rdfs:label "LayerThickness"@en ;
    qudt:applicableUnit unit:MicroM,
        unit:MilliM ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO"@en ;
    rdfs:subClassOf bfo:BFO_0000001,
        mds:ProcessParameter ;
    skos:altLabel "Build Layer Thickness",
        "Layer Height",
        "Additive Manufacturing Layer Thickness"@en ;
    skos:definition "Layer thickness in 3D printing is a measure of the layer height of each successive addition of material in the additive manufacturing or 3D printing process in which layers are stacked."@en,
        "The thickness of each individual layer deposited or processed in an additive manufacturing or layered processing operation."@en ;
    skos:exactMatch lpbfo:LPBFO_00009 ;
    mds:hasStudyStage "Materials Processing",
        "Recipe" ;
    mds:inDomain mdsdom:LPBF,
        mdsdom:MaterialsProcessing .

