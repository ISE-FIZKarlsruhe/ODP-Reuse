    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:WireFeedSpeed ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:Current ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
