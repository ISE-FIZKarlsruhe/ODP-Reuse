mds:LaserBeam a owl:Class ;
    rdfs:label "LaserBeam"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:subClassOf bfo:BFO_0000011 ;
    skos:altLabel " " ;
    skos:definition "Laser Beam represents the spatially resolved normalised power density distribution of laser radiation along the beam direction. The normalisation implies that the integral over the power density distribution in any plane perpendicular to the beam axis yields to 1W. The power density distribution effective in the process zone then results as the product of the normalised power density distribution with th set laser power."@en ;
    skos:exactMatch lpbfo:LPBFO_00735 ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:LPBF .

mds:LaserEngineeredNetShaping a owl:Class ;
    rdfs:label "LaserEngineeredNetShaping"@en ;
    dcmi:source "Sandia National Laboratories" ;
    rdfs:subClassOf mds:DirectMetalDeposition ;
    skos:altLabel "LENS",
        "LMD",
        "Laser Metal Deposition" ;
    skos:definition "A laser-based directed energy deposition process that creates three-dimensional components by depositing and melting metal powder layer by layer."@en ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:LaserFluence a owl:Class ;
    rdfs:label "LaserFluence"@en ;
    qudt:applicableUnit unit:J-PER-M2 ;
    rdfs:subClassOf mds:ProcessingParameter ;
    skos:altLabel "Pulse Energy Density" ;
    skos:definition "The energy delivered per unit area by a laser pulse."@en ;
    mds:hasStudyStage "Process" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:LaserFocusShift a owl:Class ;
    rdfs:label "LaserFocusShift"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "That is the offset of the beam focus relative to the process plane. Depending on the material and process regime, it is preferable to position the focus above or below the process plane."@en ;
    skos:exactMatch lpbfo:LPBFO_00742 ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:LPBF .

mds:LaserFrequency a owl:Class ;
    rdfs:label "LaserFrequency"@en ;
    qudt:applicableUnit unit:HZ ;
    rdfs:subClassOf mds:PulseFrequency ;
    skos:altLabel "Laser Pulse Rate",
        "Laser Repetition Rate" ;
    skos:definition "The repetition rate of a pulsed laser used in laser-based processing."@en ;
    mds:hasStudyStage "Process" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:LaserIntensity a owl:Class ;
    rdfs:label "LaserIntensity"@en ;
