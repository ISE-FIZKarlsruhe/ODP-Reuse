mds:TemperatureRatingSpecification a owl:Class ;
    rdfs:label "TemperatureRatingSpecification" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom cco:ont00000441 ],
        cco:ont00000127 ;
    skos:altLabel "Temperature Breakdown Rating Specification" ;
    skos:definition "A Performance Specification that prescribes the ability of a participant to withstand under a given Thermal Process (stress)." ;
    mds:inDomain mdsdom:General .

mds:TemperatureSetpoint a owl:Class ;
    rdfs:label "TemperatureSetpoint"@en ;
    qudt:applicableUnit unit:DEG_C,
        unit:DEG_F,
        unit:K ;
    rdfs:subClassOf cco:ont00000958 ;
    skos:altLabel "",
        " " ;
    skos:definition "A temperature setpoint is an information content entity about the designated temperature of a reaction that is set in a device that controls the temperature"@en,
        "A temperature setpoint is an information content entity about the designated temperature of a reaction that is set in a device that controls the temperature."@en ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:Accelerated,
        mdsdom:Formulation,
        mdsdom:Reactions .

mds:TemporalRegion a owl:Class ;
    rdfs:label "TemporalRegion" .

mds:TemporalResolution a owl:Class ;
    rdfs:label "TemporalResolution" ;
    rdfs:subClassOf cco:ont00001357 ;
    skos:altLabel "TimeInterval",
        "TimeResolution" ;
    skos:definition " ",
        "The frequency of coverage of a geographic location by images or data.",
        "The precision of a measurement, sensor, or system with respect to time, defining how frequently data is captured or how rapidly changes can be detected." ;
    skos:exactMatch mds:TemporalResolution ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Raster,
        mdsdom:Satellite,
        mdsdom:Vector .

mds:TensileStrength a owl:Class ;
    rdfs:label "TensileStrength"@en ;
    rdfs:subClassOf mds:AnalyticalResult,
        mds:MechanicalProperty ;
    skos:altLabel "" ;
    skos:definition "Maximum stress before breaking"@en,
        "Tensile strength is a mechanical property measured in a material that indicates the maximum stress in the material before breaking. "@en ;
    skos:scopeNote "This property is a measured result for a cured polymer. "@en ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:Formulation .

mds:Tension a owl:Class ;
    rdfs:label "Tension"@en ;
    rdfs:subClassOf mds:ProcessingParameter ;
    skos:altLabel "Drawing Tension",
        "Tensile Force" ;
    skos:definition "The tensile force or stress applied to a material during a drawing, pulling, or stretching process."@en ;
    mds:hasStudyStage "Process" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:Tensor a owl:Class ;
    rdfs:label "Tensor" ;
    rdfs:subClassOf cco:ont00000253 ;
    skos:altLabel " " ;
    skos:definition "An Information Bearing Entity consisting of values organized into rows and/or columns extending into some number of dimensions, e.g., a matrix or vector."@en ;
    mds:hasStudyStage "Modeling",
        "Result" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:TerminalElectrode a owl:Class ;
    rdfs:label "TerminalElectrode" ;
    rdfs:subClassOf mds:Electrode ;
    skos:definition "A terminal electrode is an electrode the point where a conductor from a component, device or network ends, serving as a reusable interface to connect external circuits." ;
    skos:example "Terminal electrode on an MLCC, a cathode in an electrochemical cell." ;
    mds:inDomain mdsdom:Electrical ;
    cco:ont00001754 "https://en.wikipedia.org/wiki/Electric_terminal" .

mds:TestSplit a owl:Class ;
    rdfs:label "TestSplit" ;
    rdfs:subClassOf mds:Split ;
    skos:altLabel " " ;
    skos:definition "A Split whose purpose is to test the accuracy of the neural network on previously unseen data post-training."@en ;
    mds:hasStudyStage "Modeling" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:TheoreticalMaximumDensity a owl:Class ;
    rdfs:label "TheoreticalMaximumDensity"@en ;
    rdfs:subClassOf mds:DensityCalculated ;
    skos:definition "The absolute highest density a material can achieve if packed with zero void/porosity" ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:EnerMat .

mds:ThermalAtomicLayerDeposition a owl:Class ;
    rdfs:label "ThermalAtomicLayerDeposition"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:DepositionTemperature ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:Precursors ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:FilmThickness ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:GrowthTime ],
        mds:MaterialsProcessing ;
    skos:altLabel "T-ALD",
        "Thermal ALD" ;
    skos:definition "A thin film deposition technique that uses sequential, self-limiting surface reactions to deposit materials one atomic layer at a time using thermal activation."@en ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:ThermalBreakdownDisposition a owl:Class ;
    rdfs:label "ThermalBreakdownDisposition" ;
    rdfs:subClassOf mds:ThermalDisposition ;
    skos:definition "A Thermal Disposition wherein an artifact undergoes a thermal breakdown such that it experiences a loss of function or role." ;
    mds:inDomain mdsdom:General .

mds:ThermalConductivity a owl:Class ;
    rdfs:label "ThermalConductivity" ;
    rdfs:subClassOf mds:ThermalProperty ;
    skos:altLabel " " ;
    skos:definition "A Thermal Property that measures the speed in which heat is transferred from one part of the material to another due an induced thermal gradient across the material." ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:ThermalCuring a owl:Class ;
    rdfs:label "ThermalCuring"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:CuringTemperature ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:CuringTime ],
        mds:MaterialsProcessing ;
    skos:altLabel "Heat Curing",
        "Thermal Polymerization" ;
    skos:definition "A process that uses heat to initiate or accelerate a chemical reaction that hardens or sets a material, commonly used for polymers, composites, and coatings."@en ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:ThermalDisposition a owl:Class ;
    rdfs:label "ThermalDisposition" ;
    rdfs:subClassOf bfo:BFO_0000016 ;
    skos:definition "A Disposition that is realized under some thermal condition." ;
    mds:inDomain mdsdom:General .

mds:ThermalInsulationMaterial a owl:Class ;
    rdfs:label "ThermalInsulationMaterial"@en ;
    rdfs:subClassOf cco:ont00000995 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( cco:ont00000995 [ a owl:Restriction ;
                        owl:onProperty bfo:RO_0000085 ;
                        owl:someValuesFrom cco:ont00000985 ] ) ] ;
    skos:definition "A Material Artifact that possess a thermal insulation function."@en ;
    skos:example "Polymer coated styrofoam, air." ;
    mds:inDomain mdsdom:General .

mds:ThermalSensitivity a owl:Class ;
