    mds:inDomain mdsdom:Reactions .

mds:PullRate a owl:Class ;
    rdfs:label "PullRate"@en ;
    qudt:applicableUnit unit:MilliM-PER-HR ;
    rdfs:subClassOf mds:ProcessingParameter ;
    skos:definition "The rate at which a crystal is pulled from a melt during crystal growth."@en ;
    mds:hasStudyStage "Process" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:PulsedCurrent a owl:Class ;
    rdfs:label "PulsedCurrent"@en ;
    qudt:applicableUnit unit:A ;
    rdfs:subClassOf mds:ProcessingParameter ;
    skos:definition "Electric current delivered in pulses during processing."@en ;
    mds:hasStudyStage "Process" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:PulsedLaserDeposition a owl:Class ;
    rdfs:label "PulsedLaserDeposition"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:LaserFluence ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:PulseFrequency ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:Wavelength ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:VacuumLevel ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:FilmThickness ],
        mds:MaterialsProcessing ;
    skos:altLabel "Laser Ablation Deposition",
        "PLD" ;
    skos:definition "A thin film deposition technique where a high-power pulsed laser beam ablates material from a target, which is then deposited onto a substrate."@en ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:PulseFrequency a owl:Class ;
    rdfs:label "PulseFrequency"@en ;
    qudt:applicableUnit unit:HZ ;
    rdfs:subClassOf mds:ProcessingParameter ;
    skos:altLabel "Repetition Rate" ;
    skos:definition "The repetition rate of laser pulses or electrical pulses."@en ;
    mds:hasStudyStage "Process" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:PulseWidth a owl:Class ;
    rdfs:label "PulseWidth" ;
    qudt:applicableUnit unit:MilliSEC ;
    rdfs:subClassOf mds:AnalyticalResult ;
    skos:altLabel " " ;
    skos:definition "Duration of a lamp pulse, measured in milliseconds." ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:Electrical .

mds:PurchaseDate a owl:Class ;
    rdfs:label "PurchaseDate" ;
    rdfs:subClassOf mds:Date ;
    skos:altLabel "Purchase Date" ;
    skos:definition "The date the material was purchased" ;
    mds:hasStudyStage "Formulation",
        "Materials Processing",
        "Sample" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:Reactions .

mds:Purge a owl:Class ;
    rdfs:label "Purge"@en ;
    rdfs:subClassOf cco:ont00000908 ;
    skos:altLabel " " ;
    skos:definition "Purge is a process where a vessel is prepared for a reaction by removing the ambient air. This is commonly done in reactions where presence of moisture in the vessel during the reaction will negatively impact the outcome (i.e. lower yield, degradation of reagents, etc.)."@en ;
    mds:hasStudyStage "Materials Processing",
        "Synthesis" ;
    mds:inDomain mdsdom:Reactions .

mds:PValue a owl:Class ;
    rdfs:label "PValue" ;
    rdfs:subClassOf mds:AnalyticalResult ;
    skos:altLabel "p.value" ;
    mds:hasStudyStage " Modeling" ;
    mds:inDomain mdsdom:Analysis,
        mdsdom:netsem .

mds:PVArray a owl:Class ;
    rdfs:label "PVArray"@en ;
    rdfs:subClassOf mds:SystemComponent ;
    skos:altLabel "Solar Array"@en ;
    skos:definition "The complete assembly of photovoltaic modules of a PV system, composed of one or more sub-arrays."@en ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:PV-Site .

mds:PVModule a owl:Class ;
    rdfs:label "PVModule"@en ;
    rdfs:subClassOf mds:SystemComponent ;
    skos:altLabel "Solar Panel"@en ;
    skos:closeMatch cco:ont00000843 ;
    skos:definition "A photovoltaic module: a collection of solar cell circuits sealed in an environmentally protective laminate, the smallest field-replaceable generating unit of a PV array (e.g., SolarWorld SW 240 poly)."@en ;
    skos:exactMatch mds:PhotovoltaicModule ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:PV-Module,
        mdsdom:PV-Site .

mds:PVSite a owl:Class ;
    rdfs:label "PVSite"@en ;
    rdfs:subClassOf bfo:BFO_0000029 ;
    skos:altLabel " " ;
    skos:definition "A PV site is a location where photovoltaic panels are installed to generate electricity from sunlight."@en ;
    skos:exactMatch mds:PhotovoltaicSite ;
    mds:hasStudyStage "General" ;
    mds:inDomain mdsdom:PV-Site .

mds:PVString a owl:Class ;
    rdfs:label "PVString"@en ;
    rdfs:subClassOf mds:SystemComponent ;
    skos:altLabel "Source Circuit"@en ;
    skos:definition "A series-connected circuit of PV modules (a source circuit), e.g., three series-connected SW-240 modules in the SunSmart design."@en ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:PV-Site .

mds:PVSubArray a owl:Class ;
    rdfs:label "PVSubArray"@en ;
    rdfs:subClassOf mds:SystemComponent ;
    skos:altLabel " " ;
    skos:definition "An electrically distinct subdivision of a PV array, typically the group of source circuits feeding a single charge controller or inverter input (e.g., combiner-box groups A, B, C of a SunSmart system)."@en ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:PV-Site .

mds:PVSystem a owl:Class ;
    rdfs:label "PVSystem"@en ;
    rdfs:subClassOf cco:ont00001049 ;
    skos:altLabel " " ;
    skos:definition "A photovoltaic power system: an electrical power source consisting of one or more PV arrays together with balance-of-system components such as inverters, charge controllers, batteries, wiring, and metering."@en ;
    skos:exactMatch cco:ont00001222 ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:PV-Site .

