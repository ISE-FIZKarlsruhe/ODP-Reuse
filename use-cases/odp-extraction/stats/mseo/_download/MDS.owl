        "Beam Velocity",
        "Travel Speed" ;
    skos:broader mds:Recipe ;
    skos:definition "The speed range in which the probe moves across a sample",
        "An imaging parameter describing the rate at which the electron beam scans across a sample surface during image acquisition."@en,
        "The velocity at which the energy beam or tool moves across the material surface during processing."@en ;
    mds:hasStudyStage "Process",
        "Recipe",
        "Tool" ;
    mds:inDomain mdsdom:AFM,
        mdsdom:MaterialsProcessing,
        mdsdom:Profilometry,
        mdsdom:SEM,
        mdsdom:UV-Vis .

mds:ScanStrategy a owl:Class ;
    rdfs:label "ScanStrategy"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "The scan strategy is a set of rules according to which the areas bounded by the cut lines per layer are filled with hatch and contour vectors. The set of rules also concerns the order an direction of the vectors, in particular an antiparallel alignment to the protective gas flow. The rules also specify the overlap between the exposure areas and a possible offset of the contour paths to the cut lines."@en ;
    skos:exactMatch lpbfo:LPBFO_00711 ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:LPBF .

mds:ScanVectorsPerLayer a owl:Class ;
    rdfs:label "ScanVectorsPerLayer"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "All scan vectors (hatch, contour) per layer and their Order."@en ;
    skos:exactMatch lpbfo:LPBFO_00710 ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:LPBF .

mds:Scavenging a owl:Class ;
    rdfs:label "Scavenging"@en ;
    rdfs:subClassOf cco:ont00000908 ;
    skos:altLabel " " ;
    skos:definition "A process in which a chemical substance (scavenger) is added to a mixture to remove or neutralize unwanted reaction products. [Wikipedia]"@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Reactions ;
    cco:ont00001754 "https://en.wikipedia.org/wiki/Scavenger_(chemistry)"@en .

mds:ScreenPrintingProcess a owl:Class ;
    rdfs:label "ScreenPrintingProcess"@en ;
    rdfs:subClassOf cco:ArtifactDesign ;
    skos:altLabel "Photovoltaic Screen Printing"@en,
        "Screen Printing"@en ;
    skos:definition "A materials-processing operation in which a patterned screen is used to deposit a paste, ink, or other printable material onto a photovoltaic cell or related component."@en ;
    mds:hasStudyStage "Materials Processing",
        "Synthesis" ;
    mds:inDomain mdsdom:PV-Cell,
        mdsdom:PV-Module .

mds:SecondaryElectronDetector a owl:Class ;
    rdfs:label "SecondaryElectronDetector" ;
    rdfs:altLabel "" ;
    rdfs:subClassOf mds:SEMdetector ;
    skos:definition "A SEM detector designed to collect secondary electrons emitted from a sample surface." ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:SEM .

mds:SecondaryElectronImage a owl:Class ;
    rdfs:label "SecondaryElectronImage" ;
    rdfs:altLabel "" ;
    rdfs:subClassOf mds:SEMimage ;
