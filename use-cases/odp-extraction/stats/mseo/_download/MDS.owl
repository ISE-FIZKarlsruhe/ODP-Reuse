mds:RamanIntensity a owl:Class ;
    rdfs:label "Ramanintensity"@en ;
    rdfs:subClassOf mds:Intensity ;
    skos:definition " Peak intensity indicates the strength of the Raman scattering for a given vibrational mode. (https://www.azooptics.com/)"@en ;
    mds:hasStudyStage "Result" .

mds:ViscoelasticProperty a owl:Class ;
    rdfs:label "ViscoelasticProperty"@en ;
    rdfs:subClassOf mds:Intensity ;
    skos:definition "A property describing the viscous and elastic response of a material."@en ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:DMA .

mds:LightMicroscopy a owl:Class ;
    rdfs:label "Lightmicroscopy"@en ;
    rdfs:subClassOf mds:Microscopy ;
    skos:altLabel "OpticalMicroscopy" ;
    skos:definition "Microscopy in which a specimen is illuminated with visible light and imaged through a system of optical lenses (https://www.sciencedirect.com/)."@en ;
    mds:inDomain mdsdom:Microscopy ;
    mds:hasStudyStage "Analysis" .

mds:ElectronMicroscopy a owl:Class ;
    rdfs:label "Electronmicroscopy"@en ;
    rdfs:subClassOf mdsdom:Microscopy ;
    skos:definition "Microscopy in which a beam of electrons is used to create an image of a specimen, helping visualise structures from microns down to the molecular and atomic levels (https://www.thermofisher.com/)."@en ;
    mds:inDomain mdsdom:Microscopy ;
    mds:hasStudyStage "Analysis" .

mds:LaserMicroscopy a owl:Class ;
    rdfs:label "Lasermicroscopy"@en ;
    rdfs:subClassOf mds:LightMicroscopy ;
    skos:definition "Laser microscopy is a set of techniques that use a focused laser beam to scan a sample point by point to generate a microscopic image (https://www.rp-photonics.com/)"@en ;
    mds:inDomain mdsdom:Microscopy ;
    mds:hasStudyStage "Analysis" .

mds:XRayMicroscopy a owl:Class ;
    rdfs:label "X-raymicroscopy"@en ;
    rdfs:subClassOf mdsdom:Microscopy ;
    skos:altLabel "XRM" ;
    skos:definition "X-ray microscopy is a nondestructive technique that generates an image of the internal features of the examined materials, with image contrast determined by differences in X-ray absorption among the components of the materials (https://www.sciencedirect.com/)."@en ;
    mds:inDomain mdsdom:Microscopy ;
    mds:hasStudyStage "Analysis" .

mds:AcousticMicroscopy a owl:Class ;
    rdfs:label "Acousticmicroscopy"@en ;
    rdfs:subClassOf mdsdom:Microscopy ;
    skos:definition "A non-destructive microscopy that employs very high or ultra-high frequency ultrasound to make visible images of internal features (https://en.wikipedia.org/)."@en ;
    mds:inDomain mdsdom:Microscopy ;
    mds:hasStudyStage "Analysis" .

mds:InfraredMicroscopy a owl:Class ;
    rdfs:label "Infraredmicroscopy"@en ;
    rdfs:subClassOf mds:LightMicroscopy ;
    skos:definition "An optical instrument designed to visualize and analyze microscopic samples using infrared radiation (https://optris.com/)."@en ;
    mds:inDomain mdsdom:Microscopy ;
    mds:hasStudyStage "Analysis" .

mds:TransmissionElectronMicroscopy a owl:Class ;
    rdfs:label "Transmissionelectronmicroscopy"@en ;
    rdfs:subClassOf mds:ElectronMicroscopy ;
    skos:altLabel "TEM" ;
    skos:definition "Microscopy in which a beam of electrons passes through a very thin specimen to image the internal structure of the specimen, such as atomic arrangements and crystal structures (https://www.thermofisher.com/)."@en ;
    mds:inDomain mdsdom:Microscopy ;
    mds:hasStudyStage "Analysis" .

mds:ScanningProbeMicroscopy a owl:Class ;
    rdfs:label "Scanningprobemicroscopy"@en ;
    rdfs:subClassOf mdsdom:Microscopy ;
    skos:altLabel "SPM" ;
    skos:definition "Microscopy in which a physical probe scans across a specimen's surface, recording a probe-surface interaction point-by-point to construct an image (https://en.wikipedia.org/)."@en ;
    mds:inDomain mdsdom:Microscopy ;
    mds:hasStudyStage "Analysis" .

mds:ScanningAcousticMicroscopy a owl:Class ;
    rdfs:label "Scanningacousticmicroscopy"@en ;
    rdfs:subClassOf mds:AcousticMicroscopy ;
    skos:altLabel "SAM" ;
    skos:definition "A form of acoustic microscopy which uses focused sound to investigate, measure, or image an object (https://en.wikipedia.org/)."@en ;
    mds:inDomain mdsdom:Microscopy ;
    mds:hasStudyStage "Analysis" .

mds:ScanningLaserAcousticMicroscopy a owl:Class ;
    rdfs:label "Scanninglaseracousticmicroscopy"@en ;
    rdfs:subClassOf mds:ScanningAcousticMicroscopy ;
    skos:altLabel "SLAM" ;
    skos:definition "A form of acoustic microscopy in which a scanned laser beam detects surface vibrations induced by acoustic waves, imaging subsurface structure."@en ;
    mds:inDomain mdsdom:Microscopy ;
    mds:hasStudyStage "Analysis" .

mds:ScanningElectronAcousticMicroscopy a owl:Class ;
    rdfs:label "Scanningelectronacousticmicroscopy"@en ;
    rdfs:subClassOf mds:ScanningAcousticMicroscopy ;
    skos:altLabel "SEAM" ;
    skos:definition "A form of acoustic microscopy in which a scanned electron beam generates elastic waves within the specimen, which are then detected to image subsurface structure."@en ;
    mds:inDomain mdsdom:Microscopy ;
    mds:hasStudyStage "Analysis" .

mds:3DFluorescenceSpectroscopy a owl:Class ;
