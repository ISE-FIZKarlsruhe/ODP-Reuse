mds:EdgeFactorParameter a owl:Class ;
    rdfs:label "EdgeFactorParameter" ;
    dcmi:source "EOSPRINT 2"@en ;
    qudt:hasUnit "No Unit"@en ;
    rdfs:comment "This term is reused from https://github.com/ThomasBjarsch/ODE_AM/blob/main/PBFAO.ttl"@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "Edge parameter prescribing the completeness of apex-exposure. The higher this factor, the further the beam will advance into the apex."^^xsd:string ;
    skos:exactMatch pbfa:EdgeFactorParameter ;
    skos:example "2"@en ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:LPBF .

mds:EdgeLengthParameter a owl:Class ;
    rdfs:label "EdgeLengthParameter" ;
    rdfs:subClassOf mds:LatticeParameter ;
    skos:altLabel " " ;
    skos:definition " " ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:EDSDetector a owl:Class ;
