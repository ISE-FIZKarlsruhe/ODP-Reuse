mds:PhotovoltaicCell a owl:Class ;
    rdfs:label "PhotovoltaicCell" ;
    rdfs:subClassOf mds:Sample,
        cco:ont00000995 ;
    owl:disjointWith mds:PhotovoltaicModule ;
    skos:altLabel "Cell" ;
    skos:definition "A photovoltaic (PV) cell is a semiconductor device that converts optical power (i.e., $P_{in} = P_{opt}$) into electrical power (i.e., $P_{out} = P_{elect}$). A semiconductor absorber with the appropriate bandgap ($E_{g}$), selected to maximize power conversion from the solar spectrum, converts incident photons into electronic charge carriers (i.e., negatively charged electron and positively charged holes, or missing electrons in the valence band). Other parts (i.e., subcomponents or device building blocks) help transfer the charge carriers and eventually the current ($I$) and voltage ($V$) to an external circuit where energy ($E_{out}$) can be performed with this electrical power ($P_{out} = I cdot V$) over time, i.e., $E_{out} = int P_{out}(t) cdot dt$. These subcomponents help minize power conversion losses and therefore maximize the photoconversion efficiency ($eta = frac{P_{out}}{P_{in}}$). These PV cells are normally encapsulated and then electrically connected together in series (typically) or series-parallel configurations to to form PV module" ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:PV-Cell,
        mdsdom:Pyrometry .

mds:PhotovoltaicEncapsulant a owl:Class ;
    rdfs:label "PhotovoltaicEncapsulant" ;
    rdfs:subClassOf mds:Encapsulant ;
    skos:altLabel "" ;
    skos:definition "Adhesive material used to hold front sheet and back sheet together in a photovoltaic module" ;
    mds:hasStudyStage "Sample",
        "Synthesis" ;
    mds:inDomain mdsdom:PV-Cell,
        mdsdom:PV-Module .

mds:PhotovoltaicModule a owl:Class ;
    rdfs:label "PhotovoltaicModule" ;
    rdfs:subClassOf mds:Sample ;
    skos:altLabel "Module",
        "PV Module",
        "Photovoltaic Module",
        "Solar Panel",
        "module" ;
    skos:definition "A photovoltaic module is a collection of solar cell circuits sealed in an environmentally protective laminate. Packaging of modules typically includes layering cells between materials such as glass for the front and back, a top and rear encapsulation layer, cells and interconnects, passivation layers and optical coatings, all enclosed in a metal frame. Performance of PV modules are generally rated according to their electrical outputs under standard test conditions. Modules are used in the field together as arrays that make up a power generation site. " ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:PV-Cell .

