mds:CarrierGas a owl:Class ;
    rdfs:label "CarrierGas"@en ;
    rdfs:subClassOf mds:ProcessingParameter ;
    skos:altLabel "Carrier Gas Type",
        "Transport Gas" ;
    skos:definition "The gas used to transport powder or precursor material to the processing zone during deposition or atomization."@en ;
    mds:hasStudyStage "Process" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:CarrierLifetime a owl:Class ;
    rdfs:label "MinorityCarrierLifetime"@en ;
    rdfs:subClassOf cco:ArtifactDesign ;
    skos:altLabel "Charge Carrier Lifetime"@en,
        "Minority Charge Carrier Lifetime"@en ;
    skos:definition "A temporal electronic quality that characterizes the average duration for which a minority charge carrier exists in a semiconductor before recombination."@en ;
    mds:hasStudyStage "Analysis",
        "Result",
        "Sample",
        "Synthesis" ;
    mds:inDomain mdsdom:General,
        mdsdom:PV-Cell,
        mdsdom:PV-Module .

mds:CASCode a owl:Class ;
    rdfs:label "CASCode" ;
    rdfs:subClassOf mds:CodeIdentifier ;
    skos:altLabel "CAS",
        "CAS Code",
        "Chemical Abstract Services Code" ;
    skos:definition "Numeric identifier assigned to a specific chemical substance by the Chemical Abstracts Services" ;
    mds:hasStudyStage "Formulation",
        "Materials Processing",
        "Sample" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:Reactions .

mds:CASNumber a owl:Class ;
    rdfs:label "CASNumber"@en ;
    rdfs:subClassOf cco:ont00000649 ;
    skos:altLabel "Chemical Abstract Service Number"@en,
        "ChemicalAbstractServiceNumber"@en ;
    skos:definition "A unique and systematic identifier for molecules assigned and maintained by Chemical Abstracts Service (CAS)"@en,
        "A unique and systematic identifier for molecules assigned and maintained by Chemical Abstracts Service (CAS)."@en ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:Reactions ;
    cco:ont00001754 "https://en.wikipedia.org/wiki/Chemical_Abstracts_Service"@en .

mds:Casting a owl:Class ;
    rdfs:label "Casting"@en ;
    dcmi:source "ISO 8062-3:2007" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:PouringTemperature ],
        mds:MaterialsProcessing,
        cco:ont00000908 ;
    skos:altLabel "",
        "Metal Casting",
        "Molding" ;
    skos:definition "A manufacturing process in which a liquid material is poured into a mold containing a hollow cavity of the desired shape, and then allowed to solidify."@en,
        "Casting is a process where liquid silicone poured into open or closed molds and cured"@en ;
    mds:hasStudyStage "Formulation",
        "Materials Processing" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:MaterialsProcessing .

