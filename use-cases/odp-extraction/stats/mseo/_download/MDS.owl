mds:ChemicalProperty a owl:Class ;
    rdfs:label "ChemicalProperty" ;
    rdfs:subClassOf bfo:BFO_0000019 ;
    skos:altLabel " " ;
    skos:definition "A Quality, which can either be qualitative or quantitative, that characterizes some aspect of chemical changes a substance undergoes when it chemically reacts with a substance or a class of substances, or some aspect of a chemical reaction in which it chemically modifies another substance.",
        "A chemical property is any of a material's properties that becomes evident during, or after, a chemical reaction" ;
