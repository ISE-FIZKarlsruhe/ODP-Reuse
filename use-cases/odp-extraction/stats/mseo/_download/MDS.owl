mds:RDKitVolume a owl:Class ;
    rdfs:label "RDKitVolume"@en ;
    rdfs:subClassOf cco:ont00001294 ;
    skos:definition "Volume of molecule calculated through the software RDKit" ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:EnerMat .

mds:ReactionAtmosphere a owl:Class ;
    rdfs:label "ReactionAtmosphere"@en ;
    rdfs:subClassOf cco:ont00000031 ;
    skos:altLabel " " ;
    skos:definition "A reaction atmosphere is an atmospheric feature encapsulated within the reaction glassware and takes on the temperature and pressure. " ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:Reactions .

mds:ReactionCondition a owl:Class ;
    rdfs:label "ReactionCondition"@en ;
    rdfs:subClassOf bfo:BFO_0000019 ;
    skos:altLabel " " ;
    skos:definition "A set of reaction conditions such as temperature, time, pressure, illumination, etc. that describe the reaction atmosphere and under which a chemical reaction process occurs."@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:Reactions .

mds:ReactionCXSMILES a owl:Class ;
    rdfs:label "ReactionCXSMILES"@en ;
    rdfs:subClassOf cco:ont00000077 ;
    skos:altLabel " " ;
    skos:definition "A ReactionCXSMILES string is an identifier for a unique reaction using CXSMILES notation: reactants>>agents>>products. "@en ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:Reactions .

mds:ReactionDataFile a owl:Class ;
    rdfs:label "ReactionDataFile"@en ;
    rdfs:subClassOf cco:ont00000686 ;
    skos:altLabel "RDFile"@en ;
    skos:definition "A Reaction Data File (often referred to as an RXN or RDF file) is a specialized, text-based file format used in chemistry to store data regarding chemical reactions."@en ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:Reactions .

mds:ReactionEnvironment a owl:Class ;
    rdfs:label "ReactionEnvironment"@en ;
    rdfs:subClassOf bfo:BFO_0000029 ;
    skos:altLabel " " ;
    skos:definition "A reaction environment is a site (immaterial entity) whose boundary coincides with a reaction vessel with controlled temperature and pressure for a particular chemical reaction process."@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:Reactions .

mds:ReactionMixture a owl:Class ;
    rdfs:label "ReactionMixture"@en ;
    rdfs:subClassOf mds:Mixture ;
    skos:altLabel " " ;
    skos:definition "A Reaction mixture is a mixture that undergoes a chemical reaction process."@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:Reactions .

mds:ReactionNote a owl:Class ;
    rdfs:label "ReactionNote"@en ;
    rdfs:subClassOf cco:ont00000958 ;
    skos:altLabel "",
        " " ;
    skos:definition "Reaction notes largely pertain to safety considerations"@en,
        "Reaction notes largely pertain to safety considerations."@en ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:Reactions ;
    cco:ont00001754 "https://open-reaction-database.org/"@en .

mds:ReactionObservation a owl:Class ;
    rdfs:label "ReactionObservation"@en ;
    rdfs:subClassOf cco:ont00000958 ;
    skos:altLabel "" ;
    skos:definition "Observations by the experimenter or sensor during a chemical reaction process."@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:Reactions .

mds:ReactionPressure a owl:Class ;
    rdfs:label "ReactionPressure"@en ;
    qudt:applicableUnit unit:MegaPA ;
    rdfs:subClassOf mds:ProcessingPressure,
        cco:ont00000380 ;
    skos:altLabel "",
        " " ;
    skos:definition "A reaction pressure is a pressure set within a reaction environment and glassware under a chemical reaction."@en,
        "A reaction pressure is the pressure during a chemical reaction process inside the reaction glassware inheres by the reaction environment."@en,
        "The pressure maintained during a chemical reaction."@en ;
    mds:hasStudyStage "Process",
        "Synthesis" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:MaterialsProcessing,
        mdsdom:Reactions .

mds:ReactionProcedure a owl:Class ;
    rdfs:label "ReactionProcedure"@en ;
    rdfs:subClassOf cco:ont00000127 ;
    skos:altLabel "" ;
    skos:definition "A Performance Specification (directive ICE) that prescribes how a chemical reaction process should be carried out to be successful"@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:Reactions .

mds:ReactionRecord a owl:Class ;
    rdfs:label "ReactionRecord"@en ;
    rdfs:subClassOf cco:ont00000958 ;
    skos:altLabel " " ;
    skos:definition "A reactionRecord is an Information Content Entity that records the details about a reaction process including the provenance, the conditions, the inputs, etc."@en ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:Reactions .

mds:ReactionSetup a owl:Class ;
    rdfs:label "ReactionSetup"@en ;
    rdfs:subClassOf cco:ont00000908 ;
    skos:altLabel " " ;
    skos:definition "A reaction setup is a planned process that involves setting up the equipment and glassware for a planned reaction. [CHMO]"@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Reactions .

mds:ReactionSMILES a owl:Class ;
    rdfs:label "ReactionSMILES"@en ;
    rdfs:subClassOf cco:ont00000077 ;
    skos:altLabel " " ;
    skos:definition "A reaction SMILES (Simplified Molecular Input Line Entry System) is a line notation (a typographical method using printable characters) for entering and representing reactions. "@en ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:Reactions ;
    cco:ont00001754 "https://www.daylight.com/meetings/summerschool98/course/dave/smiles-react.html"@en .

mds:ReactionTemperature a owl:Class ;
    rdfs:label "ReactionTemperature"@en ;
    qudt:applicableUnit unit:DEG_C,
        unit:DEG_F,
        unit:K ;
    rdfs:subClassOf cco:ont00000441 ;
    skos:altLabel "" ;
    skos:definition "A reaction temperature is a temperature measured by a device during a reaction. It is not the temperature setpoint (which might be prescribed in the procedure and the chemical equation)"@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:Reactions .

mds:ReactionTime a owl:Class ;
    rdfs:label "ReactionTime"@en ;
    qudt:applicableUnit unit:DAY,
        unit:HR,
        unit:MIN ;
    rdfs:subClassOf bfo:BFO_0000202 ;
    skos:altLabel "",
        " " ;
    skos:definition "A reaction time is a temporal interval of a chemical reaction process that is a one-dimensional temporal region that is continuous, thus without gaps or breaks. The period of time that elapses between the start of the reaction and the attainment of a given extent of a reaction. [IUPAC]"@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:Reactions ;
    cco:ont00001754 "https://doi.org/10.1351/goldbook.R05179"@en .

mds:ReactionType a owl:Class ;
    rdfs:label "ReactionType"@en ;
    rdfs:subClassOf cco:ont00000958 ;
    skos:altLabel " " ;
    skos:definition "Named reaction or reaction category."@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Reactions ;
    cco:ont00001754 "https://open-reaction-database.org/"@en .

mds:ReactionVessel a owl:Class ;
    rdfs:label "ReactionVessel" ;
    rdfs:subClassOf cco:ont00000020 ;
    skos:altLabel " " ;
    skos:definition "A vessel is a container in which a chemical reaction occurs."@en ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:Reactions .

mds:ReactionVesselAttachment a owl:Class ;
    rdfs:label "ReactionVesselAttachment" ;
    rdfs:subClassOf cco:ont00000581 ;
    skos:altLabel " " ;
    skos:definition "A vessel attachment is a tool that is attached to the vessel and assists in the chemical reaction process."@en ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:Reactions .

mds:ReactionWorkup a owl:Class ;
    rdfs:label "ReactionWorkup"@en ;
