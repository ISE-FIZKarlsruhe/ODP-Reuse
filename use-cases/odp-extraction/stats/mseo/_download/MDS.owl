mds:DSpacing a owl:Class ;
    rdfs:label "DSpacing020plane"@en ;
    rdfs:subClassOf cco:ont00000738 ;
    skos:altLabel mds:d020 ;
    skos:definition "The distance or separation between successive and identical parallel planes in the crystal lattice of atoms. "@en ;
    mds:hasStudyStage "Result" ;
