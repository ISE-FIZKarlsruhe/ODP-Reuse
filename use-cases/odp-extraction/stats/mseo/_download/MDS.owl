mds:CeramicMaterial a owl:Class ;
    rdfs:label "CeramicMaterial" ;
    rdfs:subClassOf mds:Material ;
    owl:disjointWith mds:CompositeMaterial,
        mds:MetallicMaterial,
        mds:PolymericMaterial ;
    skos:altLabel " " ;
    skos:definition "A material in which all constituent phases are inorganic and nonmetallic, such that none are polymeric or metallic in structure or bonding. The dominant bonding is ionic, covalent, or a combination thereof." ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:CeramicMatrixComposite a owl:Class ;
    rdfs:label "CeramicMatrixComposite" ;
    rdfs:subClassOf mds:CompositeMaterial ;
    owl:disjointWith mds:MetalMatrixComposite,
        mds:PolymerMatrixComposite ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( mds:CompositeMaterial [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty mds:hasReinforcement ;
                                    owl:someValuesFrom mds:MetallicMaterial ] [ a owl:Restriction ;
                                    owl:onProperty mds:hasReinforcement ;
                                    owl:someValuesFrom mds:PolymericMaterial ] ) ] [ a owl:Restriction ;
                        owl:onProperty mds:hasMatrix ;
                        owl:someValuesFrom mds:CeramicMaterial ] ) ] ;
    skos:altLabel " " ;
    skos:definition " " ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:ChainGrowthPolymerization a owl:Class ;
    rdfs:label "ChainGrowthPolymerization"@en ;
    rdfs:subClassOf mds:Polymerization ;
    skos:altLabel "Chain-growth polymerization" ;
    skos:definition "A chain-growth polymerization is a type of polymerization where monomers are added to an active center one by one to form an oligomer or polymer. I.e. the polymer grows one monomer at a time"@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Formulation .

mds:ChamberID a owl:Class ;
