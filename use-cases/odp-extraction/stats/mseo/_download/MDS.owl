    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:Reactions ;
    cco:ont00001754 "https://en.wikipedia.org/wiki/Positive_displacement_pipette"@en .

mds:PotassiumCount a owl:Class ;
    rdfs:label "PotassiumCount"@en ;
