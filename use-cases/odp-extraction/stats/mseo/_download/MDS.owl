    rdfs:subClassOf mds:ImagingParameter,
        mds:ProcessingParameter ;
    skos:altLabel "",
        "Hold Time",
        "Soaking Time" ;
    skos:definition "An imaging parameter describing the length of time the electron beam remains at a single image location during scanning."@en,
        "The duration for which a material is held at a specific temperature or condition during processing."@en ;
    mds:hasStudyStage "Process",
        "Tool" ;
