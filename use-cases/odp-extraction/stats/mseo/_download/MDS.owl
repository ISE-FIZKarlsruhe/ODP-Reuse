mds:Glass a owl:Class ;
    rdfs:label "Glass" ;
    rdfs:subClassOf bfo:BFO_0000001,
        mds:Material ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( mds:CeramicMaterial [ a owl:Restriction ;
                        owl:allValuesFrom mds:AmorphousPhase ;
                        owl:onProperty mds:hasPhase ] ) ] ;
    skos:altLabel "",
        " " ;
    skos:definition " ",
        "An inorganic, amorphous solid that is typically transparent or translucent, hard, brittle, and chemically inert." ;
    mds:hasStudyStage "Formulation",
        "Sample" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:PV-Cell,
        mdsdom:PV-Module,
        mdsdom:PlaceHolder .

mds:Glass-Ceramics a owl:Class ;
    rdfs:label "Glass-Ceramics" ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( mds:CeramicMaterial [ a owl:Restriction ;
                        owl:onProperty mds:hasPhase ;
                        owl:someValuesFrom mds:AmorphousPhase ] [ a owl:Restriction ;
                        owl:onProperty mds:hasPhase ;
                        owl:someValuesFrom mds:CrystallinePhase ] ) ] ;
    skos:altLabel " " ;
    skos:definition " " ;
    mds:hasStudyStage "Formulation",
        "Sample" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:GlassTransitionDisposition a owl:Class ;
    rdfs:label "GlassTransitionDisposition" ;
    rdfs:subClassOf mds:ThermalDisposition ;
    skos:altLabel "TG, T_G" ;
    skos:definition "A thermal disposition realized in an amorphous material upon crossing its glass transition temperature wherein the material transitions to a soft and rubbery state from its standard brittle and hard state." ;
    mds:inDomain mdsdom:Electrical .

mds:GlassTransitionTemperature a owl:Class ;
    rdfs:label "GlassTransitionTemperature",
