mds:Position a owl:Class ;
    rdfs:label "Position" ;
    rdfs:subClassOf cco:ont00000119 ;
    skos:altLabel " " ;
    skos:broader mds:AnalyticalResult ;
    skos:definition "Position of ---" ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Pyrometry .

mds:PositionError a owl:Class ;
    rdfs:label "PositionError" ;
    qudt:applicableUnit unit:MilliM ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom mds:Coordinate ],
        mds:KinematicError ;
    skos:altLabel " " ;
    skos:definition "A Kinematic Error describing the offset between projected and measured position along an axis." ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:PositioningStage a owl:Class ;
    rdfs:label "PositioningStage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom mds:DirectInkWritePrinter ],
        cco:ont00000995 ;
    skos:altLabel "Axis Stage" ;
    skos:definition "A Material Artifact that is a motorized stage component of an additive manufacturing machine, designed to produce controlled linear motion of the build platform or deposition head along one principal axis of the machine coordinate system." ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:General .

mds:PositionMeasurement a owl:Class ;
    rdfs:label "PositionMeasurement" ;
    qudt:applicableUnit unit:MilliM ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom mds:Coordinate ],
        mds:KinematicMeasurement ;
    skos:altLabel " " ;
    skos:definition "A Kinematic Measurement describing the sensor-measured position of the build platform along an axis." ;
    mds:hasStudyStage "Process" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:PositiveDisplacementPipette a owl:Class ;
