    skos:definition "A 3D scan, resulting in a contour plot of excitation wavelength vs. emission wavelength vs. fluorescence intensity."@en ;
    mds:inDomain mdsdom:FluorescenceSpectroscopy ;
    mds:hasStudyStage "Analysis" .  

