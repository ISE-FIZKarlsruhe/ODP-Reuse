mds:DegradationMode a owl:Class ;
    rdfs:label "DegradationMode" ;
    rdfs:subClassOf cco:ont00000958 ;
    skos:altLabel "degradation_mode" ;
    skos:definition "Mechanism that causes a photovoltaic (PV) module to lose performance or fail over time, resulting in a reduction of its power output." ;
    mds:hasStudyStage " Modeling" ;
    mds:inDomain mdsdom:Analysis,
        mdsdom:netsem .

