mds:Waste a owl:Class ;
    rdfs:label "Waste"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:subClassOf bfo:BFO_0000030 ;
    skos:altLabel " " ;
    skos:definition " " ;
    skos:exactMatch lpbfo:LPBFO_00800 ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:LPBF .

mds:WasteAbrasiveMaterial a owl:Class ;
    rdfs:label "WasteAbrasiveMaterial"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "The waste abrasive material is a material that can not be recycled or may have residual left elsewhere in the abrasive blasting process."@en ;
    skos:exactMatch lpbfo:LPBFO_00827 ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:LPBF .

mds:WasteCoolant a owl:Class ;
    rdfs:label "WasteCoolant"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "A waste coolant is a coolant from an output of a process, which can not be used anymore. It is assumed that the quantity of the waste coolant has the same amount as the coolant input in the same process."@en ;
    skos:exactMatch lpbfo:LPBFO_00810 ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:LPBF .

mds:WasteInfrastructureSet a owl:Class ;
    rdfs:label "WasteInfrastructureSet"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "The waste infrastructure set is an output produced in a process, which can not use again. The quantity of waste infrastructure is assumed the same as the input of the same process (infrastructure)."@en ;
    skos:exactMatch lpbfo:LPBFO_00812 ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:LPBF .

mds:WasteMetalSwarf a owl:Class ;
    rdfs:label "WasteMetalSwarf"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Metal_swarf"@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "Metal swarf are pieces of metal that are the debris or waste resulting from machining (e.g. turning, milling and drilling) or similar subtractive (material-removing) manufacturing processes."@en ;
    skos:exactMatch lpbfo:LPBFO_00824 ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:LPBF .

mds:WasteSupportStructure a owl:Class ;
    rdfs:label "WasteSupportStructure"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "Waste support structures is the waste material which is generated by removing the support structures from the main specimen, and it can not use again."@en ;
    skos:exactMatch lpbfo:LPBFO_00821 ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:LPBF .

mds:WasteThermalEnergy a owl:Class ;
    rdfs:label "WasteThermalEnergy"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Waste_heat"@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "Thermal enegy is defined as a energy which is produced by a machine, or other process that uses energy, as a byproduct of doing work. All such processes give off some waste heat as a fundamental result of the laws of thermodynamics."@en ;
    skos:exactMatch lpbfo:LPBFO_00813 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:LPBF .

