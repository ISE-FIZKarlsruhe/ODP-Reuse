mds:DirectInkWrite a owl:Class ;
    rdfs:label "DirectInkWrite" ;
    rdfs:subClassOf mds:3DPrinting ;
    skos:altLabel "DIW"@en ;
    skos:definition "Material-extrusion additive manufacturing process that dispenses a viscoelastic ink through a nozzle onto a build platform, building a part layer by layer." ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:DirectInkWritePrinter a owl:Class ;
    rdfs:label "DirectInkWritePrinter" ;
    rdfs:subClassOf cco:ont00000995 ;
    skos:altLabel "DIW printer"@en ;
    skos:definition "A Material Artifact that is an additive manufacturing machine designed to execute the direct ink write process." ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:DirectMetalDeposition a owl:Class ;
    rdfs:label "DirectMetalDeposition"@en ;
    dcmi:source "ISO/ASTM 52900:2021" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:LaserPowerParameter ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:PowderFeedRate ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:CarrierGas ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:TrackOverlap ],
        mds:MaterialsProcessing ;
    skos:altLabel "DED",
        "DMD",
        "Direct Energy Deposition" ;
    skos:definition "An additive manufacturing process that uses a focused thermal energy source to fuse materials by melting as they are deposited."@en ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:DispersionEnergy a owl:Class ;
    rdfs:label "DispersionEnergy"@en ;
    rdfs:subClassOf mds:EnergeticProperties ;
    skos:definition "Attractive forces acting between molecules in a structure" ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:EnerMat .

mds:Dissolution a owl:Class ;
    rdfs:label "Dissolution"@en ;
    rdfs:subClassOf cco:ont00000908 ;
    skos:altLabel " " ;
    skos:definition "A process in which a solute is added to a solvent and dissolves to form a solution. [NIH]"@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Reactions ;
    cco:ont00001754 "https://www.ncbi.nlm.nih.gov/books/NBK431100/"@en .

mds:Distance a owl:Class ;
    rdfs:label "Distance"^^xsd:string ;
    rdfs:subClassOf bfo:BFO_0000145,
        cco:ont00000669 ;
    skos:altLabel " " ;
