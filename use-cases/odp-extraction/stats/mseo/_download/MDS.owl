    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:XRD .

mds:XrayBeamAttenuation a owl:Class ;
    rdfs:label "XrayBeamAttenuation" ;
    rdfs:subClassOf bfo:BFO_0000019 ;
    skos:altLabel " " ;
    skos:definition "This represents the physical process or quantitive reduction in the intensity of an xray beam."@en ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:XRD .

mds:XrayBeamDeviation a owl:Class ;
    rdfs:label "XrayBeamDeviation" ;
    rdfs:subClassOf bfo:BFO_0000019 ;
    skos:altLabel " " ;
    skos:definition "The core datatype property that defines actual spacial or angular misalignment of the x-ray beam path away from the ideal."@en ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:XRD .

mds:XrayBeamHAngle a owl:Class ;
    rdfs:label "XrayBeamHAngle" ;
    rdfs:subClassOf bfo:BFO_0000019 ;
