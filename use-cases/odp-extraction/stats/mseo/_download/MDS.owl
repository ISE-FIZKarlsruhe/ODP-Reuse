    mds:inDomain mdsdom:EnerMat .

mds:ThermalStability a owl:Class ;
    rdfs:label "ThermalStability" ;
    rdfs:subClassOf mds:ThermalProperty ;
    skos:definition "Stability of a water body and its resistance to mixing.(Wikipedia)" ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:EnerMat .

mds:Thermocouple a owl:Class ;
    rdfs:label "Thermocouple"@en ;
