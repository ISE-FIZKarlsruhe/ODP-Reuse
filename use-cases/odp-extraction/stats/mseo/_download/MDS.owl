mds:XRayBeamHPos a owl:Class ;
    rdfs:label "XRayBeamHPos" ;
    rdfs:subClassOf cco:ont00000472 ;
    skos:altLabel " " ;
    skos:definition "The linear coordinate tracking the horizontal translation of the X-ray beam path relative to the exact center point (0,0,0) of the goniometer circle."@en ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:XRD .

mds:XrayBeamHPos a owl:Class ;
    rdfs:label "XrayBeamHPos" ;
    rdfs:subClassOf cco:ont00000472 ;
