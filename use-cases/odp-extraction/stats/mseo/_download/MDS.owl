        bfo:BFO_0000024,
        mds:ElectricalConnector ;
    skos:altLabel "PCB Contact Pad" ;
    skos:definition "An Electrical Connector which is a Fiat Object Part of a Printed Circuit Board that provides a contact for attaching (usually soldering) Electronic Components." ;
    mds:inDomain mdsdom:Electrical .

