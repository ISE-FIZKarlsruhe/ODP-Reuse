mds:PrintedCircuitBoard a owl:Class ;
    rdfs:label "PrintedCircuitBoard" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom mds:PrintedCircuitBoardLayer ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom mds:PortionOfMetal ],
        cco:ont00000995 ;
    skos:altLabel "PCB, Printed Wire Board, PC Board, PWB" ;
    skos:definition "A Material artifact which is a laminated sandwich structure of conductive and insulating layers, each with a pattern of traces, planes and other features (similar to wires on a flat surface) etched from one or more sheet layers of conductor laminated onto or between sheet layers of a non-conductive substrate" ;
    mds:inDomain mdsdom:Electrical ;
    cco:ont00001754 "https://en.wikipedia.org/wiki/Printed_circuit_board" .

