    skos:altLabel "Chemical",
        "Chemical Substance" ;
    skos:definition "Defined at https://www.ebi.ac.uk/chebi/CHEBI:59999. A chemical substance is a portion of matter of constant composition, composed of molecular entities of the same type or of different types." ;
    mds:hasStudyStage "Formulation",
        "Materials Processing",
        "Sample" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:Reactions .

