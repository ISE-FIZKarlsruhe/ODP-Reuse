mds:EDSQuantificationMethod a owl:Class ;
    rdfs:label "EDSQuantificationMethod"@en ;
    rdfs:subClassOf mds:Analysis ;
    skos:altLabel "" ;
    skos:definition "An analysis method used to determine elemental composition from EDS measurements."@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:EDS .

mds:EDSresult a owl:Class ;
    rdfs:label "EDSResult"@en ;
    rdfs:subClassOf cco:ont00000958 ;
    skos:altLabel "" ;
    skos:definition "An information content entity produced by an energy-dispersive X-ray spectroscopy measurement or subsequent analysis."@en ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:EDS .

mds:EDSspectrum a owl:Class ;
    rdfs:label "EDSSpectrum" ;
    rdfs:subClassOf mds:spectrum ;
    skos:altLabel "" ;
    skos:definition "A spectrum that represents the distribution of detected X-rays as a function of energy during an energy dispersive spectroscopy measurement." ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:EDS .

mds:Eiger1M a owl:Class ;
    rdfs:label "Eiger1M" ;
    rdfs:subClassOf mds:EigerDetector ;
    skos:altLabel " " ;
    skos:definition "Eiger 1M X-ray detector." ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:XRD .

mds:EigerDetector a owl:Class ;
    rdfs:label "EigerDetector" ;
    rdfs:subClassOf mds:XrayDetector ;
    skos:altLabel " " ;
    skos:definition "X-ray detectors manufactured by Eiger." ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:XRD .

mds:EightMemberedRingCount a owl:Class ;
    rdfs:label "EightMemberedRingCount"@en ;
    rdfs:subClassOf mds:RingCount ;
    skos:definition "Number of 8-membered rings in a system" ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:EnerMat .

mds:ElapsedTime a owl:Class ;
    rdfs:label "ElapsedTime" ;
    rdfs:subClassOf bfo:BFO_0000202 ;
    skos:altLabel "ElapsedTime" ;
    skos:definition "The measured time that a sample was in exposure." ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:Accelerated .

mds:Elasticity a owl:Class ;
    rdfs:label "Elasticity"@en ;
    rdfs:subClassOf mds:MechanicalProperty ;
    skos:altLabel "" ;
    skos:definition "Ability for a polymer to deform under stress and return to its original shape after. "@en ;
    skos:scopeNote "This property is a measured result for a cured polymer and formulation. "@en ;
    mds:hasStudyStage "Formulation",
        "Sample" ;
    mds:inDomain mdsdom:Formulation .

mds:ElasticModulus a owl:Class ;
    rdfs:label "ElasticModulus" ;
    rdfs:subClassOf mds:MechanicalProperty ;
    skos:altLabel "",
        " " ;
    skos:definition "A Mechanical Property that measures a material's resistance to elastic deformation.",
        "Elastic modulus is a measure of a material's stiffness, quantifying its resistance to elastic deformation under stress. I.e. It is the proportionality constant between stress and strain, expressed by the formula. "@en ;
    skos:scopeNote "This property is a measured result for a cured polymer and formulation."@en ;
    mds:hasStudyStage " General",
        "Sample" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:PlaceHolder .

mds:Elastomer a owl:Class ;
    rdfs:label "Elastomer"@en ;
    rdfs:subClassOf mds:PolymericMaterial ;
    skos:altLabel "" ;
    skos:definition "A polymer that exhibits high elasticity"@en ;
    mds:hasStudyStage "Formulation",
        "Sample" ;
    mds:inDomain mdsdom:Formulation .

mds:ElectricalBreakdownDisposition a owl:Class ;
    rdfs:label "ElectricalBreakdownDisposition"@en ;
    rdfs:subClassOf mds:ElectricalDisposition ;
    skos:definition "An Electrical Disposition that is realized when an electrical breakdown occurs during an electrical or electromagnetic process wherein an artifact observes some loss of function or role." ;
    mds:inDomain mdsdom:Electrical .

mds:ElectricalCharacterization a owl:Class ;
    rdfs:label "ElectricalCharacterization"@en ;
    rdfs:subClassOf cco:ArtifactDesign ;
    skos:altLabel "" ;
    skos:definition "The process of definining the types of experiments a sample undergoes to generate data related to its physical, electrical, or chemical behavior." ;
    mds:hasStudyStage "Characterization",
        "Synthesis" ;
    mds:inDomain mdsdom:Electrical,
        mdsdom:PV-Cell,
        mdsdom:PV-Module .

mds:ElectricalComponentHighlyAcceleratedLifetimeTestingSystem a owl:Class ;
    rdfs:label "ElectricalComponentLifetimeTestingSystem"@en ;
    rdfs:subClassOf mds:HighlyAcceleratedLifetimeTestingSystem ;
    skos:altLabel "EC-HALT"@en ;
    skos:definition "A Highly Accelerated Lifetime Testing System that is used specifically for electrical components"@en ;
    mds:hasStudyStage "Tool"@en ;
    mds:inDomain mdsdom:Electrical .

mds:ElectricalConductivity a owl:Class ;
    rdfs:label "ElectricalConductivity" ;
    rdfs:subClassOf mds:ElectricalProperty ;
    skos:altLabel " " ;
    skos:definition "An Electrical Property that quantifies the relation between the magnitude of an electrical current in a material and the strength of the electric field that induces it." ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:ElectricalConductor a owl:Class ;
    rdfs:label "ElectricalConductor"@en ;
    rdfs:subClassOf cco:ont00000995 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( cco:ont00000995 [ a owl:Restriction ;
                        owl:onProperty bfo:RO_0000085 ;
                        owl:someValuesFrom cco:ont00000795 ] ) ] ;
    skos:altLabel ""@en ;
    skos:definition "A Material Artifact that allows for easy flow of electricity in the form of moving electrons."@en ;
    skos:example "A copper wire, a body of impure water, an iron beam." ;
    mds:inDomain mdsdom:Electrical .

mds:ElectricalConnector a owl:Class ;
    rdfs:label "ElectricalConnector"@en ;
    rdfs:subClassOf mds:ElectricalConductor ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( mds:ElectricalConductor [ a owl:Restriction ;
                        owl:onProperty bfo:RO_0000085 ;
                        owl:someValuesFrom cco:ont00000162 ] ) ] ;
    skos:altLabel "Electrical Port, Electrical Interface"@en ;
    skos:definition "An Electrical Conductor that provides an interface for another electrical conductor."@en ;
    skos:example "USB port on a laptop, RJ45 (ethernet) port from the wall (not the respective wires)" ;
    mds:inDomain mdsdom:Electrical .

mds:ElectricalControlArtifactFunction a owl:Class ;
    rdfs:label "ElectricalControlArtifactFunction"@en ;
    rdfs:subClassOf mds:ControlArtifactFunction,
        cco:ont00000098 ;
    skos:definition "A Control Artifact Function and an Electrical Artifact Function that is realized in a process in which electrical energy is being controlled in some manner."@en ;
    mds:inDomain mdsdom:Electrical .

mds:ElectricalControlProcess a owl:Class ;
    rdfs:label "ElectricalControlProcess"@en ;
    rdfs:subClassOf bfo:BFO_0000015 ;
    skos:definition "A Process that is realized when multiple artifacts, functions, and processes come together to control electrical energy."@en ;
    mds:inDomain mdsdom:Electrical .

mds:ElectricalDisposition a owl:Class ;
    rdfs:label "ElectricalDisposition"@en ;
    rdfs:subClassOf bfo:BFO_0000016 ;
    skos:definition "A Disposition that is realized in an electrical or electromagnetic process." ;
    mds:inDomain mdsdom:Electrical .

mds:ElectricalInsulationArtifactFunction a owl:Class ;
    rdfs:label "ElectricalInsulationArtifactFunction"@en ;
    rdfs:subClassOf cco:ont00000098 ;
    skos:definition "An Electrical Artifact Function that is realized when an artifact disallows electrons from freely flowing within."@en ;
    mds:inDomain mdsdom:Electrical .

mds:ElectricalLoad a owl:Class ;
    rdfs:label "ElectricalLoad"@en ;
    rdfs:subClassOf mds:SystemComponent ;
    skos:altLabel "Load Panel"@en ;
    skos:definition "An electrical load (or load panel) served by the PV system and/or the utility grid."@en ;
    skos:scopeNote "Not to be confused with mds:Load, which carries the same rdfs:label \"Load\" but denotes a mechanical property (an applied force, torque, or weight causing stress or strain). mds:ElectricalLoad is a material artifact, not a quality."@en ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:PV-Site .

mds:ElectricalPermittivity a owl:Class ;
    rdfs:label "ElectricalPermittivity" ;
    rdfs:subClassOf mds:ElectricalProperty ;
    skos:altLabel " " ;
    skos:definition " " ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:ElectricalProperty a owl:Class ;
    rdfs:label "ElectricalProperty" ;
    rdfs:subClassOf bfo:BFO_0000019,
        mds:MaterialProperty ;
    skos:altLabel " " ;
    skos:definition "A Material Property that measures the relation between the strength between an induced electric field on the material and the strength of the response caused by charge carriers in the material.",
        "Electrical property refers to the characteristics of materials that determine their ability to conduct or control electricity, such as resistance, capacitance, and inductance, which are foundational to both electricity and electronics." ;
    skos:exactMatch mds:ElectricalProperty ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:ElectricalResistivity a owl:Class ;
    rdfs:label "ElectricalResistivity",
        "ElectricalResistivity"@en ;
    rdfs:subClassOf mds:AnalyticalResult,
        mds:ElectricalProperty ;
    skos:altLabel "",
        " " ;
    skos:definition "An Electrical Property that is mathematically defined to be the reciprocal of Electrical Conductivity, measuring the resistance of a material to current flow due an external electric field per unit length of the material.",
        "Volume and surface resistivity"@en ;
    skos:scopeNote "This is for a cured polymer"@en ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:PlaceHolder .

mds:ElectricalSignalTransmissionArtifactFunction a owl:Class ;
    rdfs:label "ElectricalSignalTransmissionArtifactFunction"@en ;
    rdfs:subClassOf cco:ont00000795 ;
