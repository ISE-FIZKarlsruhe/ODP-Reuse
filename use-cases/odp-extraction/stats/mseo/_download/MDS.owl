    rdfs:label "ElectricalWire"@en ;
    rdfs:subClassOf mds:ElectricalConductor ;
    skos:altLabel "Electrical Cable"@en ;
    skos:definition "An Electrical Conductor intended to carry charge from one location to another." .

mds:ElectricPotential a owl:Class ;
