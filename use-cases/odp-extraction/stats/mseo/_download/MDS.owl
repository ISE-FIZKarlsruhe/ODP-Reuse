    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:General .

mds:DistanceToVessel a owl:Class ;
    rdfs:label "DistanceToVessel"@en ;
    rdfs:subClassOf mds:Distance ;
    skos:altLabel " " ;
    skos:definition "In a chemical reaction process where illumination is used, distance to vessel refers to the separation in length between the illumination source and the reaction vessel."@en ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Reactions .

mds:DownSkin a owl:Class ;
    rdfs:label "DownSkin" ;
