    rdfs:domain mds:Sample ;
    rdfs:range [ a owl:Class ;
            owl:oneOf ( mds:Step1 mds:Step2 mds:Step3 mds:Step4 mds:Step5 mds:Step6 mds:Step7 mds:Step8 ) ] ;
