    rdfs:label "inherresIn" .

cco:ont00001777 a owl:ObjectProperty ;
    rdfs:label "hasprocesspart"@en ;
    rdfs:domain bfo:BFO_0000015 ;
    rdfs:range bfo:BFO_0000015 ;
    rdfs:subPropertyOf bfo:BFO_0000117 ;
    owl:inverseOf cco:ont00001857 ;
    skos:definition "x has_process_part y iff x and y are instances of Process, such that y occurs during the temporal interval of x, and y either provides an input to x or receives an output of x, or both."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .

cco:ont00001778 a owl:Class,
        owl:ObjectProperty ;
    rdfs:label "hasobject"@en ;
    rdfs:subPropertyOf bfo:BFO_0000057 ;
    owl:inverseOf cco:ont00001936 ;
    skos:definition "If p is a process and c is a continuant, then p has object c if and only if p is performed by an agent and c is part of the projected state that agent intends to achieve by performing p."@en ;
    skos:exactMatch cco:ont00001778 ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .

cco:ont00001787 a owl:ObjectProperty ;
    rdfs:label "agentin"@en .

cco:ont00001801 a owl:ObjectProperty ;
    rdfs:label "issubjectof"@en .

cco:ont00001803 a owl:ObjectProperty ;
    rdfs:label "iscauseof"@en ;
    rdfs:domain bfo:BFO_0000003 ;
    rdfs:range bfo:BFO_0000003 ;
    owl:inverseOf cco:ont00001819 ;
    skos:definition "x is_cause_of y iff x and y are instances of Occurrent, and y is a consequence of x."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .

cco:ont00001808 a owl:ObjectProperty ;
    rdfs:label "isabout"@en ;
    owl:inverseOf cco:ont00001801 .

cco:ont00001816 a owl:ObjectProperty ;
    rdfs:label "isoutputof"@en ;
    rdfs:domain bfo:BFO_0000002 ;
    rdfs:range bfo:BFO_0000015 ;
    rdfs:subPropertyOf bfo:BFO_0000056 ;
    owl:inverseOf cco:ont00001986 ;
    skos:definition "x is_output_of y iff x is an instance of Continuant and y is an instance of Process, such that the presence of x at the end of y is a necessary condition for the completion of y."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .

cco:ont00001819 a owl:ObjectProperty ;
    rdfs:label "causedby"@en ;
    rdfs:domain bfo:BFO_0000003 ;
    rdfs:range bfo:BFO_0000003 ;
    skos:definition "x caused_by y iff x and y are instances of Occurrent, and x is a consequence of y."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .

cco:ont00001833 a owl:ObjectProperty ;
    rdfs:label "hasagent"@en ;
    owl:inverseOf cco:ont00001787 ;
    skos:exactMatch cco:ont00001833 .

cco:ont00001834 a owl:ObjectProperty ;
    rdfs:label "affects"@en ;
    rdfs:domain bfo:BFO_0000015 ;
    rdfs:range bfo:BFO_0000002 ;
    rdfs:subPropertyOf bfo:BFO_0000057 ;
    owl:inverseOf cco:ont00001886 ;
    skos:definition "x affects y iff x is an instance of Process and y is an instance of Continuant, and x influences y in some manner, most often by producing a change in y."@en ;
    skos:exactMatch cco:ont00001834 ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .

cco:ont00001836 a owl:ObjectProperty ;
    rdfs:label "aggregatebearerof"@en ;
    skos:exactMatch cco:ont00001836 .

cco:ont00001841 a owl:ObjectProperty ;
    rdfs:label "isinputof"@en ;
    rdfs:domain bfo:BFO_0000002 ;
    rdfs:range bfo:BFO_0000015 ;
    rdfs:subPropertyOf bfo:BFO_0000056 ;
    owl:inverseOf cco:ont00001921 ;
    skos:definition "x is_input_of y iff x is an instance of Continuant and y is an instance of Process, such that the presence of x at the beginning of y is a necessary condition for the start of y."@en ;
    skos:exactMatch cco:ont00001841 ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .

cco:ont00001845 a owl:ObjectProperty ;
    rdfs:label "issiteof"@en ;
    rdfs:domain bfo:BFO_0000029 ;
    rdfs:range bfo:BFO_0000015 ;
    rdfs:subPropertyOf bfo:BFO_0000183 ;
    owl:inverseOf cco:ont00001918 ;
    skos:definition "x is_site_of y iff x is an instance of Site and y is an instance of Process, such that y occurs in x."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .

cco:ont00001857 a owl:ObjectProperty ;
    rdfs:label "ispartofprocess"@en ;
    rdfs:domain bfo:BFO_0000015 ;
    rdfs:range bfo:BFO_0000015 ;
    rdfs:subPropertyOf bfo:BFO_0000132 ;
    owl:inverseOf cco:ont00001777 ;
    skos:definition "x is_part_of_process y iff x and y are instances of Process, such that x occurs during the temporal interval of y, and x either provides an input to y or receives an output of y."@en ;
    skos:exactMatch cco:ont00001857 ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .

cco:ont00001861 a owl:ObjectProperty ;
    rdfs:label "ismaterialof"@en ;
    rdfs:domain bfo:BFO_0000030 ;
    rdfs:range bfo:BFO_0000030 ;
    owl:inverseOf cco:ont00001991 ;
    skos:definition "x is_material_of y when both x and y are instances of Object and y consists of x as its material and x undergoes no change of kind during the creation of y."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .

cco:ont00001863 a owl:ObjectProperty ;
    rdfs:label "usesmeasurementunit"@en ;
    rdfs:domain cco:ont00000253 ;
    rdfs:range cco:ont00000120 ;
    rdfs:subPropertyOf bfo:BFO_0000101 ;
    owl:inverseOf cco:ont00001961 ;
    skos:definition "y uses_measurement_unit x iff y is an instance of Information Bearing Entity and x is an instance of Measurement Unit, such that x describes the magnitude of measured physical quantity mentioned in y."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

cco:ont00001874 a owl:ObjectProperty ;
    rdfs:label "istemporalregionof"@en ;
    rdfs:domain bfo:BFO_0000008 ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( bfo:BFO_0000015 bfo:BFO_0000035 ) ] ;
    skos:definition "t is temporal region of p iff p occupies temporal region t."@en ;
    skos:editorialNote "Leaving this is in ERO for now since BFO2020 has no inverse of occupies-temporal-region yet."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .

cco:ont00001879 a owl:ObjectProperty ;
    rdfs:label "designatedby"@en ;
    rdfs:domain bfo:BFO_0000001 ;
    rdfs:range cco:ont00000686 ;
    rdfs:subPropertyOf cco:ont00001801 ;
    owl:inverseOf cco:ont00001916 ;
    skos:definition "x designated_by y iff y is an instance of Designative Information Content Entity and x is an instance of Entity and y designates x."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

cco:ont00001884 a owl:ObjectProperty ;
    rdfs:label "conditiondescribedby"@en ;
    rdfs:domain bfo:BFO_0000001 ;
    rdfs:range cco:ont00000127 ;
    rdfs:subPropertyOf cco:ont00001801 ;
    owl:inverseOf cco:ont00001980 ;
    owl:propertyChainAxiom ( cco:ont00001917 bfo:BFO_0000176 ) ;
    skos:definition "x condition_described_by y iff y is an instance of Performance Specification and x is an instance of Entity and y describes_condition x."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

cco:ont00001904 a owl:ObjectProperty ;
    rdfs:label "ismeasuredby"@en ;
    skos:exactMatch cco:ont00001904 .

cco:ont00001908 a owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:label "usestimezoneidentifier"@en ;
    rdfs:domain mds:GeospatialRaster,
        mds:GeospatialVector,
        cco:ont00000253 ;
    rdfs:range mds:TimeZone,
        cco:ont00000829 ;
    skos:definition "Indicates the time zone used by the data.",
        "x uses_time_zone_identifier y iff x is an instance of Information Bearing Entity and y is an instance of Time Zone Identifier, such that y designates the spatial region associated with the time zone mentioned in x."@en ;
    skos:exactMatch cco:ont00001908 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Raster,
        mdsdom:Vector .

cco:ont00001913 a owl:ObjectProperty ;
    rdfs:label "usesgeospatialcoordinatereferencesystem"@en ;
    skos:exactMatch cco:ont00001913 .

cco:ont00001916 a owl:ObjectProperty ;
    rdfs:label "designates"@en ;
    skos:exactMatch cco:ont00001916 .

cco:ont00001917 a owl:ObjectProperty ;
    rdfs:label "describedby"@en ;
    skos:exactMatch cco:ont00001917 .

cco:ont00001918 a owl:ObjectProperty ;
    rdfs:label "occursat"@en ;
    rdfs:domain bfo:BFO_0000015 ;
    rdfs:range bfo:BFO_0000029 ;
    rdfs:subPropertyOf bfo:BFO_0000066 ;
    skos:definition "x occurs_at y iff x is an instance of Process and y is an instance of Site, such that x occurs in y."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .

cco:ont00001920 a owl:ObjectProperty ;
    rdfs:label "prescribedby"@en .

cco:ont00001921 a owl:ObjectProperty ;
    rdfs:label "hasinput"@en ;
    rdfs:domain bfo:BFO_0000015 ;
    rdfs:range bfo:BFO_0000002 ;
    rdfs:subPropertyOf bfo:BFO_0000057 ;
    skos:definition "y has_input x iff x is an instance of Continuant and y is an instance of Process, such that the presence of x at the beginning of y is a necessary condition for the start of y."@en ;
    skos:exactMatch cco:ont00001921 ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .

cco:ont00001938 a owl:ObjectProperty ;
    rdfs:label "represents"@en .

cco:ont00001942 a owl:ObjectProperty ;
    rdfs:label "prescribes"@en ;
    owl:inverseOf cco:ont00001920 ;
    skos:exactMatch cco:ont00001942 .

cco:ont00001951 a owl:ObjectProperty ;
    rdfs:label "hassubordinaterole"@en ;
    rdfs:domain bfo:BFO_0000023 ;
    rdfs:range bfo:BFO_0000023 ;
    skos:definition "For all x,y,t: x has subordinate role y at t iff: x is an instance of Role at time t, and y is an instance of Role at time t, and there is some z such that x is realized by z and z is an instance of Process which creates, modifies, transfers, or eliminates some u such that u is a Process Regulation at time t, and u is addressed to the bearer of y."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .

cco:ont00001953 a owl:ObjectProperty ;
    rdfs:label "hasparent"@en ;
    skos:exactMatch cco:ont00001953 .

cco:ont00001964 a owl:ObjectProperty ;
    rdfs:label "ismeasuredbyinterval"@en ;
    skos:exactMatch cco:ont00001964 .

cco:ont00001966 a owl:ObjectProperty ;
    rdfs:label "isameasurementof"@en ;
    owl:inverseOf cco:ont00001904 .

cco:ont00001980 a owl:ObjectProperty ;
    rdfs:label "describescondition"@en ;
    owl:inverseOf cco:ont00001884 .

cco:ont00001982 a owl:ObjectProperty ;
    rdfs:label "describes"@en ;
    owl:inverseOf cco:ont00001917 .

cco:ont00001986 a owl:ObjectProperty ;
    rdfs:label "has_output"@en,
        "hasoutput"@en ;
    rdfs:domain bfo:BFO_0000015 ;
    rdfs:range bfo:BFO_0000002 ;
    rdfs:subPropertyOf bfo:BFO_0000057 ;
    skos:definition "y has_output x iff x is an instance of Continuant and y is an instance of Process, such that the presence of x at the end of y is a necessary condition for the completion of y."@en .

cco:ont00001991 a owl:ObjectProperty ;
    rdfs:label "ismadeof"@en ;
    rdfs:domain bfo:BFO_0000030 ;
    rdfs:range bfo:BFO_0000030 ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf cco:ont00001861 ;
    skos:definition "x is_made_of y when x and y are both instances of Object and y is the material that x consists of and that material does not undergo a change of kind during the creation of x."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .

dcat:distribution a owl:ObjectProperty ;
    rdfs:label "distribution" .

dcat:temporalResolution a owl:ObjectProperty ;
    rdfs:label "temporalResolution" .

geosparql:hasBoundingBox a owl:ObjectProperty ;
    rdfs:label "hasBoundingBox" .

geosparql:hasSpatialResolution a owl:ObjectProperty ;
    rdfs:label "hasSpatialResolution" .

goo:containsSensor a owl:ObjectProperty ;
    rdfs:label "containssensor"@en ;
    rdfs:comment "Links a satellite directly to a sensor instrument that is equipped on board."@en ;
    rdfs:domain goo:Satellite ;
    rdfs:range goo:Sensor ;
    rdfs:subPropertyOf mds:containsSensor ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:derivedFromSatelliteDataset a owl:ObjectProperty ;
    rdfs:label "derivedfromsatellitedataset"@en ;
    rdfs:comment "Links a satellite image to the broader satellite dataset product used as its source."@en ;
    rdfs:domain goo:SatelliteImage ;
    rdfs:range goo:SatelliteDatasetProduct ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:fromSatellite a owl:ObjectProperty ;
    rdfs:label "fromsatellite"@en ;
    rdfs:comment "Indicates which satellite captured the image."@en ;
    rdfs:domain goo:SatelliteImage ;
    rdfs:range goo:Satellite ;
    rdfs:subPropertyOf mds:generatedBySatellite ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:fromSensor a owl:ObjectProperty ;
    rdfs:label "fromsensor"@en ;
    rdfs:comment "Indicates which sensor (instrument) on the satellite captured the image."@en ;
    rdfs:domain goo:SatelliteImage ;
    rdfs:range goo:Sensor ;
    rdfs:subPropertyOf mds:generatedBySensor ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:generatedFromNTLImage a owl:ObjectProperty ;
    rdfs:label "generatedfromNTLimage"@en ;
    rdfs:comment "Associates a power outage severity map with the NTL image from which it was generated."@en ;
    rdfs:domain goo:OutageMap ;
    rdfs:range goo:NTLImage ;
    owl:inverseOf goo:hasOutageMap ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:hasDatasetProduct a owl:ObjectProperty ;
    rdfs:label "hasdatasetproduct"@en ;
    rdfs:comment "Links a satellite image to the dataset product or collection from which it was derived."@en ;
    rdfs:domain goo:SatelliteImage ;
    rdfs:range goo:SatelliteDatasetProduct ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:hasOrbit a owl:ObjectProperty ;
    rdfs:label "hasorbit"@en ;
    rdfs:comment "Links a satellite to its orbital configuration or orbit classification."@en ;
    rdfs:domain goo:SatelliteImage ;
    rdfs:range goo:SatelliteOrbit ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:hasOutageMap a owl:ObjectProperty ;
    rdfs:label "hasoutagemap"@en ;
    rdfs:comment "Associates an NTL image with a power outage severity map generated from that image."@en ;
    rdfs:domain goo:NTLImage ;
    rdfs:range goo:OutageMap ;
    owl:inverseOf goo:generatedFromNTLImage ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:hasSourceGranule a owl:ObjectProperty ;
    rdfs:label "hassourcegranule"@en ;
    rdfs:comment "Links a satellite image to its source granule, tile, or scene."@en ;
    rdfs:domain goo:SatelliteImage ;
    rdfs:range goo:SatelliteGranule ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:hasSpatialReferenceSystem a owl:ObjectProperty ;
    rdfs:label "hasspatialreferencesystem"@en ;
    rdfs:comment "Links a satellite image to its coordinate reference system, projection, or spatial grid."@en ;
    rdfs:domain goo:SatelliteImage ;
    rdfs:range goo:SpatialReferenceSystem ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:hasSpectralBand a owl:ObjectProperty ;
    rdfs:label "hasspectralband"@en ;
    rdfs:comment "Links a satellite image or sensor to a spectral band it represents, captures, or supports."@en ;
    rdfs:domain goo:SpectralBandScopedEntity ;
    rdfs:range goo:SpectralBand ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:hasTrackRecord a owl:ObjectProperty ;
    rdfs:label "hastrackrecord"@en ;
    rdfs:comment "Associates a hurricane event record with its individual 6-hourly position and intensity track records."@en ;
    rdfs:domain goo:HurricaneEventRecord ;
    rdfs:range goo:HurricaneTrackRecord ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:locatedInState a owl:ObjectProperty ;
    rdfs:label "locatedinstate"@en ;
    rdfs:comment "Links a U.S. county or equivalent county-level area to its state, territory, or District of Columbia instance."@en ;
    rdfs:domain goo:County ;
    rdfs:range goo:State ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:neighboringCounties a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "neighboringcounties"@en ;
    rdfs:comment "Links a county to the counties that share a border with it."@en ;
    rdfs:domain goo:County ;
    rdfs:range goo:County ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:neighboringStates a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "neighboringstates"@en ;
    rdfs:comment "Links a U.S. state, territory, or the District of Columbia to other state-level areas that share a border with it."@en ;
    rdfs:domain goo:State ;
    rdfs:range goo:State ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:occurredInCounty a owl:ObjectProperty ;
    rdfs:label "occurredincounty"@en ;
    rdfs:comment "Links a storm event to the county (via CZ_FIPS) where it took place."@en ;
    rdfs:domain goo:StormEventRecord ;
    rdfs:range goo:County ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:occurredInState a owl:ObjectProperty ;
    rdfs:label "occurredinstate"@en ;
    rdfs:comment "Links a storm event to the state, territory, or District of Columbia (via STATE_FIPS) where it took place."@en ;
    rdfs:domain goo:StormEventRecord ;
    rdfs:range goo:State ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:partOfEpisode a owl:ObjectProperty ;
    rdfs:label "partofepisode"@en ;
    rdfs:comment "Links an individual storm event record to its broader storm episode record."@en ;
    rdfs:domain goo:StormEventRecord ;
    rdfs:range goo:StormEpisodeRecord ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:representsCounty a owl:ObjectProperty ;
    rdfs:label "representscounty"@en ;
    rdfs:comment "Links an NTL image, outage map, or outage record to U.S. county that it depicts."@en ;
    rdfs:domain goo:CountyScopedEntity ;
    rdfs:range goo:County ;
    mds:inDomain mdsdom:GeoOutageOnto .

mds:acquiredOn a owl:ObjectProperty ;
    rdfs:label "acquiredOn" ;
    rdfs:domain mds:GeospatialRaster,
        mds:GeospatialVector ;
    rdfs:range mds:AcquisitionDate ;
    skos:definition "Indicates the datetime that the data was acquired " ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Raster,
        mdsdom:Vector .

mds:analysedWithDataPackage a owl:ObjectProperty ;
    rdfs:label "analysedWithDataPackage" ;
    rdfs:domain mds:Sample ;
    rdfs:range mds:Software ;
    skos:definition "States the software used to perform data analysis" .

mds:containsBand a owl:ObjectProperty ;
    rdfs:label "containsBand" ;
    rdfs:domain mds:GeospatialRaster,
        mds:Sensor ;
    rdfs:range mds:Band ;
    skos:definition "Indicates the band contained by the raster.",
        "Indicates the band contained by the sensor." ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Raster .

mds:containsGeospatialProperty a owl:ObjectProperty ;
    rdfs:label "containsGeospatialProperty" ;
    rdfs:domain mds:GeospatialRaster ;
    rdfs:range mds:GeospatialProperty ;
    skos:definition "Indicates which geospatial property is represented by the data." ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Raster .


mds:hasCrystallineAttribution a owl:ObjectProperty ;
    rdfs:domain mds:Sample ;
    rdfs:range mds:RamanIntensity ;
    skos:definition "identifies the Raman band of a sample that is said to have crystalline attribution"@en .


mds:containsGeospatiaProperty a owl:ObjectProperty ;
    rdfs:label "containsGeospatiaProperty" ;
    rdfs:domain mds:GeospatialVector ;
    rdfs:range mds:GeospatialProperty ;
    skos:definition "Denotes the geospatial property contained in the geospatial vector data." ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Vector .

mds:containsSensor a owl:ObjectProperty ;
    rdfs:label "containsSensor" ;
    rdfs:domain mds:Satellite ;
    rdfs:range mds:Sensor ;
    skos:definition "Indicates the sensor contained by the satellite." ;
    mds:hasStudyStage " General" .

mds:deliversCoolant a owl:ObjectProperty ;
    rdfs:label "deliversCoolant" ;
    rdfs:domain mds:GrindingMachine ;
    rdfs:range mds:GrindingCoolant ;
    skos:definition "Relates a grinding machine to the coolant material it supplies to the grinding zone during the grinding process."@en .

mds:derivedFrom a owl:ObjectProperty ;
    rdfs:label "derivedFrom"@en ;
    rdfs:domain cco:ont00000958 ;
    rdfs:range cco:ont00000958 ;
    skos:altLabel "Information  Content Entity obtained from another Information  Content Entity"@en ;
    skos:definition "Relates an information content entity to another information content entity from which it was derived."@en .

mds:directlyPrecedes a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:IrreflectiveProperty,
        owl:ObjectProperty ;
    rdfs:label "Directlyprecedes"@en ;
    rdfs:domain mds:ExposureStep ;
    rdfs:range mds:ExposureStep .

mds:Formulates a owl:ObjectProperty ;
    rdfs:label "Formulates" ;
    skos:definition "Formulation used to create the sample "@en .

mds:generatedBySatellite a owl:ObjectProperty ;
    rdfs:label "generatedBySatellite" ;
    rdfs:domain mds:GeospatialRaster ;
    rdfs:range mds:Satellite ;
    skos:definition "Indicates the satellite that generated the data." ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Raster .

mds:generatedBySensor a owl:ObjectProperty ;
    rdfs:label "generatedBySensor" ;
    rdfs:domain mds:GeospatialRaster ;
    rdfs:range mds:Sensor ;
    skos:definition "Indicates which instrument or sensor on a satellite generated the data." ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Raster .

mds:hasAdditives a owl:ObjectProperty ;
    rdfs:label "hasAdditives" ;
    rdfs:domain mds:Material ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( mds:UVStabilizer mds:Antioxidant mds:UVAbsorber ) ] ;
    skos:definition "Any type of additive used in the material"@en .

mds:hasAmbientTemperature a owl:ObjectProperty ;
    rdfs:label "hasAmbientTemperature" ;
    skos:definition "Ambient Temperature"@en .

mds:hasAnnealingParameters a owl:ObjectProperty ;
    rdfs:label "hasAnnealingParameters" ;
    rdfs:domain mds:Sample ;
    rdfs:range mds:HoldTemperature ;
    skos:definition "Informs the parameters a sample was annealed with" .

mds:hasAverageTrainingTime a owl:ObjectProperty ;
    rdfs:label "hasAverageTrainingTime"@en ;
    rdfs:domain mds:UQAnalysisResult ;
    rdfs:range mds:AverageTrainingTime ;
    skos:definition "Relates a UQ analysis result to its average model training time."@en .

mds:hasBandDescription a owl:ObjectProperty ;
    rdfs:label "hasBandDescription" ;
    rdfs:domain mds:Band ;
    rdfs:range mds:BandDescription ;
    skos:definition "Specifies a description or categorization of the band." ;
    mds:hasStudyStage " General" .

mds:hasBatchSize a owl:ObjectProperty ;
    rdfs:label "hasBatchSize"@en ;
    rdfs:domain mds:DeepFeatureLearning ;
    rdfs:range mds:BatchSize ;
    skos:definition "Relates a deep feature learning process to the specification of the batch size used during training."@en ;
    mds:hasStudyStage "Modeling" ;
    mds:inDomain mdsdom:UQ .

mds:hasBestModel a owl:ObjectProperty ;
    rdfs:label "hasBestModel" .

mds:hasBrand a owl:ObjectProperty ;
    rdfs:label "hasBrand" ;
    rdfs:domain mds:Material ;
    rdfs:range mds:Brand ;
    skos:definition "Brand of the Material"@en .

mds:hasCentroid a owl:ObjectProperty ;
    rdfs:label "hasCentroid" ;
    rdfs:domain mds:Geohash ;
    rdfs:range mds:Centroid ;
    skos:definition "indicates the center point of the geohash in latitude and longitude." ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:hasComment a owl:ObjectProperty ;
    rdfs:label "hasComment" ;
    rdfs:domain mds:Sample ;
    rdfs:range mds:Comment ;
    skos:definition "Any comment or note relevant to your study/sample"@en .

mds:hasComponent a owl:ObjectProperty ;
    rdfs:label "hascomponent"@en ;
    rdfs:domain mds:PVSystem ;
    rdfs:range mds:SystemComponent ;
    rdfs:subPropertyOf mds:hasPart ;
    skos:definition "Relates a PV system to one of its physical components."@en .

mds:hasComposition a owl:ObjectProperty ;
    rdfs:label "hasComposition" ;
    rdfs:domain mds:Sample ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( mds:UVP mds:UVF mds:UVA mds:UVT mds:UVO mds:FF1 ) ] ;
    skos:definition "Relates an entity to a description of the material composition associated with it."@en .

mds:hasCrystallineAttribution a owl:ObjectProperty ;
    rdfs:label "hasCrystallineAttribution" ;
    rdfs:domain mds:Sample ;
    rdfs:range mds:CrystallineAttribution ;
    skos:definition "identifies the Raman band of a sample that is said to have crystalline attribution" .

mds:hasDataFile a owl:ObjectProperty ;
    rdfs:label "hasdatafile"@en ;
    rdfs:domain mds:Project ;
    rdfs:range mds:DataFile ;
    skos:definition "Relates a project to a data file it has produced or curates."@en .

mds:hasDataset a owl:ObjectProperty ;
    rdfs:label "hasDataset"@en ;
    rdfs:domain mds:UQAnalysisProcess ;
    rdfs:range mds:AnalysisDataset ;
    skos:definition "Relates an analysis process to the dataset on which it operates."@en .

mds:hasDate a owl:ObjectProperty ;
    rdfs:label "hasDate" ;
    rdfs:comment "Date was created as an object property to be used with FAIRLinked for HBase Ingestion" ;
    rdfs:domain mds:Sample ;
    rdfs:range mds:DateMade ;
    skos:definition "Date that an entity was made, aquired, collected or received"@en .

mds:hasEastNeighbor a owl:ObjectProperty ;
    rdfs:label "hasEastNeighbor" ;
    rdfs:domain mds:Geohash ;
    rdfs:range mds:Geohash ;
    skos:definition "Indicates the geohash to the east of the current geohash." ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:hasElectronicBandGap a owl:ObjectProperty ;
    rdfs:label "haselectronicbandgap" ;
    rdfs:subPropertyOf mds:hasElectronicProperty .

mds:hasElectronicProperty a owl:ObjectProperty ;
    rdfs:label "haselectronicproperty" ;
    rdfs:subPropertyOf mds:hasMaterialProperty .

mds:hasEmbeddingDimension a owl:ObjectProperty ;
    rdfs:label "hasEmbeddingDimension"@en ;
    rdfs:domain mds:DeepFeatureLearning ;
    rdfs:range mds:EmbeddingDimension ;
    skos:definition "Relates a deep feature learning process to the specification of the dimensionality of its learned feature embedding."@en ;
    mds:hasStudyStage "Modeling" ;
    mds:inDomain mdsdom:UQ .

mds:hasEndedOn a owl:ObjectProperty ;
    rdfs:label "hasEndedOn" ;
    rdfs:domain mds:Satellite ;
    rdfs:range mds:EndOfLifeDate ;
    skos:definition "Specifies the end of life date of the satellite." ;
    mds:hasStudyStage " General" .

mds:hasEnergeticProperty a owl:ObjectProperty ;
    rdfs:label "hasEnergeticProperty" ;
    rdfs:domain mds:Compound ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( mds:DetonationVelocity mds:DetonationPressure mds:DepositionTemperature mds:DetonationPressure mds:ElectrostaticSensitivity mds:ImpactSensitivity mds:ShockSensitivity mds:FrictionSensitivity mds:DetonationVelocity mds:DetonationVelocity mds:Deflagration ) ] ;
    rdfs:subPropertyOf bfo:BFO_0000196 .

mds:hasExposureStep a owl:ObjectProperty ;
