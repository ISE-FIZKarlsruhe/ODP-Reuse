@prefix afe: <http://purl.allotrope.org/ontologies/equipment#> .
@prefix afm: <http://purl.allotrope.org/ontologies/material#> .
@prefix afr: <http://purl.allotrope.org/ontologies/result#> .
@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcmi: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geosparql: <http://www.opengis.net/ont/geosparql#> .
@prefix goo: <https://ucf-henat.github.io/GeoOutageOnto/#> .
@prefix lpbfo: <https://www.emi.fraunhofer.de/ontologies/LPBFO#> .
@prefix mds: <https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#> .
@prefix mdsdom: <https://cwrusdle.bitbucket.io/mdsdom/> .
@prefix ncit: <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pbfa: <https://w3id.org/ODE_AM/PBFAO/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mds:Ontology a owl:Ontology ;
    rdfs:label "MDS-Onto" ;
    dcmi:creator "SDLE Research Center" ;
    dcmi:description "MDS-Onto is a domain (low) level ontology that describes terms in Materials Data Science." ;
    dcmi:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcmi:title "MDS-Onto" ;
    owl:versionInfo "0.3.1.49" .

cco:ont00001754 a owl:AnnotationProperty ;
    rdfs:label "definitionsource"@en ;
    skos:definition "A citation of where all or some of the information used to create the term's Definition was acquired from."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .

cco:ont00001760 a owl:AnnotationProperty ;
    rdfs:label "iscuratedinontology"@en ;
    skos:definition "An annotation property that links a class, property, or named individual to the URI of the ontology where it is located."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .

mds:hasStudyStage a owl:AnnotationProperty ;
    rdfs:label "hasStudyStage" .

mds:inDomain a owl:AnnotationProperty ;
    rdfs:label "inDomain" .

skos:altLabel a owl:AnnotationProperty ;
    rdfs:label "altLabel" ;
    skos:exactMatch skos:altLabel .

skos:definition a owl:AnnotationProperty ;
    rdfs:label "definition" ;
    skos:exactMatch skos:definition .

afe:AFE_0000029 a owl:Class ;
    rdfs:label "well-plate"@en ;
    rdfs:subClassOf mds:ReactionVessel ;
    skos:definition "A tray with multiple \"wells\" used as small test tubes. [Wikipedia]"@en ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:Reactions .

afe:AFE_0000052 a owl:Class ;
    rdfs:label "cuvette" ;
    rdfs:comment "This term is reused from Allotrope Foundation Equipment Ontology."@en ;
    rdfs:subClassOf mds:Accessory ;
    skos:definition "A cuvette is a small tube of circular or square cross section, sealed at least at one end, made of plastic, glass, or fused quartz (for UV light) and designed to hold liquid samples for spectroscopic experiments" ;
    skos:exactMatch afe:AFE_0000052 ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:UV-Vis .

afe:AFE_0000329 a owl:Class ;
    rdfs:label "Vial"@en ;
    rdfs:subClassOf mds:ReactionVessel ;
    skos:definition "A vial is a small vessel or bottle. [Allotrope]"@en ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:Reactions .

afe:AFE_0000409 a owl:Class ;
    rdfs:label "monochromator" ;
    rdfs:comment "This term is reused from Allotrope Foundation Equipment Ontology"@en ;
    rdfs:subClassOf mds:Accessory ;
    skos:definition "A piece of apparatus that transmits a narrow band of wavelengths of light or other radiation (e.g. X-rays) chosen from a wider range of wavelengths availablear the inpupt" ;
    skos:exactMatch afe:AFE_0000409 ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:UV-Vis .

afe:AFE_0000718 a owl:Class ;
    rdfs:label "Tube"@en ;
    rdfs:subClassOf mds:ReactionVessel ;
    skos:definition "A tube, or tubing, is a long hollow cylinder used for moving fluids (liquids or gases) or to protect electrical or optical cables and wires. [Wikipedia]"@en ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:Reactions .

afe:AFE_0001691 a owl:Class ;
    rdfs:label "non-contactprobe"@en ;
    rdfs:comment "This term is reused from Allotrope Foundation Equipment Ontology."@en ;
    rdfs:subClassOf cco:onto00000581 ;
    skos:definition "A non-contact probe allows for measurements of a sample without touching it. [Allotrope]"@en ;
    skos:exactMatch afe:AFE_0001691 ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:Profilometry .

afe:AFE_0001703 a owl:Class ;
    rdfs:label "pressureregulator"@en ;
    rdfs:subClassOf mds:ReactionVesselAttachment ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:Reactions .

afe:AFE_0001772 a owl:Class ;
    rdfs:label "deuteriumlamp",
        "deuteriumlamp"@en ;
    rdfs:comment "This term is reused from Allotrope Foundation Equipment Ontology"@en ;
    rdfs:subClassOf cco:ont00000581 ;
    skos:definition "A deuterium lamp is a low-pressure gas-discharge light source that emits light with a continuous spectrum mainly in the ultraviolet region" ;
    skos:exactMatch afe:AFE_0001772 ;
    mds:inDomain mdsdom:Reactions,
        mdsdom:UV-Vis .

afe:AFE_0002248 a owl:Class ;
    rdfs:label "probe"@en ;
    rdfs:comment "This term is reused from Allotrope Foundation Equipment Ontology."@en ;
    rdfs:subClassOf cco:ont00000581 ;
    skos:definition "A probe is a device designed to reach into a location for remote manipulating or sensing. [NCI]"@en ;
    skos:exactMatch afe:AFE_0002248 ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:Profilometry .

afe:AFE_0002281 a owl:Class ;
    rdfs:label "NuclearMagneticResonanceTube"@en ;
    rdfs:subClassOf mds:ReactionVessel ;
    skos:altLabel "NMR Tube"@en ;
    skos:definition "A nuclear magnetic resonance tube is a tube that is used in an NMR experiment. [Allotrope]"@en ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:Reactions .

afe:AFR_0001856 a owl:Class ;
    rdfs:label "electriccurrent"@en ;
    rdfs:subClassOf bfo:BFO_0000019 ;
    mds:inDomain mdsdom:Reactions .

afm:AFM_0000884 a owl:Class ;
    rdfs:label "electricalenergy"@en ;
    rdfs:comment "This term is reused from Allotrope Foundation Material Ontology"@en ;
    rdfs:isDefinedBy "<http://purl.allotrope.org/ontologies/material#>" ;
    rdfs:subClassOf cco:ont00000503 ;
    skos:exactMatch afm:AFM_0000884 ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:LPBF .

afm:AFM_0001032 a owl:Class ;
    rdfs:label "foam"@en ;
    rdfs:subClassOf cco:ont00000327 ;
    mds:hasStudyStage "Formulation",
        "Sample" ;
    mds:inDomain mdsdom:Reactions .

bfo:BFO_0000008 a owl:Class ;
    rdfs:label "temporalregion"@en ;
    skos:exactMatch bfo:BFO_0000008 .

bfo:BFO_0000015 a owl:Class ;
    rdfs:label "process"@en ;
    skos:exactMatch bfo:BFO_0000015 .

bfo:BFO_0000019 a owl:Class ;
    rdfs:label "quality"@en ;
    skos:definition "(Elucidation) A quality is a specifically dependent continuant that, in contrast to roles and dispositions, does not require any further process in order to be realized"@en ;
    skos:exactMatch bfo:BFO_0000019 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Raster .

bfo:BFO_0000023 a owl:Class ;
    rdfs:label "role"@en ;
    dc:identifier "061-BFO" ;
    rdfs:subClassOf bfo:BFO_0000017 ;
    skos:altLabel "externally-grounded realizable entity"@en ;
    skos:definition "(Elucidation) A role b is a realizable entity such that b exists because there is some single bearer that is in some special physical, social, or institutional set of circumstances in which this bearer does not have to be & b is not such that, if it ceases to exist, then the physical make-up of the bearer is thereby changed"@en ;
    skos:example "The priest role; the student role; the role of subject in a clinical trial; the role of a stone in marking a property boundary; the role of a boundary to demarcate two neighbouring administrative territories; the role of a building in serving as a military target"@en .

bfo:BFO_0000024 a owl:Class ;
    rdfs:label "fiatobjectpart"@en ;
    rdfs:subClassOf bfo:BFO_0000030 ;
    skos:exactMatch bfo:BFO_0000024 ;
    mds:inDomain mdsdom:LPBF .

bfo:BFO_0000027 a owl:Class ;
    rdfs:label "objectaggregate"@en ;
    rdfs:subClassOf bfo:BFO_0000040 ;
    skos:exactMatch bfo:BFO_0000027 ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:General .

bfo:BFO_0000029 a owl:Class ;
    rdfs:label "site"@en ;
    dc:identifier "034-BFO" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( bfo:BFO_0000029 bfo:BFO_0000040 ) ] ;
            owl:onProperty bfo:BFO_0000176 ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( bfo:BFO_0000029 bfo:BFO_0000140 ) ] ;
            owl:onProperty bfo:BFO_0000178 ],
        [ a owl:Restriction ;
            owl:allValuesFrom bfo:BFO_0000028 ;
            owl:onProperty bfo:BFO_0000210 ],
        bfo:BFO_0000141 ;
    skos:definition "(Elucidation) A site is a three-dimensional immaterial entity whose boundaries either (partially or wholly) coincide with the boundaries of one or more material entities or have locations determined in relation to some material entity"@en ;
    skos:example "A hole in a portion of cheese; a rabbit hole; the Grand Canyon; the Piazza San Marco; the kangaroo-joey-containing hole of a kangaroo pouch; your left nostril (a fiat part - the opening - of your left nasal cavity); the lumen of your gut; the hold of a ship; the interior of the trunk of your car; hole in an engineered floor joist"@en .

bfo:BFO_0000034 a owl:Class ;
    rdfs:label "function"@en ;
    dc:identifier "064-BFO" ;
    rdfs:subClassOf bfo:BFO_0000016 ;
    skos:definition "(Elucidation) A function is a disposition that exists in virtue of its bearer's physical make-up & this physical make-up is something the bearer possesses because it came into being either through evolution (in the case of natural biological entities) or through intentional design (in the case of artefacts) in order to realize processes of a certain sort"@en ;
    skos:example "The function of a hammer to drive in nails; the function of a heart pacemaker to regulate the beating of a heart through electricity"@en .

bfo:BFO_0000035 a owl:Class ;
    rdfs:label "ProcessBoundary"@en ;
    rdfs:subClassOf bfo:BFO_0000003 ;
    skos:definition "P is a process boundary =Def. p is a temporal part of a process & p has no proper temporal parts."@en ;
    skos:example "the boundary between the 2nd and 3rd year of your life."@en .

bfo:BFO_0000140 a owl:Class ;
    rdfs:label "continuantfiatboundary"@en ;
    skos:definition "(Elucidation) A continuant fiat boundary b is an immaterial entity that is of zero, one or two dimensions & such that there is no time t when b has a spatial region as continuant part & whose location is determined in relation to some material entity"@en ;
    skos:exactMatch bfo:BFO_0000140 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Vector .

bfo:BFO_0000142 a owl:Class ;
    rdfs:label "fiatline"@en ;
    skos:definition "(Elucidation) A fiat line is a one-dimensional continuant fiat boundary that is continuous"@en ;
    skos:exactMatch bfo:BFO_0000142 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Vector .

bfo:BFO_0000144 a owl:Class ;
    rdfs:label "ProcessProfile"@en ;
    rdfs:subClassOf bfo:BFO_0000003 ;
    skos:definition "An occurrent that is an occurrent part of some process by virtue of the rate, or pattern, or amplitude of change in an attribute of one or more participants of said process."@en ;
    skos:example "On a somewhat higher level of complexity are what we shall call rate process profiles, which are the targets of selective abstraction focused not on determinate quality magnitudes plotted over time, but rather on certain ratios between these magnitudes and elapsed times. A speed process profile, for example, is represented by a graph plotting against time the ratio of distance covered per unit of time. Since rates may change, and since such changes, too, may have rates of change, we have to deal here with a hierarchy of process profile universals at successive levels; One important sub-family of rate process profiles is illustrated by the beat or frequency profiles of cyclical processes, illustrated by the 60 beats per minute beating process of John’s heart, or the 120 beats per minute drumming process involved in one of John’s performances in a rock band, and so on. Each such process includes what we shall call a beat process profile instance as part, a subtype of rate process profile in which the salient ratio is not distance covered but rather number of beat cycles per unit of time. Each beat process profile instance instantiates the determinable universal beat process profile. But it also instantiates multiple more specialized universals at lower levels of generality, selected from rate process profilebeat process profileregular beat process profile3 bpm beat process profile4 bpm beat process profileirregular beat process profileincreasing beat process profileand so on.In the case of a regular beat process profile, a rate can be assigned in the simplest possible fashion by dividing the number of cycles by the length of the temporal region occupied by the beating process profile as a whole. Irregular process profiles of this sort, for example as identified in the clinic, or in the readings on an aircraft instrument panel, are often of diagnostic significance.; The simplest type of process profiles are what we shall call ‘quality process profiles’, which are the process profiles which serve as the foci of the sort of selective abstraction that is involved when measurements are made of changes in single qualities, as illustrated, for example, by process profiles of mass, temperature, aortic pressure, and so on."@en ;
    skos:scopeNote "b process_profile_of c holds when b proper_occurrent_part_of c& there is some proper_occurrent_part d of c which has no parts in common with b & is mutually dependent on b& is such that b, c and d occupy the same temporal region (axiom label in BFO2 Reference: [094-005])"@en ;
    mds:hasStudyStage "Result" .

bfo:BFO_0000145 a owl:Class ;
    rdfs:label "relationalquality"@en ;
    dc:identifier "057-BFO" ;
    rdfs:subClassOf bfo:BFO_0000019 ;
    skos:definition "b is a relational quality =Def b is a quality & there exists c and d such that c and d are not identical & b specifically depends on c & b specifically depends on d"@en ;
    skos:example "A marriage bond; an instance of love; an obligation between one person and another"@en ;
    mds:hasStudyStage "Sample" .

bfo:BFO_0000146 a owl:Class ;
    rdfs:label "fiatsurface"@en ;
    skos:definition "(Elucidation) A fiat surface is a two-dimensional continuant fiat boundary that is self-connected"@en ;
    skos:exactMatch bfo:BFO_0000146 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Vector .

bfo:BFO_0000147 a owl:Class ;
    rdfs:label "fiatpoint"@en ;
    skos:definition "(Elucidation) A fiat point is a zero-dimensional continuant fiat boundary that consists of a single point"@en ;
    skos:exactMatch bfo:BFO_0000147 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Vector .

bfo:BFO_0000148 a owl:Class ;
    rdfs:label "zero-dimensionaltemporalregion"@en ;
    dc:identifier "102-BFO" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom bfo:BFO_0000148 ;
            owl:onProperty bfo:BFO_0000121 ],
        bfo:BFO_0000008 ;
    skos:definition "(Elucidation) A zero-dimensional temporal region is a temporal region that is a whole consisting of one or more separated temporal instants as parts"@en ;
    skos:example "A temporal region that is occupied by a process boundary; the moment at which a finger is detached in an industrial accident"@en .

bfo:BFO_0000182 a owl:Class ;
    rdfs:label "history"@en ;
    dc:identifier "138-BFO" ;
    rdfs:subClassOf bfo:BFO_0000015 ;
    skos:definition "(Elucidation) A history is a process that is the sum of the totality of processes taking place in the spatiotemporal region occupied by the material part of a material entity"@en ;
    skos:example "The life of an organism from the beginning to the end of its existence"@en ;
    mds:hasStudyStage "Sample" .

bfo:BFO_0000202 a owl:Class ;
    rdfs:label "temporalinterval"@en ;
    dc:identifier "155-BFO" ;
    rdfs:subClassOf bfo:BFO_0000038 ;
    skos:definition "(Elucidation) A temporal interval is a one-dimensional temporal region that is continuous, thus without gaps or breaks"@en ;
    skos:example "The year 2018."@en ;
    skos:scopeNote "A one-dimensional temporal region can include as parts not only temporal intervals but also temporal instants separated from other parts by gaps."@en ;
    mds:inDomain mdsdom:Reactions .

bfo:BFO_0000203 a owl:Class ;
    rdfs:label "temporalinstant"@en ;
    dc:identifier "209-BFO" ;
    rdfs:subClassOf bfo:BFO_0000148 ;
    skos:definition "(Elucidation) A temporal instant is a zero-dimensional temporal region that has no proper temporal part"@en ;
    skos:example "The millennium"@en ;
    mds:inDomain mdsdom:Reactions .

bfo:CHEBI_46727 a owl:Class ;
    rdfs:label "quartz"@en ;
    rdfs:subClassOf bfo:BFO_0000040 ;
    skos:definition "A hard, crystalline mineral made of silicon dioxide, with atoms arranged in a continuous framework of silicon-oxygen tetrahedra. [Wikipedia]"@en ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:Reactions ;
    cco:ont00001754 "https://en.wikipedia.org/wiki/Quartz"@en .

bfo:CHEBI_53550 a owl:Class ;
    rdfs:label "polypropylene"@en ;
    rdfs:subClassOf bfo:BFO_0000040 ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHEBI_59999 a owl:Class ;
    rdfs:label "chemicalsubstance" .

bfo:CHEBI_73702 a owl:Class ;
    rdfs:label "wax"@en ;
    rdfs:subClassOf cco:ont00000327 ;
    mds:hasStudyStage "Formulation",
        "Sample" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0000113 a owl:Class ;
    rdfs:label "atomicforcemicroscopy" ;
    rdfs:subClassOf bfo:CHMO_0000112 ;
    skos:altLabel "AFM",
        "SFM",
        "atomic force imaging",
        "scanning force microscopy" ;
    skos:definition "Microscopy which uses a sharp spike (known as a 'tip') mounted on the end of a cantilever to scan the surface of the specimen. An image of the surface is obtained by mechanically moving the probe in a raster scan of the specimen, line by line, and recording the force experienced by the tip as a function of position. A feedback loop is used to maintain a fixed relationship between the tip and surface during scanning.[CHMO]" ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:AFM .

bfo:CHMO_0000142 a owl:Class ;
    rdfs:label "electrondiffraction"@en ;
    rdfs:subClassOf bfo:CHMO_0000141 ;
    skos:altLabel "ED"@en ;
    skos:definition "A method for determining structure by directing a beam of electrons (the energies of which are controlled by their acceleration voltage) and recording the resulting diffraction pattern.[CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0000156 a owl:Class ;
    rdfs:label "Xraydiffraction"@en ;
    rdfs:subClassOf bfo:CHMO_0000141 ;
    skos:altLabel "XRD"@en ;
    skos:definition "A method for determining structure by directing a beam of X-rays at the sample and detecting the positions and intensities of the diffracted X-rays as a pattern of spots on a photographic plate.[CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0000323 a owl:Class ;
    rdfs:label "circulardichroismspectroscopy"@en ;
    rdfs:subClassOf bfo:CHMO_0000775 ;
    skos:altLabel "CD"@en ;
    skos:definition "Spectroscopy based on the differential absorption of left- and right-handed circularly polarised light by a sample.[CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0000328 a owl:Class ;
    rdfs:label "electronspinresonancespectroscopy"@en ;
    rdfs:subClassOf bfo:CHMO_0000743 ;
    skos:altLabel "EPR"@en ;
    skos:definition "Spectroscopy where the response of an atom with an unpaired electron to a perturbing magnetic field is measured.[CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0000470 a owl:Class ;
    rdfs:label "massspectrometry"@en ;
    rdfs:subClassOf bfo:CHMO_0000228 ;
    skos:altLabel "MS"@en ;
    skos:definition "Spectrometry where the sample is converted into gaseous ions which are characterised by their mass-to-charge ratio and relative abundance. [CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0000497 a owl:Class ;
    rdfs:label "gaschromatography-massspectrometry"@en ;
    rdfs:subClassOf bfo:CHMO_0000470 ;
    skos:altLabel "GCMS"@en ;
    skos:definition "Any method where a sample mixture is first separated by gas chromatography then ionised and characterised according to mass-to-charge ratio and relative abundance.[CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0000498 a owl:Class ;
    rdfs:label "highresolutionmassspectrometry"@en ;
    rdfs:subClassOf bfo:CHMO_0000470 ;
    skos:altLabel "HRMS"@en ;
    skos:definition "Mass spectrometry where the \"exact\" mass of the molecular ions in the sample is determined as opposed to the \"nominal\" mass (the number of protons and neutrons). [CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0000524 a owl:Class ;
    rdfs:label "liquidchromatography-massspectrometry"@en ;
    rdfs:subClassOf bfo:CHMO_0000470 ;
    skos:altLabel "LCMS"@en ;
    skos:definition "A method where a sample mixture is first separated by liquid chromatography before being converted into ions which are characterised by their mass-to-charge ratio and relative abundance.[CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0000593 a owl:Class ;
    rdfs:label "1Hnuclearmagneticresonancespectroscopy"@en ;
    rdfs:subClassOf bfo:CHMO_0000613 ;
    skos:altLabel "1H NMR Spectroscopy"@en ;
    skos:definition "Spectroscopy where the energy states of 1H nuclei placed in a static magnetic field are interrogated by inducing transitions between the states via radio frequency irradiation. Each experiment consists of a sequence of radio frequency pulses with delay periods in between them."@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions ;
    cco:ont00001754 "https://en.wikipedia.org/wiki/Proton_nuclear_magnetic_resonance"@en .

bfo:CHMO_0000595 a owl:Class ;
    rdfs:label "13Cnuclearmagneticresonancespectroscopy"@en ;
    rdfs:subClassOf bfo:CHMO_0000613 ;
    skos:altLabel "13C NMR Spectroscopy"@en ;
    skos:definition "Spectroscopy where the energy states of 13C nuclei placed in a static magnetic field are interrogated by inducing transitions between the states via radio frequency irradiation. Each experiment consists of a sequence of radio frequency pulses with delay periods in between them."@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions ;
    cco:ont00001754 "https://en.wikipedia.org/wiki/Carbon-13_nuclear_magnetic_resonance"@en .

bfo:CHMO_0000613 a owl:Class ;
    rdfs:label "pulsednuclearmagneticresonancespectroscopy"@en ;
    rdfs:subClassOf bfo:CHMO_0000591 ;
    skos:altLabel "NMR"@en ;
    skos:definition "Spectroscopy where the energy states of spin-active nuclei placed in a static magnetic field are interrogated by inducing transitions between the states via radio frequency irradiation. Each experiment consists of a sequence of radio frequency pulses with delay periods in between them. this is what is usually meant nowadays by NMR. [CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0000630 a owl:Class ;
    rdfs:label "infraredabsorptionspectroscopy"@en ;
    rdfs:subClassOf bfo:CHMO_0000628 ;
    skos:altLabel "IR"@en ;
    skos:definition "Spectroscopy where the sample absorbs radiation from the infrared region (0.78 to 1000 micrometres). [CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0000656 a owl:Class ;
    rdfs:label "Ramanspectroscopy"@en ;
    rdfs:subClassOf bfo:CHMO_0002414 ;
    skos:altLabel "Raman scattering spectroscopy"@en ;
    skos:definition "Spectroscopy where the Raman scattering of monochromatic light, usually from a laser in the visible, near infrared, or near ultraviolet range by a sample is detected."@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0000779 a owl:Class ;
    rdfs:label "polarimetry"@en ;
    rdfs:subClassOf bfo:CHMO_0000208 ;
    skos:altLabel "optical rotation measurement"@en ;
    skos:definition "The measurement of the extent to which a sample interacts with polarized electromagnetic radiation by transmission, reflection, refraction, or diffraction.[CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0000951 a owl:Class ;
    rdfs:label "atomicforcemicroscopytip" ;
    rdfs:subClassOf bfo:OBI_0000968 ;
    skos:definition "A sharp spike which is mounted on the end of a cantilever and used to scan the surface of a specimen in atomic force microscopy.[CHMO]" ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:AFM .

bfo:CHMO_0000952 a owl:Class ;
    rdfs:label "atomicforcemicroscopycantilever" ;
    rdfs:subClassOf bfo:OBI_0000968 ;
    skos:altLabel "AFM cantilever",
        "AFM lever" ;
    skos:definition "A cantilever used in atomic force microscopy to transmit force from the tip to a recording device.[CHMO]" ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:AFM .

bfo:CHMO_0000954 a owl:Class ;
    rdfs:label "atomicforcemicroscope" ;
    rdfs:subClassOf bfo:CHMO_0000953 ;
    skos:definition "A microscope which uses a sharp spike (known as a 'tip') mounted on the end of a cantilever to scan the surface of the specimen. An image of the surface is obtained by mechanically moving the probe in a raster scan of the specimen, line by line, and recording the force experienced by the tip as a function of position. A feedback loop is used to maintain a fixed relationship between the tip and surface during scanning.[CHMO]" ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:AFM .

bfo:CHMO_0001000 a owl:Class ;
    rdfs:label "chromatography"@en ;
    rdfs:subClassOf bfo:CHMO_0000999 ;
    skos:definition "A separation method where the components are distributed between two phases, one of which is stationary, while the other moves in a definite direction. [CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0001002 a owl:Class ;
    rdfs:label "gaschromatography"@en ;
    rdfs:subClassOf bfo:CHMO_0001001 ;
    skos:altLabel "GC"@en ;
    skos:definition "Column chromatography where the mobile phase is a gas. [CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0001003 a owl:Class ;
    rdfs:label "supercriticalfluidchromatography"@en ;
    rdfs:subClassOf bfo:CHMO_0001001 ;
    skos:altLabel "SFC"@en ;
    skos:definition "Column chromatography where the mobile phase is a fluid above and relatively close to its critical temperature and pressure.[CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0001004 a owl:Class ;
    rdfs:label "liquidchromatography"@en ;
    rdfs:subClassOf bfo:CHMO_0001001 ;
    skos:altLabel "LC"@en ;
    skos:definition "Column chromatography where the mobile phase is a liquid. [CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0001007 a owl:Class ;
    rdfs:label "thinlayerchromatography"@en ;
    rdfs:subClassOf bfo:CHMO_0001005 ;
    skos:altLabel "TLC"@en ;
    skos:definition "A chromatography method where the stationary phase is a thin (0.10 to 0.25 mm) layer of sorbent applied to a firm backing such as glass, aluminium or plastic sheet. An eluent ( single solvent or solvent mixture) is allowed to flow by capillary action through the sorbent starting at a point just below the applied samples. As the eluent front migrates through the sorbent the components of the sample also migrate, but at different rates resulting in separation. [CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0001009 a owl:Class ;
    rdfs:label "high-performanceliquidchromatography"@en ;
    rdfs:subClassOf bfo:CHMO_0002318 ;
    skos:altLabel "HPLC"@en ;
    skos:definition "Column chromatography where the mobile phase is a liquid, the stationary phase consists of very small particles and the inlet pressure is relatively high.[CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0001253 a owl:Class ;
    rdfs:label "ultravioletspectrophotometry"@en ;
    rdfs:subClassOf bfo:CHMO_0000292 ;
    skos:altLabel "UV Spectroscopy"@en ;
    skos:definition "Spectroscopy where the sample absorbs radiation from the ultraviolet region (190–400 nm) resulting in electronic transitions within the sample. [CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0001532 a owl:Class ;
    rdfs:label "distillation"@en ;
    rdfs:subClassOf bfo:OBI_0000094 ;
    skos:definition "Distillation is a method of separating mixtures based on differences in their volatilities in a boiling liquid mixture. The components in a sample mixture are vaporized by the application of heat and then cooled by the action of cold water in a condenser. [CHMO]"@en ;
    mds:hasStudyStage "Materials Processing",
        "Synthesis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0001549 a owl:Class ;
    rdfs:label "sampledrying"@en ;
    rdfs:subClassOf bfo:OBI_0000094 ;
    skos:definition "The processing of removing a solvent from a substance. [CHMO]"@en ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0001554 a owl:Class ;
    rdfs:label "ovendrying"@en ;
    rdfs:subClassOf bfo:CHMO_0001549 ;
    skos:definition "The removal of solvent from a sample by heating in an oven. [CHMO]"@en ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0001557 a owl:Class ;
    rdfs:label "vacuumdrying"@en ;
    rdfs:subClassOf bfo:CHMO_0001549 ;
    skos:definition "The removal of water (or other solvents) from a sample by placing it under reduced pressure. This allows water (or other solvents) to evaporate from (heat-sensitive) samples at a lower temperature. [CHMO]"@en ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0001576 a owl:Class ;
    rdfs:label "rotaryevaporation"@en ;
    rdfs:subClassOf bfo:CHMO_0002208 ;
    skos:definition "The removal of solvent from a sample by applying heat and lowering the pressure above the sample whilst rotating it at 10-300 rpm. [CHMO]"@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0001577 a owl:Class ;
    rdfs:label "extraction"@en ;
    rdfs:subClassOf bfo:OBI_0000094 ;
    skos:definition "Extraction is the transfer of a solute from a liquid phase to another immiscible or partially-miscible liquid phase in contact with it. [CHMO]"@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0001640 a owl:Class ;
    rdfs:label "filtration"@en ;
    rdfs:subClassOf bfo:CHMO_0002231 ;
    skos:definition "The process of segregation of phases; the separation of suspended solids from a liquid or gas, usually by forcing a carrier gas or liquid through a porous medium. [CHMO]"@en ;
    mds:hasStudyStage "Materials Processing",
        "Synthesis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0001654 a owl:Class ;
    rdfs:label "ballmilling"@en ;
    rdfs:subClassOf bfo:CHMO_0002774 ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0001682 a owl:Class ;
    rdfs:label "samplemelting"@en ;
    rdfs:subClassOf bfo:OBI_0000094 ;
    skos:altLabel "MP"@en ;
    skos:definition "The process of heating a substance to cause the solid–liquid phase change.[CHMO]"@en ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0001707 a owl:Class ;
    rdfs:label "sonication"@en ;
    rdfs:subClassOf bfo:OBI_0000094 ;
    skos:definition "The irradiation of a liquid sample with sound (20 Hz-20 kHz) waves resulting in agitation. Sound waves propagate into the liquid media result in alternating high-pressure (compression) and low-pressure (rarefaction) cycles. During rarefaction, high-intensity sonic waves create small vacuum bubbles or voids in the liquid, which then collapse violently (cavitation) during compression, creating very high local temperatures.[CHMO]"@en ;
    mds:hasStudyStage "Analysis",
        "Materials Processing",
        "Synthesis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0001718 a owl:Class ;
    rdfs:label "evaporativelightscatteringdetection"@en ;
    rdfs:subClassOf bfo:CHMO_0001709 ;
    skos:altLabel "ELSD"@en ;
    skos:definition "A detection method where a liquid containing the sample is atomised in a gas, forming small droplets which are allowed to evaporate leaving the sample as fine particles. The suspended particles pass through a light beam and the scattered light transmitted by the particles is sensed by a photomultiplier. The response is proportional to the mass of the molecules in the sample.[CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0002004 a owl:Class ;
    rdfs:label "twodimensionalchromatography-massspectrometry"@en ;
    rdfs:subClassOf bfo:CHMO_0000470 ;
    skos:definition "A method in which a two-dimensional chromatography method is coupled to mass spectrometry. [CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0002171 a owl:Class ;
    rdfs:label "phaseatomicforcemicrograph" ;
    rdfs:subClassOf bfo:CHMO_0002170 ;
    skos:altLabel "phase AFM image",
        "phase atomic force microscope (AFM) image",
        "phase atomic force microscopy image" ;
    skos:definition "An image obtained by using a sharp spike (known as a 'tip') mounted on the end of a cantilever to scan the surface of the specimen, line by line, and recording the drop in amplitude of the oscillating cantilever as a function of position.[CHMO]" ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:AFM .

bfo:CHMO_0002173 a owl:Class ;
    rdfs:label "amplitudeatomicforcemicrograph" ;
    rdfs:subClassOf bfo:CHMO_0002170 ;
    skos:altLabel "amplitude AFM image",
        "amplitude atomic force microscope image",
        "amplitude atomic force microscopy images" ;
    skos:definition "An image obtained by using a sharp spike (known as a 'tip') mounted on the end of a cantilever to scan the surface of the specimen, line by line, and recording the deflection of the tip as a function of position.[CHMO]" ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:AFM .

bfo:CHMO_0002231 a owl:Class ;
    rdfs:label "purification"@en ;
    rdfs:subClassOf bfo:OBI_0000094 ;
    skos:definition "Any technique used to physically separate an analyte from byproducts, reagents or contaminating substances."@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:Reactions .

bfo:CHMO_0002351 a owl:Class ;
    rdfs:label "electrochemicalcell"@en ;
    rdfs:subClassOf bfo:OBI_0000968 ;
    skos:definition "A piece of apparatus in which a current causes chemical reactions or chemical reactions cause a current to flow. [CHMO]"@en ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0002389 a owl:Class ;
    rdfs:label "totalionchromatogram"@en ;
    rdfs:subClassOf bfo:CHMO_0002388 ;
    skos:altLabel "TIC"@en ;
    skos:definition "A plot of the total ion current vs. retention time obtained from a chromatography experiment with mass detection. selectivity in the data. The total ion current chromatogram monitors a very large window often of several hundred mass-to-charge units.[CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0002391 a owl:Class ;
    rdfs:label "selectedionchromatogram"@en ;
    rdfs:subClassOf bfo:CHMO_0002388 ;
    skos:altLabel "extracted ion chromatogram"@en ;
    skos:definition "A plot of ion current vs. retention time obtained from a chromatography experiment with mass detection. A small mass window is monitored such that the mass chromatogram represents detection of a very specific mass-to-charge ratio.[CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0002444 a owl:Class ;
    rdfs:label "microwave"@en ;
    rdfs:subClassOf bfo:OBI_0000968 ;
    skos:altLabel "microwave oven"@en ;
    skos:definition "A piece of apparatus, consisting of a high- voltage transformer, a cavity magnetron, a waveguide and a sample chamber, that is used to heat samples by irradiation with microwave (2 GHz) radiation.[CHMO]"@en ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0002572 a owl:Class ;
    rdfs:label "Schlenktube"@en ;
    rdfs:subClassOf bfo:OBI_0000968 ;
    skos:altLabel "Schlenk flask"@en ;
    skos:definition "A piece of apparatus used as a reaction vessel in air-sensitive chemistry. It is made of glass and has a side arm fitted with a PTFE or ground glass stopcock which allows the vessel to be evacuated or filled with gas (e.g. nitrogen or argon).[CHMO]"@en ;
    mds:hasStudyStage "Synthesis",
        "Tool" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0002582 a owl:Class ;
    rdfs:label "flashchromatography"@en ;
    rdfs:subClassOf bfo:CHMO_0001001 ;
    skos:definition "A type of column chromatography where 0.1-10 g of sample mixture is separated in less than 15 min by using pressurised gas to drive the mobile phase through the column. [CHMO]"@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0002685 a owl:Class ;
    rdfs:label "atomicforcemicroscopyheightprofile" ;
    rdfs:subClassOf bfo:CHMO_0000800 ;
    skos:altLabel "AFM height profile" ;
    skos:definition "A plot of vertical displacement vs. distance obtained by using a sharp spike (known as a 'tip') mounted on the end of a cantilever to scan the surface of the specimen, line by line, and recording the force experienced by the tip as a function of position.[CHMO]" ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:AFM .

bfo:CHMO_0002771 a owl:Class ;
    rdfs:label "concentrating"@en ;
    rdfs:subClassOf bfo:OBI_0000094 ;
    skos:definition "A preparative step where the concentration of one component is increased. [CHMO]"@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0002772 a owl:Class ;
    rdfs:label "degassing"@en ;
    rdfs:subClassOf bfo:OBI_0000094 ;
    skos:altLabel "degassing"@en ;
    skos:definition "A preparative step involving the removal of dissolved gases from a sample. [CHMO]"@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Reactions ;
    cco:ont00001754 "https://en.wikipedia.org/wiki/Degassing"@en .

bfo:CHMO_0002774 a owl:Class ;
    rdfs:label "stirring"@en ;
    rdfs:subClassOf bfo:CHMO_0001685 ;
    skos:definition "Stirring process is a mixing process that involves the agitation of a solution through circular motion. [CHMO]"@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0002776 a owl:Class ;
    rdfs:label "stirbar"@en ;
    rdfs:subClassOf bfo:OBI_0000968 ;
    skos:definition "A small magnet used with a stir motor to mix solutions by spinning in the liquid. [CU Boulder]"@en ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:Reactions ;
    cco:ont00001754 "https://www.orgchemboulder.com/Technique/Equipment/Benchequip/Stirbar.shtml"@en .

bfo:CHMO_0002787 a owl:Class ;
    rdfs:label "syringepump"@en ;
    rdfs:subClassOf cco:ont00000581 ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0002826 a owl:Class ;
    rdfs:label "Dean-Starkapparatus"@en ;
    rdfs:subClassOf mds:ReactionVesselAttachment ;
    skos:altLabel "Dean-Stark condenser"@en ;
    skos:definition "A device used to collect and separate water from a reaction mixture by condensation. [Wikipedia]"@en ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:Reactions ;
    cco:ont00001754 "https://en.wikipedia.org/wiki/Dean%E2%80%93Stark_apparatus#:~:text=The%20Dean%E2%80%93Stark%20apparatus%20typically,be%20closed%2C%20with%20no%20tap."@en .

bfo:CHMO_0002827 a owl:Class ;
    rdfs:label "weighing"@en ;
    rdfs:subClassOf bfo:OBI_0000070 ;
    skos:altLabel "Weigh"@en ;
    skos:definition "Determination of the mass of a sample.[CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0002856 a owl:Class ;
    rdfs:label "enantiomerexcess"@en ;
    rdfs:subClassOf bfo:BFO_0000145 ;
    skos:altLabel "EE"@en ;
    skos:definition "The absolute value of the mole fraction for one enantiomer in a mixture minus the mole fraction for the other enantiomer. most people quote percentage enantiomer excess, CHMO:0002857. [CHMO]"@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0002858 a owl:Class ;
    rdfs:label "diasteromericratio"@en ;
    rdfs:subClassOf bfo:BFO_0000145 ;
    skos:altLabel "DR"@en ;
    skos:definition "The ratio of the percentage of one diastereomer in a mixture to that of the other.[CHMO]"@en,
        "This is defined by analogy with enantiomeric ratio as the ratio of the percentage of one diastereoisomer in a mixture to that of the other [IUPAC]. "@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Reactions ;
    cco:ont00001754 "https://doi.org/10.1351/goldbook.D01681"@en .

bfo:CHMO_0002859 a owl:Class ;
    rdfs:label "enantiomericratio"@en ;
    rdfs:subClassOf bfo:BFO_0000145 ;
    skos:altLabel "ER"@en ;
    skos:definition "The ratio of the percentage of one enantiomer in a mixture to that of the other e.g.70(+):30(-). [IUPAC]"@en,
        "The ratio of the percentage of one enantiomer in a mixture to that of the other.[CHMO]"@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Reactions ;
    cco:ont00001754 "https://doi.org/10.1351/goldbook.E02075"@en .

bfo:CHMO_0002860 a owl:Class ;
    rdfs:label "diastereomericexcess"@en ;
    rdfs:subClassOf bfo:BFO_0000145 ;
    skos:altLabel "DE"@en ;
    skos:definition "The absolute value of the mole fraction for one diastereomer in a mixture minus the mole fraction for the other.[CHMO]"@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0002917 a owl:Class ;
    rdfs:label "samplequenching"@en ;
    rdfs:subClassOf bfo:OBI_0000094 ;
    skos:definition "Sample quenching is a material processing in which a sample is cooled by immersion in a fluid. It is also used for ending a catalytic reaction. [CHMO]"@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0002929 a owl:Class ;
    rdfs:label "dividedelectrochemicalcell"@en ;
    rdfs:subClassOf bfo:CHMO_0002351 ;
    skos:definition "An electrochemical cell where the anode and cathode are placed in different vessels requiring the use of a salt bridge, frit or membrane to complete the circuit.[CHMO]"@en ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0002930 a owl:Class ;
    rdfs:label "undividedelectrochemicalcell"@en ;
    rdfs:subClassOf bfo:CHMO_0002351 ;
    skos:definition "An electrochemical cell where the anode and cathode are placed in the same vessel.[CHMO]"@en ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0002931 a owl:Class ;
    rdfs:label "anode"@en ;
    rdfs:subClassOf bfo:CHMO_0002344 ;
    skos:definition "Electrode at which reduction takes place.[CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:CHMO_0002932 a owl:Class ;
    rdfs:label "cathode"@en ;
    rdfs:subClassOf bfo:CHMO_0002344 ;
    skos:definition "Electrode at which oxidation takes place.[CHMO]"@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

bfo:ENVO_01001646 a owl:Class ;
    rdfs:label "amorphoussolid"@en ;
    rdfs:subClassOf cco:ont00000327 ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:Reactions .

bfo:ERO_0001173 a owl:Class ;
    rdfs:label "peristalticpump"@en ;
    rdfs:subClassOf cco:ont00000581 ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:Reactions .

bfo:MCO_0000883 a owl:Class ;
    rdfs:label "agitation"@en ;
    rdfs:subClassOf bfo:CHMO_0002774 ;
    mds:hasStudyStage "Materials Processing",
        "Synthesis" ;
    mds:inDomain mdsdom:Reactions .

bfo:MS1000042 a owl:Class ;
    rdfs:label "PeakIntensity"@en ;
    rdfs:subClassOf mds:PeakPosition ;
    skos:definition "Intensity of ions as measured by the height or area of a peak in a mass spectrum" ;
    skos:exactMatch cco:ont00001760 ;
    mds:hasStudyStage "DataProcessing" .

bfo:OBI_0000070 a owl:Class ;
    rdfs:label "assay"@en ;
    rdfs:subClassOf bfo:OBI_0000011 ;
    skos:definition "A planned process that has the objective to produce information about a material entity (the evaluant) by examining it.[CHMO]"@en ;
    mds:hasStudyStage "Analysis",
        "Synthesis" ;
    mds:inDomain mdsdom:Reactions .

bfo:OBI_0002488 a owl:Class ;
    rdfs:label "pipette"@en ;
    rdfs:subClassOf cco:ont00000581 ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:Reactions .

bfo:OBI_0302888 a owl:Class ;
    rdfs:label "washing"@en ;
    rdfs:subClassOf bfo:OBI_0000094 ;
    skos:definition "washing is a process by which a material entity acting as contaminant (e.g. excess staining reagent) is removed by application of one or more cycles of solution. [CHMO]"@en ;
    mds:hasStudyStage "Materials Processing",
        "Synthesis" ;
    mds:inDomain mdsdom:Reactions .

bfo:PROCO_0000069 a owl:Class ;
    rdfs:label "CrystallineState"@en ;
    rdfs:subClassOf mds:entity ;
    skos:definition "A physical quality indicating the structural order of a solid in which its atoms or molecules are arranged in a regular, periodic manner.[wikipedia]" ;
    skos:exactMatch cco:ont00001760 ;
    mds:hasStudyStage "Sample" .

bfo:PROCO_0000190 a owl:Class ;
    rdfs:label "Round-bottomFlask"@en ;
    rdfs:subClassOf mds:ReactionVessel ;
    skos:definition "A round-bottom flask is a flask with a spherical body and one or more necks with ground glass joints. [PROCO]"@en ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:Reactions .

cco:ont00000003 a owl:Class ;
    rdfs:label "DesignativeName"@en ;
    rdfs:subClassOf cco:ont00000686 ;
    owl:disjointWith cco:ont00000649 ;
    skos:altLabel "Name"@en ;
    skos:definition "A Designative Information Content Entity that consists of a string of characters that designates an entity within a specified cultural or social namespace and which is typically a word or phrase in a natural language that has an accepted cultural or social significance."@en ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:Reactions ;
    cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

cco:ont00000009 a owl:Class ;
    rdfs:label "MassDensity"@en ;
    rdfs:subClassOf bfo:BFO_0000019 ;
    skos:altLabel "Density"@en ;
    skos:definition "A Quality that inheres in a bearer in virtue of that bearer's mass per unit volume."@en ;
    skos:exactMatch cco:ont00000009 ;
    mds:hasStudyStage "Sample" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .

cco:ont00000020 a owl:Class ;
    rdfs:label "Container"@en ;
    rdfs:subClassOf cco:ont00000995 ;
    skos:definition "A Material Artifact that is designed to contain (wholly or partially) some material entity."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000031 a owl:Class ;
    rdfs:label "AtmosphericFeature"@en ;
    rdfs:subClassOf cco:ont00001081 ;
    skos:definition "A Geographic Feature that is part of the atmosphere (including the atmosphere itself as a non-proper part) having a relatively stable lifecycle and which has a location that can be distinguished from the surrounding portion of the atmosphere."@en ;
    mds:inDomain mdsdom:Reactions .

cco:ont00000037 a owl:Class ;
    rdfs:label "ActofObservation"@en ;
    rdfs:subClassOf cco:ont00000228 ;
    skos:definition "A Planned Act of acquiring information from a source via the use of one or more senses."@en ;
    mds:hasStudyStage "Analysis" ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Observation&oldid=1062502087"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000068 a owl:Class ;
    rdfs:label "Three-DimensionalPath"@en ;
    skos:definition "A Three-Dimensional Spatial Region that encompasses the spatial region through which some Object travels."@en ;
    skos:exactMatch cco:ont00000068 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder .

cco:ont00000077 a owl:Class ;
    rdfs:label "CodeIdentifier"@en ;
    rdfs:subClassOf cco:ont00000649 ;
    skos:altLabel "CodeIdentifier"@en ;
    skos:exactMatch cco:ont00000077 ;
    mds:inDomain mdsdom:EnerMat,
        mdsdom:Reactions .

cco:ont00000080 a owl:Class ;
    rdfs:label "StandardTimeofDayIdentifier"@en ;
    rdfs:subClassOf cco:ont00000827 ;
    skos:definition "A Time of Day Identifier that designates an approximate Temporal Instant that is part of some Day and is specified using the Hours, Minutes, and Seconds of the Day that preceded the Temporal Instant."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

cco:ont00000091 a owl:Class ;
    rdfs:label "PortionofCoolant"@en ;
    rdfs:subClassOf cco:ont00000457 ;
    skos:definition "A Portion of Material that is designed to be used in a thermal control system to reduce or maintain the temperature of an object to or at a specified level."@en ;
    skos:exactMatch cco:ont00000091 ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:LPBF ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000098 a owl:Class ;
    rdfs:label "ElectricalArtifactFunction"@en ;
    rdfs:subClassOf cco:ont00000323 ;
    skos:definition "An Artifact Function that is realized during events in which an Artifact is used to perform a process involving electrical power."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000113 a owl:Class ;
    rdfs:label "VentilationControlArtifactFunction"@en ;
    rdfs:subClassOf cco:ont00000323 ;
    skos:definition "An Artifact Function that is realized in processes in which some Material Artifact is used to control the quality of air in some space."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000117 a owl:Class ;
    rdfs:label "InformationProcessingArtifact"@en ;
    rdfs:subClassOf cco:ont00000995 ;
    skos:definition "A Material Artifact that is designed to use algorithms to transform some Information Content Entity into another Information Content Entity."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000119 a owl:Class ;
    rdfs:label "SpatialOrientation"@en ;
    rdfs:subClassOf bfo:BFO_0000145 ;
    skos:altLabel "Attitude"@en ;
    skos:definition "A Relational Quality that is the angle of Rotation of an Object relative to one or more Plane of Reference or Axis of Rotation."@en ;
    mds:inDomain mdsdom:LPBF ;
    cco:ont00001754 "https://en.wikipedia.org/wiki/Orientation_(geometry)" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .

cco:ont00000120 a owl:Class ;
    rdfs:label "MeasurementUnit"@en ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a definite magnitude of a physical quantity, defined and adopted by convention and/or by law, that is used as a standard for measurement of the same physical quantity."@en ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Unit_of_measurement&oldid=1061038125"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

cco:ont00000127 a owl:Class ;
    rdfs:label "PerformanceSpecification"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001980 ;
            owl:someValuesFrom bfo:BFO_0000001 ],
        cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes some aspect of the behavior of a participant in a Process given one or more operating conditions."@en ;
    skos:example "Maximum Speed at high altitude; Rate of Ascent at 10 degrees celsius with nominal payload." ;
    mds:hasStudyStage "Recipe" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

cco:ont00000132 a owl:Class ;
    rdfs:label "RecordingDevice"@en ;
    skos:exactMatch cco:ont00000132 ;
    mds:hasStudyStage "Tool" .

cco:ont00000136 a owl:Class ;
    rdfs:label "OpticalInstrument"@en ;
    rdfs:comment "Optical Instruments are typically constructed for the purpose of being used to aid in vision or the analysis of light" ;
    rdfs:subClassOf cco:ont00000995 ;
    skos:definition "A Material Artifact that is designed to process light waves"@en ;
    skos:scopeNote "Light waves can be processed in a variety of ways including via reflection, refraction, diffraction, deflection, focusing, collimation, dispersion, and interference."@en ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:UV-Vis ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Optical_instrument&oldid=1061981216"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000138 a owl:Class ;
    rdfs:label "MaximumPower"@en ;
    rdfs:subClassOf cco:ont00000503 ;
    skos:definition "A Power that is characterized by the maximum rate of Work, or Energy consumed, done in a given time period."@en ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:LPBF ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000160 a owl:Class ;
    rdfs:label "ManualTool"@en ;
    rdfs:subClassOf cco:ont00000581 ;
    skos:altLabel "Hand Tool"@en ;
    skos:definition "A Tool that is designed to be powered by manual labor rather than by an engine."@en ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hand_tool&oldid=1060741381"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000162 a owl:Class ;
    rdfs:label "ElectricalConnectorArtifactFunction"@en ;
    rdfs:subClassOf cco:ont00000795 ;
    skos:definition "An Electrical Conduction Artifact Function that is realized by processes in which some Artifact is used to join electrical terminations to create an electrical circuit."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000170 a owl:Class ;
    rdfs:label "ObjectTrackPoint"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001944 ;
            owl:someValuesFrom cco:ont00000205 ],
        bfo:BFO_0000018 ;
    skos:definition "A Zero-Dimensional Spatial Region that is an idealized point where an Object is or was located during some motion."@en ;
    mds:inDomain mdsdom:LPBF ;
    cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .

cco:ont00000192 a owl:Class ;
    rdfs:label "Facility"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom cco:ont00001341 ],
        cco:ont00000995 ;
    skos:definition "A Material Artifact that is designed as a building or campus dedicated to some specific purpose."@en ;
    skos:exactMatch cco:ont00000192 ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000194 a owl:Class ;
    rdfs:label "ElectricalContactArtifactFunction"@en ;
    rdfs:subClassOf cco:ont00000795 ;
    skos:definition "An Electrical Conduction Artifact Function that is realized by processes in which some Material Artifact is used as an endpoint of an electrical circuit from which an electrical current is passed via physical contact with the endpoint."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000203 a owl:Class ;
    rdfs:label "EventStatusNominalInformationContentEntity"@en ;
    skos:definition "A Nominal Measurement Information Content Entity that is a measurement of the current state of a process."@en ;
    skos:exactMatch cco:ont00000203 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder .

cco:ont00000217 a owl:Class ;
    rdfs:label "MeasurementUnitofArea"@en ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of two-dimensional regions or Geospatial Regions."@en ;
    skos:exactMatch cco:ont00000217 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Raster .

cco:ont00000228 a owl:Class ;
    rdfs:label "PlannedAct"@en ;
    rdfs:subClassOf cco:ont00000005 ;
    skos:altLabel "Intentional Act"@en ;
    skos:definition "An Act in which at least one Agent plays a causative role and which is prescribed by some Directive Information Content Entity held by at least one of the Agents."@en ;
    mds:hasStudyStage "Recipe" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000236 a owl:Class ;
    rdfs:label "LightingSystem"@en ;
    rdfs:subClassOf cco:ont00000995 ;
    skos:definition "A Material Artifact that is designed to emit light within some area."@en ;
    mds:hasStudyStage "Materials Processing",
        "Tool" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000256 a owl:Class ;
    rdfs:label "FluidControlArtifact"@en ;
    rdfs:subClassOf cco:ont00000995 ;
    skos:definition "A Material Artifact that is designed to manipulate the flow of a fluid (i.e. a liquid or a gas)."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000267 a owl:Class ;
    rdfs:label "CatalystArtifactFunction"@en ;
    skos:altLabel "Catalyst"@en ;
    rdfs:subClassOf cco:ont00000791 ;
    mds:hasStudyStage "Sample",
        "Synthesis" ;
    skos:definition "A Chemical Reaction Artifact Function that is realized in a process in which the rate of a chemical reaction is increased due to the participation of an additional substance, without that substance being consumed in the reaction."@en ;
    mds:inDomain mdsdom:Reactions ,
        mdsdom:Formulation.

cco:ont00000270 a owl:Class ;
    rdfs:label "EducationalFacility"@en ;
    rdfs:subClassOf cco:ont00000192 ;
    skos:definition "A Facility that is designed for facilitating learning, or the acquisition of knowledge, skills, values, beliefs, and habits."@en ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Education&oldid=1064011752"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .

cco:ont00000275 a owl:Class ;
    rdfs:label "SpatialReferenceSystem"@en ;
    rdfs:subClassOf cco:ont00000275,
        cco:ont00000469 ;
    skos:exactMatch cco:ont00000275 .

cco:ont00000288 a owl:Class ;
    rdfs:label "PowerSource"@en ;
    rdfs:subClassOf cco:ont00000995 ;
    skos:definition "A Material Artifact that is designed to supply power to some other Artifact."@en ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:LPBF ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Power_source&oldid=1032888635"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000292 a owl:Class ;
    rdfs:label "ArtifactIdentifier"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( cco:ont00000686 [ a owl:Restriction ;
                        owl:onProperty cco:ont00001916 ;
                        owl:someValuesFrom cco:ont00000995 ] ) ],
        cco:ont00000686 ;
    skos:definition "A Designative Information Content Entity which designates some Artifact."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000293 a owl:Class ;
    rdfs:label "NominalMeasurementInformationContentEntity"@en ;
    rdfs:comment "Four of the subtypes of measurements used here (Interval, Nominal, Ordinal, and Ratio) were originally defined by S.S. Stevens in the article \"On the Theory of Scales of Measurement\" in Science, Vol. 103 No. 2684 on June 7, 1946. For an introductory article with links to additional content including criticisms and alternate classifications of measurements see https://en.wikipedia.org/wiki/Level_of_measurement"@en ;
    rdfs:subClassOf cco:ont00001163 ;
    owl:disjointWith cco:ont00001010,
        cco:ont00001022,
        cco:ont00001364 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( cco:ont00001163 [ a owl:Restriction ;
                        owl:onProperty cco:ont00001868 ;
                        owl:someValuesFrom bfo:BFO_0000001 ] ) ] ;
    skos:definition "A Measurement Information Content Entity that consists of a symbol that classifies Entities according to some shared, possibly arbitrary, characteristic."@en ;
    skos:example "a measurement that classifies automobiles as sedans, coupes, hatchbacks, or convertibles",
        "a measurement that classifies military intelligence as strategic, operational, or tactical",
        "a measurement that classifies rocks as igneous, sedimentary, or metamorphic",
        "The sentence \"January 20, 1985 was a cold day in Chicago, IL\" is the carrier of a nominal measurement."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

cco:ont00000304 a owl:Class ;
    rdfs:label "Microscope"@en ;
    rdfs:subClassOf cco:ont00000771 ;
    skos:definition "An Imaging Instrument that is designed to enable users to see Objects that are otherwise too small to be seen by the naked eye by producing a significantly enlarged image of the Object."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Microscope&oldid=1059024357"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000313 a owl:Class ;
    rdfs:label "Wavelength"@en ;
    qudt:applicableUnit unit:NanoM ;
    rdfs:comment "Assuming a non-dispersive media, the Wavelength will be the inverse of the Frequency."@en ;
    rdfs:subClassOf mds:ProcessingParameter,
        cco:ont00000752 ;
    skos:altLabel "Laser Wavelength",
        "Radiation Wavelength" ;
    skos:definition "A Wave Process Profile that is the distance the Wave Process traverses during one Wave Cycle."@en,
        "The wavelength of electromagnetic radiation (laser, UV, or other light source) used in a processing operation."@en ;
    skos:exactMatch cco:ont00000313 ;
    mds:hasStudyStage " General",
        "Process",
        "Recipe" ;
    mds:inDomain mdsdom:FTIR,
        mdsdom:MaterialsProcessing,
        mdsdom:PlaceHolder,
        mdsdom:Profilometry,
        mdsdom:UV-Vis,
        mdsdom:XRD ;
    mds:unit qudt:ANGSTROM ;
    mds:value xsd:float ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000323 a owl:Class ;
    rdfs:label "ArtifactFunction"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom cco:ont00000995 ],
        bfo:BFO_0000034 ;
    skos:definition "A Function that inheres in some Artifact in virtue of that Artifact being designed to be used in processes that require that Function to be realized."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000324 a owl:Class ;
    rdfs:label "Width"@en ;
    rdfs:subClassOf cco:ont00001367 ;
    skos:broader mds:Recipe ;
    skos:definition "A One Dimensional Extent that inheres in a bearer in virtue of the bearer's extension in a horizontal direction."@en ;
    skos:exactMatch cco:ont00000324 ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:FTIR,
        mdsdom:PV-Cell,
        mdsdom:XRD ;
    cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .

cco:ont00000327 a owl:Class ;
    rdfs:label "Texture"@en ;
    rdfs:subClassOf bfo:BFO_0000019 ;
    skos:definition "A Quality that inheres in a bearer in virtue of the size, shape, and distribution of features on its surface, typically on a continuum from smooth to rough."@en ;
    mds:hasStudyStage "Sample" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .

cco:ont00000338 a owl:Class ;
    rdfs:label "Fan"@en ;
    rdfs:subClassOf cco:ont00000256 ;
    skos:definition "A Fluid Control Artifact that consists of a rotating arrangement of vanes or blades that are designed to act on a portion of fluid to create flow within it."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001754 "https://en.wikipedia.org/wiki/Fan_(machine)" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000345 a owl:Class ;
    rdfs:label "ActofMeasuring"@en ;
    rdfs:subClassOf cco:ont00000228 ;
    skos:definition "A Planned Act that involves determining the extent, dimensions, quanity, or quality of an Entity relative to some standard."@en ;
    skos:example "putting an object on a scale to measure its weight in kilograms",
        "rating Hollywood movies on a 1 to 5 star scale",
        "using a tape measure to determine the height and width of a doorway in inches" ;
    mds:hasStudyStage "Analysis",
        "Synthesis" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000352 a owl:Class ;
    rdfs:label "SatelliteArtifact"@en ;
    skos:definition "A Spacecraft that is designed to Orbit a Space Object (typically Earth)."@en ;
    skos:exactMatch cco:ont00000352 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder .

cco:ont00000358 a owl:Class ;
    rdfs:label "GeospatialRegionBoundingBox"@en ;
    rdfs:subClassOf cco:ont00000358,
        cco:ont00001130 ;
    skos:definition "A Geospatial Polygon that has some Geospatial Region as a non-tangential proper part."@en ;
    skos:exactMatch cco:ont00000358 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder .

cco:ont00000366 a owl:Class ;
    rdfs:label "ActofInformationProcessing"@en ;
    rdfs:subClassOf cco:ont00000228 ;
    skos:definition "A Planned Act in which one or more input Information Content Entities are received, manipulated, transferred, or stored by an Agent."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000380 a owl:Class ;
    rdfs:label "Pressure"@en ;
    rdfs:subClassOf cco:ont00000570 ;
    skos:definition "A Force that is applied perpendicular to the surface of an Object per unit area over which that Force is distributed."@en ;
    skos:exactMatch cco:ont00000380 ;
    mds:hasStudyStage "Materials Processing",
        "Result",
        "Sample",
        "Synthesis" ;
    mds:inDomain mdsdom:EnerMat ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000406 a owl:Class ;
    rdfs:label "MeasurementUnitofGeocoordinate"@en ;
    skos:definition "A Measurement Unit specifying the geospatial coordinates of a location."@en ;
    skos:exactMatch cco:ont00000406 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder .

cco:ont00000413 a owl:Class ;
    rdfs:label "ElectronMicroscope"@en ;
    rdfs:subClassOf cco:ont00000304 ;
    skos:definition "A Microscope that is designed to use a beam of accelerated electrons to illuminate the target and produce a significantly enlarged image of the Object."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electron_microscope&oldid=1060512240"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000419 a owl:Class ;
    rdfs:label "PartNumber"@en ;
    rdfs:subClassOf cco:ont00000077 ;
    skos:altLabel "Sample Number" ;
    skos:definition "A Code Identifier that designates a type of part whose instances are designed to be part of some Artifact."@en ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:LPBF ;
    cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

cco:ont00000420 a owl:Class ;
    rdfs:label "Computer"@en ;
    skos:exactMatch cco:ont00000420 ;
    mds:hasStudyStage "Analysis",
        "Modeling",
        "Tool" .

cco:ont00000436 a owl:Class ;
    rdfs:label "X-rayMicroscope"@en ;
    rdfs:subClassOf cco:ont00000304 ;
    skos:definition "A Microscope that is designed to use Electromagnetic Radiation in the soft X-ray band to produce a significantly enlarged image of the Object."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=X-ray_microscope&oldid=1046169107"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000441 a owl:Class ;
    rdfs:label "Temperature"@en ;
    rdfs:subClassOf bfo:BFO_0000019 ;
    skos:definition "A Quality that inheres in a bearer in virtue of its thermal energy"@en,
        "A Quality that inheres in a bearer in virtue of its thermal energy."@en ;
    mds:hasStudyStage "Materials Processing",
        "Recipe",
        "Result",
        "Sample",
        "Synthesis" ;
    mds:inDomain mdsdom:LPBF,
        mdsdom:Reactions,
        mdsdom:UV-Vis ;
    cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .

cco:ont00000443 a owl:Class ;
    rdfs:label "CommercialOrganization"@en ;
    rdfs:subClassOf cco:ont00001180 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( cco:ont00001180 [ a owl:Restriction ;
                        owl:onProperty bfo:BFO_0000196 ;
                        owl:someValuesFrom cco:ont00000485 ] ) ] ;
    skos:definition "An Organization that is the bearer of a Commercial Role and whose primary objective is to make a profit from the provision of goods or services."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .

cco:ont00000453 a owl:Class ;
    rdfs:label "EnvironmentControlSystem"@en ;
    rdfs:comment "Controlling air quality typically involves temperature control, oxygen replenishment, and removal of moisture, odor, smoke, heat, dust, airborne bacteria, carbon dioxide, and other undesired gases or particulates."@en ;
    rdfs:subClassOf cco:ont00000995 ;
    skos:definition "A Material Artifact that is designed to control the temperature, air quality, or other feature of a Site that is relevant to the comfort or operation of entities located within that Site."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000457 a owl:Class ;
    rdfs:label "PortionofMaterial"@en ;
    rdfs:subClassOf cco:ont00001084 ;
    skos:definition "A Portion of Processed Material that was produced to be used as the input for another Act of Artifact Processing."@en ;
    skos:exactMatch cco:ont00000457 ;
    mds:hasStudyStage "Sample" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000469 a owl:Class ;
    rdfs:label "GeospatialCoordinateReferenceSystem"@en ;
    skos:definition "A Spatial Reference System that is used to determine and identify the location of a point or object at or near the surface of the Earth."@en ;
    skos:exactMatch cco:ont00000469 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder .

cco:ont00000472 a owl:Class ;
    rdfs:label "GeospatialRegion"@en ;
    skos:definition "A Site that is at or near the surface of the Earth."@en ;
    skos:exactMatch cco:ont00000472 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder .

cco:ont00000476 a owl:Class ;
    rdfs:label "Objective"@en ;
    skos:definition "A Directive Information Content Entity that prescribes some projected state that some Agent intends to achieve."@en ;
    skos:exactMatch cco:ont00000476 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder .

cco:ont00000485 a owl:Class ;
    rdfs:label "CommercialRole"@en ;
    rdfs:subClassOf bfo:BFO_0000023 ;
    skos:definition "A Role that inheres in an Organization by virtue of its establishment as a for-profit business."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .

cco:ont00000487 a owl:Class ;
    rdfs:label "GeospatialLocation"@en ;
    skos:definition "A Geospatial Region that is at which an Entity or Event is located."@en ;
    skos:exactMatch cco:ont00000487 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder .

cco:ont00000490 a owl:Class ;
    rdfs:label "X-rayFrequency"@en ;
    rdfs:subClassOf cco:ont00000754 ;
    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 30 petahertz and 30 exahertz."@en ;
    mds:hasStudyStage "Recipe" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000503 a owl:Class ;
    rdfs:label "Power"@en ;
    rdfs:subClassOf bfo:BFO_0000144 ;
    skos:definition "A Process Profile that is characterized by the rate of Work, or Energy consumed, done in a given time period."@en ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:Pyrometry ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000511 a owl:Class ;
    rdfs:label "ActofPlanning"@en ;
    rdfs:subClassOf cco:ont00000228 ;
    skos:definition "A Planned Act that involves making a Plan to achieve some specified Objective."@en ;
    mds:hasStudyStage "Recipe" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000513 a owl:Class ;
    rdfs:label "ActofToolUse"@en ;
    rdfs:subClassOf cco:ont00000566 ;
    skos:definition "An Act of Artifact Employment in which some Agent uses some Tool."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000529 a owl:Class ;
    rdfs:label "DateIdentifier"@en ;
    rdfs:subClassOf cco:ont00000073 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( cco:ont00000073 [ a owl:Restriction ;
                        owl:onProperty cco:ont00001916 ;
                        owl:someValuesFrom cco:ont00000800 ] ) ] ;
    skos:altLabel "Day Identifier"@en ;
    skos:definition "A Temporal Interval Identifier that designates some Day."@en ;
    skos:exactMatch cco:ont00000529 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder,
        mdsdom:Raster ;
    cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


cco:ont00000808 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000791 ;
                rdfs:label "Reactant Artifact Function"@en ;
                skos:altLabel "ReactantArtifactFunction"@en,
                    "Reactant";
                skos:definition "A Chemical Reaction Artifact Function that is realized in a process in which a substance or compound is added to a system in order to bring about a chemical reaction and is consumed in the course of the reaction."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Reagent&oldid=1017651471"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
                mds:hasStudyStage "Sample",
                    "Synthesis" ;
                mds:inDomain mdsdom:Reactions ,
                    mdsdom:Formulation.

cco:ont00000541 a owl:Class ;
    rdfs:label "Diameter"@en ;
    rdfs:subClassOf cco:ont00001367 ;
    skos:definition "A One Dimensional Extent that inheres in a circle in virtue of the extent of a straight line that passes through the center of the circle and starts and ends on the circle's boundary."@en ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:LPBF ;
    cco:ont00001754 "International Organization for Standardization. 2019. Quantities and units -- Part 3: Space and time (ISO 80000-3:2019). International Organization for Standardization. Available at: https://www.iso.org/standard/64974.html."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .

cco:ont00000544 a owl:Class ;
    rdfs:label "Target"@en ;
    rdfs:comment "Although people speak of targeting a process, say, a parade, what in fact are being targeted are the material participants of that process. The disruption or ceasing of the process is the objective of some plan, but not technically a target. Only material things can be targeted for action. Even if some dependent entity is described as being the target, the material thing for which that dependent entity depends is the object of a targeting process."@en ;
    rdfs:subClassOf bfo:BFO_0000040 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( bfo:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty cco:ont00001936 ;
                        owl:someValuesFrom cco:ont00000741 ] ) ] ;
    skos:definition "A Material Entity that is the object of an Act of Targeting."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000564 a owl:Class ;
    rdfs:label "EducationalOrganization"@en ;
    rdfs:subClassOf cco:ont00001180 ;
    skos:definition "An Organization whose primary purpose is to provide training or otherwise facilitate learning or the acquisition of knowledge, Skills, values, beliefs, or habits."@en ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Education&oldid=1064011752"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .

cco:ont00000569 a owl:Class ;
    rdfs:label "Sensor"@en ;
    rdfs:subClassOf cco:ont00000736 ;
    skos:definition "A Transducer that is designed to convert incoming energy into a output signal which reliably corresponds to changes in that energy."@en ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:LPBF ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Sensor&oldid=1059883466"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000570 a owl:Class ;
    rdfs:label "Force"@en ;
    rdfs:subClassOf bfo:BFO_0000144 ;
    skos:definition "A Process Profile that is the rate of change of an object's Momentum, is the product of an object's Mass and Acceleration with respect to an inertial frame of reference, and is measured in units of Newtons (N)."@en ;
    mds:hasStudyStage "Result" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000575 a owl:Class ;
    rdfs:label "QualitySpecification"@en ;
    rdfs:subClassOf cco:ont00000965 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( cco:ont00000965 [ a owl:Restriction ;
                        owl:onProperty cco:ont00001942 ;
                        owl:someValuesFrom bfo:BFO_0000019 ] ) ] ;
    skos:definition "A Directive Information Content Entity that prescribes some Quality."@en ;
    mds:hasStudyStage "Sample" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000581 a owl:Class ;
    rdfs:label "Tool"@en ;
    rdfs:subClassOf cco:ont00000995 ;
    skos:definition "A Material Artifact that is designed to assist in the performance of manual or mechanical work and not to be consumed in that process."@en ;
    skos:exactMatch cco:ont00000581 ;
    mds:hasStudyStage "Materials Processing",
        "Tool" ;
    mds:inDomain mdsdom:Reactions ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Tool&oldid=1061967184"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000591 a owl:Class ;
    rdfs:label "ArtifactLocation"@en ;
    rdfs:subClassOf bfo:BFO_0000029 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( bfo:BFO_0000029 [ a owl:Restriction ;
                        owl:onProperty bfo:BFO_0000124 ;
                        owl:someValuesFrom cco:ont00000995 ] ) ] ;
    skos:definition "A Site that is the location of some Material Artifact."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000592 a owl:Class ;
    rdfs:label "VeracityMeasurementInformationContentEntity"@en ;
    rdfs:comment "'Deviation Measurement Information Content Entity' and 'Veracity Measurement Information Content Entity' are complementary notions. Deviation is a measure of whether reality conforms to an ICE (e.g., a plan or prediction), whereas Veracity is a measure of whether a Descriptive ICE conforms to reality."@en,
        "Note, the term 'accuracy' is avoided due to its ambiguity between: correctness-of-performance (see: 'Reliability Measurement Information Content Entity'), correctness-of-information ('Veracity Measurement Information Content Entity'), and adherance-to-expectations (see: 'Deviation Measurement Information Content Entity')."@en ;
    rdfs:subClassOf cco:ont00001163 ;
    skos:altLabel "Accuracy of Information"@en,
        "Trueness Measurement"@en,
        "Veracity Measurement"@en ;
    skos:definition "A Measurement Information Content Entity that is a measurement of the extent to which a description conforms to the reality it describes."@en ;
    mds:hasStudyStage "Result" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

cco:ont00000604 a owl:Class ;
    rdfs:label "MaximumOrdinalMeasurementInformationContentEntity"@en ;
    skos:exactMatch cco:ont00000604 ;
    mds:hasStudyStage "Result" .

cco:ont00000607 a owl:Class ;
    rdfs:label "Thickness"@en ;
    rdfs:subClassOf cco:ont00000892 ;
    skos:definition "A Depth that inheres in a bearer in virtue of it extending inward through an object."@en ;
    skos:exactMatch cco:ont00000607 ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:FTIR,
        mdsdom:PV-Cell ;
    cco:ont00001754 "International Organization for Standardization. 2019. Quantities and units -- Part 3: Space and time (ISO 80000-3:2019). International Organization for Standardization. Available at: https://www.iso.org/standard/64974.html."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .

cco:ont00000614 a owl:Class ;
    rdfs:label "Mass"@en ;
    rdfs:comment "'Matter' here can also refer to the inertial energy of an object."@en,
        "Typical unit of measure is the kilogram or pound."@en ;
    rdfs:subClassOf bfo:BFO_0000019 ;
    skos:definition "A Quality that inheres in a bearer in virtue of the amount of matter in that bearer."@en ;
    skos:exactMatch cco:ont00000614 ;
    mds:hasStudyStage "Sample" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .

cco:ont00000633 a owl:Class ;
    rdfs:label "Weight"@en ;
    rdfs:comment "When an object is \"weighed\", in the typical case, it is done so by taking into account the local force of gravity to determine the object's mass, whose standard of measure is the kilogram. The actual unit of measure of weight is the newton."@en ;
    rdfs:subClassOf bfo:BFO_0000019 ;
    skos:definition "A Quality that inheres in some material entity with a mass in virtue of its location in some gravitational field."@en ;
    mds:hasStudyStage "Sample" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .

cco:ont00000649 a owl:Class ;
    rdfs:label "Non-NameIdentifier"@en ;
    rdfs:subClassOf cco:ont00000686 ;
    skos:altLabel "ID"@en,
        "Identifier"@en ;
    skos:definition "A Designative Information Content Entity that consists of a string of characters that designates an entity within a specified namespace or context, is not a Designative Name, may be automatically or randomly generated, and typically has no preexisting cultural or social significance."@en ;
    skos:exactMatch cco:ont00000649 ;
    mds:inDomain mdsdom:Reactions ;
    cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

cco:ont00000651 a owl:Class ;
    rdfs:label "ContainingArtifactFunction"@en ;
    rdfs:subClassOf cco:ont00000323 ;
    skos:definition "An Artifact Function that is realized in a process in which one entity contains another."@en ;
    cco:ont00001754 "http://www.dictionary.com/browse/containing" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000653 a owl:Class ;
    rdfs:label "Algorithm"@en ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes some Process and contains a finite sequence of unambiguous instructions in order to achieve some Objective."@en ;
    skos:exactMatch cco:ont00000653 ;
    mds:hasStudyStage "Analysis",
        "Modeling",
        "Recipe" ;
    cco:ont00001754 "http://purl.obolibrary.org/obo/IAO_0000064"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

cco:ont00000660 a owl:Class ;
    rdfs:label "Effect"@en ;
    rdfs:subClassOf bfo:BFO_0000015 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( bfo:BFO_0000015 [ a owl:Restriction ;
                        owl:onProperty cco:ont00001819 ;
                        owl:someValuesFrom bfo:BFO_0000015 ] ) ] ;
    skos:altLabel "Consequence"@en ;
    skos:definition "A Process that follows and is caused by some previous Process."@en ;
    mds:hasStudyStage "Sample" ;
    cco:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=effect" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000663 a owl:Class ;
    rdfs:label "PowerTransmissionArtifact"@en ;
    rdfs:subClassOf cco:ont00000995 ;
    skos:definition "A Material Artifact that is designed to transfer and regulate Power flow from a Power Source to an application point."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000678 a owl:Class ;
    rdfs:label "VoltageRegulatingArtifactFunction"@en ;
    rdfs:subClassOf cco:ont00000098 ;
    skos:definition "An Artifact Function that is realized by processes in which some Material Artifact is used to cause a change in the voltage magnitude between the sending and receiving end of an electrical component."@en ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Voltage_regulation&oldid=1045628774"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000686 a owl:Class ;
    rdfs:label "DesignativeInformationContentEntity"@en ;
    rdfs:subClassOf cco:ont00000958 ;
    owl:disjointWith cco:ont00000853,
        cco:ont00000965 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( cco:ont00000958 [ a owl:Restriction ;
                        owl:onProperty cco:ont00001916 ;
                        owl:someValuesFrom bfo:BFO_0000001 ] ) ] ;
    skos:altLabel "Designative ICE"@en ;
    skos:definition "An Information Content Entity that consists of a set of symbols that denote some Entity."@en,
        "An Information Content Entity that consists of a set of symbols that designate some Entity."@en ;
    skos:exactMatch cco:ont00000686 ;
    mds:hasStudyStage " General",
        "Result" ;
    mds:inDomain mdsdom:Raster ;
    cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

cco:ont00000702 a owl:Class ;
    rdfs:label "Image"@en,
        "MaterialCopyofanImage"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000101 ;
            owl:someValuesFrom cco:ont00002004 ],
        cco:ont00000253,
        cco:ont00000798 ;
    skos:altLabel "Image"@en ;
    skos:definition "An Information Bearing Artifact that is designed to carry an Information Content Entity that represents some entity owing to a visual isomorphism between the carrying artifact and the entity."@en ;
    skos:exactMatch cco:ont00000702 ;
    mds:hasStudyStage " General",
        "Result" ;
    mds:inDomain mdsdom:PlaceHolder ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Image&oldid=1062709732"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000712 a owl:Class ;
    rdfs:label "Acceleration"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom cco:ont00000763 ],
        bfo:BFO_0000144 ;
    skos:definition "A Process Profile that is the rate of change of the Velocity of an object."@en ;
    mds:hasStudyStage "Result" ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Acceleration&oldid=1062249960"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000738 a owl:Class ;
    rdfs:label "Length"@en ;
    rdfs:subClassOf cco:ont00001367 ;
    skos:broader mds:Recipe ;
    skos:definition "A One Dimensional Extent that inheres in a bearer in virtue of the bearer's greatest extent in one direction."@en ;
    skos:exactMatch cco:ont00000738 ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:FTIR,
        mdsdom:PV-Site,
        mdsdom:Reactions,
        mdsdom:XRD ;
    cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .

cco:ont00000752 a owl:Class ;
    rdfs:label "WaveProcessProfile"@en ;
    rdfs:comment "This is a defined class used to group process profiles of Wave Processes. Note that not every relevant process profile can be asserted as a subtype, however, because they (e.g. Frequency and Amplitude) are applicable to other processes as well (e.g. Oscillation Process)."@en ;
    rdfs:subClassOf bfo:BFO_0000144 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( bfo:BFO_0000144 [ a owl:Restriction ;
                        owl:onProperty cco:ont00001857 ;
                        owl:someValuesFrom cco:ont00000099 ] ) ] ;
    skos:definition "A Process Profile of a Wave Process."@en ;
    mds:hasStudyStage "Result" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000763 a owl:Class ;
    rdfs:label "Velocity"@en ;
    rdfs:subClassOf bfo:BFO_0000144 ;
    skos:definition "A Process Profile of an object's Motion that is characterized by its Speed and direction with respect to a frame of reference."@en ;
    skos:exactMatch cco:ont00000763 ;
    mds:hasStudyStage "Result" ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Velocity&oldid=1063300750"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000768 a owl:Class ;
    rdfs:label "Amount"@en ;
    rdfs:subClassOf bfo:BFO_0000019 ;
    skos:definition "A Quality that inheres in a bearer in virtue of the total, aggregate or sum of a number of discrete items or material the entity contains as parts."@en ;
    skos:exactMatch cco:ont00000768 ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:Reactions ;
    cco:ont00001754 "http://en.wiktionary.org/wiki/amount" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .

cco:ont00000771 a owl:Class ;
    rdfs:label "ImagingInstrument"@en ;
    rdfs:subClassOf cco:ont00000995 ;
    skos:definition "A Material Artifact that is designed to produce images (visual representations) of an entity."@en ;
    skos:exactMatch cco:ont00000771 ;
    mds:hasStudyStage " General",
        "Tool" ;
    mds:inDomain mdsdom:LPBF,
        mdsdom:PlaceHolder ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000781 a owl:Class ;
    rdfs:label "ControlSystem"@en ;
    rdfs:subClassOf cco:ont00000995 ;
    skos:definition "A Material Artifact that is designed to manage, command, direct, or regulate the behavior of at least one other Artifact."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Control_system&oldid=1061817176"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000784 a owl:Class ;
    rdfs:label "OpticalProperty"@en ;
    rdfs:subClassOf cco:ont00000628 ;
    skos:definition "An Electromagnetic Radiation Property that is realized when its bearer interacts with electromagnetic waves within the visible light spectrum."@en ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:UV-Vis ;
    cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .

cco:ont00000787 a owl:Class ;
    rdfs:label "Altitude"@en ;
    skos:definition "A Height that inheres in a Site that externally connects an Independent Continuant to either the surface of the Earth or the Earth's mean Sea Level."@en ;
    skos:exactMatch cco:ont00000787 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder .

cco:ont00000791 a owl:Class ;
    rdfs:label "ChemicalReactionArtifactFunction"@en ;
    rdfs:subClassOf cco:ont00000323 ;
    skos:definition "An Artifact Function that is realized in a process that leads to the transformation of one set of chemical substances to another."@en ;
    mds:hasStudyStage "Synthesis" ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Chemical_reaction&oldid=1063262412"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000795 a owl:Class ;
    rdfs:label "ElectricalConductionArtifactFunction"@en ;
    rdfs:subClassOf cco:ont00000098 ;
    skos:definition "An Electrical Artifact Function that is realized by a Material Artifact being used to conduct an electric current."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000798 a owl:Class ;
    rdfs:label "InformationBearingArtifact"@en ;
    skos:exactMatch cco:ont00000798 ;
    mds:hasStudyStage "Tool" .

cco:ont00000806 a owl:Class ;
    rdfs:label "PowerTool"@en ;
    rdfs:subClassOf cco:ont00000581 ;
    skos:definition "A Tool that is designed to be actuated by a Power Source and mechanism other than or in addition to manual labor."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Power_tool&oldid=1057147715"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


cco:ont00000829 a owl:Class ;
    rdfs:label "TimeZoneIdentifier"@en ;
    skos:definition "A Spatial Region Identifier that designates the region associated with some uniform standard time for legal, commercial, or social purposes."@en ;
    skos:exactMatch cco:ont00000829 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Raster .

cco:ont00000830 a owl:Class ;
    rdfs:label "Speed"@en ;
    rdfs:comment "An object's speed is the scalar absolute value of it's Velocity."@en ;
    rdfs:subClassOf bfo:BFO_0000144 ;
    skos:definition "A Process Profile that is characterized by the magnitude of an object's motion with respect to a frame of reference during some time period."@en ;
    mds:hasStudyStage "Result" ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Speed&oldid=1058949945"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000843 a owl:Class ;
    rdfs:label "SolarPanel"@en ;
    rdfs:subClassOf cco:ont00001049 ;
    skos:definition "An Electrical Power Source that consists in part of one or more photovoltaic (i.e. solar) cells that convert light energy (photons) directly into electricity by means of the photovoltaic effect."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Solar_cell&oldid=1063439932"^^xsd:anyURI,
        "https://en.wikipedia.org/w/index.php?title=Solar_panel&oldid=1064397496"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000845 a owl:Class ;
    rdfs:label "ProportionalRatioMeasurementInformationContentEntity"@en ;
    rdfs:comment "A percentage is one way to express a proportional measure where the decimal expression of the proportion is multiplied by 100, thus giving the proportional value with respect to a whole of 100. E.g., the ratio of pigs to cows on a farm is 44 to 79 (44:79 or 44/79). The proportion of pigs to total animals is 44 to 123 or 44/123. The percentage of pigs is the decimal equivalent of the proportion (0.36) multiplied by a 100 (36%). The percentage can be expressed as a proportion where the numerator value is transformed for a denominator of 100, i.e., 36 of a 100 animals are pigs (36/100)."@en,
        "We may want to add either a subclass for Percentage or a data property (has percentage value) that links the percentage expression for a proportion to the relevant IBE."@en ;
    rdfs:subClassOf cco:ont00001022 ;
    skos:definition "A Ratio Measurement Information Content Entity that is a measurement of a portion of a whole (described by the numerator) compared against that whole (described by the denominator) where the whole is a nominally described set of like entities."@en ;
    mds:hasStudyStage "Result" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

cco:ont00000849 a owl:Class ;
    rdfs:label "HeatingSystem"@en ;
    rdfs:subClassOf cco:ont00000453 ;
    skos:definition "An Environment Control System that is designed to heat the air or objects in a Site."@en ;
    mds:hasStudyStage "Materials Processing",
        "Synthesis",
        "Tool" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000853 a owl:Class ;
    rdfs:label "DescriptiveInformationContentEntity"@en ;
    rdfs:subClassOf cco:ont00000958 ;
    owl:disjointWith cco:ont00000965 ;
    skos:altLabel "Descriptive ICE"@en ;
    skos:definition "An Information Content Entity that consists of a set of propositions that describe some Entity."@en ;
    skos:exactMatch cco:ont00000853 ;
    mds:hasStudyStage "Result" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

cco:ont00000856 a owl:Class ;
    rdfs:label "ArtifactHistory"@en ;
    rdfs:subClassOf bfo:BFO_0000182 ;
    skos:definition "A History of an Artifact."@en ;
    mds:hasStudyStage "Recipe" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000892 a owl:Class ;
    rdfs:label "Depth"@en ;
    rdfs:subClassOf cco:ont00001367 ;
    skos:definition "A One Dimensional Extent that inheres in a bearer in virtue of the bearer's extension in a downward, backward, or inward direction."@en ;
    skos:exactMatch cco:ont00000892 ;
    mds:hasStudyStage "Sample" ;
    cco:ont00001754 "International Organization for Standardization. 2019. Quantities and units -- Part 3: Space and time (ISO 80000-3:2019). International Organization for Standardization. Available at: https://www.iso.org/standard/64974.html."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .

cco:ont00000893 a owl:Class ;
    rdfs:label "InformationMediumArtifact"@en ;
    rdfs:comment "An empty notebook, when manufactured, is a medium but not yet a carrier of information content. However, a book, in the sense of a novel or collection of philosophical essays or poems, depends necessarily on it carrying some information content. Thus, there are no empty books. Likewise, there are no empty databases, only portions of digital storage that have not yet been configured to carry some information content according to a database software application."@en ;
    rdfs:subClassOf cco:ont00000995 ;
    skos:definition "A Material Artifact that is designed to have some Information Bearing Artifact as part."@en ;
    skos:example "A magnetic hard drive",
        "A notebook" ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000908 a owl:Class ;
    rdfs:label "ActofArtifactProcessing"@en ;
    rdfs:subClassOf cco:ont00000228 ;
    skos:definition "A Planned Act of performing a series of mechanical or chemical operations on something in order to change or preserve it."@en ;
    skos:exactMatch cco:ont00000908 ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000910 a owl:Class ;
    rdfs:label "Amplitude"@en ;
    rdfs:subClassOf bfo:BFO_0000144 ;
    skos:definition "A Process Profile of an Oscillation Process that is the absolute value of the maximum displacement from a zero, equilibrium, or mean value during one cycle of the Oscillation Process."@en ;
    mds:hasStudyStage "Result" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000932 a owl:Class ;
    rdfs:label "ComputingArtifactFunction"@en ;
    skos:exactMatch cco:ont00000932 ;
    mds:hasStudyStage "Tool" .

cco:ont00000944 a owl:Class ;
    rdfs:label "ThermalImagingArtifactFunction"@en ;
    rdfs:subClassOf cco:ont00000601 ;
    skos:definition "An Imaging Artifact Function that is realized during events in which an Artifact is used to create a visual representation of an entity using radiation from the far infrared region of the electromagnetic spectrum that the entity emits"@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000945 a owl:Class ;
    rdfs:label "X-rayTelescope"@en ;
    rdfs:subClassOf cco:ont00000547 ;
    skos:definition "A Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing X-rays to form an enhanced image of the Object."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=X-ray_telescope&oldid=1035025593"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000947 a owl:Class ;
    rdfs:label "TemperatureMeasurementArtifactFunction"@en ;
    rdfs:subClassOf cco:ont00001100 ;
    skos:definition "A Measurement Artifact Function that is realized during events in which an Artifact is used to measure the Temperature of a specified object or class of objects."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000950 a owl:Class ;
    rdfs:label "ActofMaintenance"@en ;
    rdfs:subClassOf cco:ont00000970 ;
    skos:definition "An Act of Artifact Modification in which an Artifact is modified in order to preserve or restore one or more of its designed Qualities or Functions."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000958 a owl:Class ;
    rdfs:label "InformationContentEntity"@en ;
    skos:definition "A Generically Dependent Continuant that generically depends on some Information Bearing Entity and stands in relation of aboutness to some Entity."@en ;
    skos:exactMatch cco:ont00000958 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder .

cco:ont00000965 a owl:Class ;
    rdfs:label "PrescriptiveInformationContentEntity"@en ;
    rdfs:subClassOf cco:ont00000958 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( cco:ont00000958 [ a owl:Restriction ;
                        owl:onProperty cco:ont00001942 ;
                        owl:someValuesFrom bfo:BFO_0000001 ] ) ] ;
    skos:altLabel "Directive ICE"@en ;
    skos:definition "An Information Content Entity that consists of a set of propositions or images (as in the case of a blueprint) that prescribe some Entity."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

cco:ont00000967 a owl:Class ;
    rdfs:label "Height"@en ;
    rdfs:subClassOf cco:ont00001367 ;
    skos:definition "A One Dimensional Extent that inheres in a bearer in virtue of the bearer's extension in a vertical direction."@en ;
    mds:hasStudyStage "Sample" ;
    cco:ont00001754 "International Organization for Standardization. 2019. Quantities and units -- Part 3: Space and time (ISO 80000-3:2019). International Organization for Standardization. Available at: https://www.iso.org/standard/64974.html."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .

cco:ont00000970 a owl:Class ;
    rdfs:label "ActofArtifactModification"@en ;
    rdfs:comment "Excluded from this class are instances of role change or role creation such as the introduction of an artifact as a piece of evidence in a trial or the loading of artifacts onto a ship for transport."@en ;
    rdfs:subClassOf cco:ont00000908 ;
    skos:definition "An Act of Artifact Processing in which an existing Artifact is acted upon in a manner that changes, adds, or removes one or more of its Qualities, Dispositions, or Functions."@en ;
    mds:hasStudyStage "Materials Processing" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000978 a owl:Class ;
    rdfs:label "Cause"@en ;
    rdfs:subClassOf bfo:BFO_0000015 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( bfo:BFO_0000015 [ a owl:Restriction ;
                        owl:onProperty cco:ont00001803 ;
                        owl:someValuesFrom bfo:BFO_0000015 ] ) ] ;
    skos:definition "A Process that is the cause of or one of the causes of some other Process."@en ;
    mds:hasStudyStage "Sample" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000981 a owl:Class ;
    rdfs:label "ActofPortionofMaterialConsumption"@en ;
    rdfs:subClassOf cco:ont00000566 ;
    skos:definition "An Act of Artifact Employment in which a Portion of Material is expended."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00000985 a owl:Class ;
    rdfs:label "ThermalInsulationArtifactFunction"@en ;
    rdfs:subClassOf cco:ont00001350 ;
    skos:definition "A Thermal Control Artifact Function that is realized during events in which a Material Artifact prevents or reduces the transfer of heat between objects that are in thermal contact or in range of radiative influence."@en ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Thermal_insulation&oldid=1059273300"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00000995 a owl:Class ;
    rdfs:label "MaterialArtifact"@en ;
    rdfs:subClassOf bfo:BFO_0000040 ;
    skos:definition "A Material Entity that was designed by some Agent to realize a certain Function."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00001006 a owl:Class ;
    rdfs:label "OperatorRole"@en ;
    rdfs:subClassOf bfo:BFO_0000023 ;
    skos:definition "A Role that inheres in an Agent by virtue of that Agent's responsibilities to operate or control some Material Artifact."@en ;
    skos:example "the role of driving a car",
        "the role of flying an airplane",
        "the role of operating a crane" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .

cco:ont00001013 a owl:Class ;
    rdfs:label "HeatingArtifactFunction"@en ;
    rdfs:subClassOf cco:ont00000323 ;
    skos:definition "An Artifact Function that is realized in a process in which the thermal energy of a system increases."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00001017 a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:subClassOf bfo:BFO_0000040 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( bfo:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty bfo:BFO_0000196 ;
                        owl:someValuesFrom cco:ont00001379 ] ) ] ;
    skos:definition "A Material Entity that bears an Agent Capability."@en ;
    cco:ont00001754 "Schlosser, Markus, \"Agency\", The Stanford Encyclopedia of Philosophy (Winter 2019 Edition), Edward N. Zalta (ed.), available at: https://plato.stanford.edu/archives/win2019/entries/agency/"@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .

cco:ont00001022 a owl:Class ;
    rdfs:label "RatioMeasurementInformationContentEntity"@en ;
    skos:exactMatch cco:ont00001022 ;
    mds:hasStudyStage "Result" .

cco:ont00001041 a owl:Class ;
    rdfs:label "SequencePositionOrdinality"@en ;
    skos:exactMatch cco:ont00001041 ;
    mds:hasStudyStage "Recipe" .

cco:ont00001042 a owl:Class ;
    rdfs:label "EquipmentMount"@en ;
    rdfs:subClassOf cco:ont00000995 ;
    skos:definition "A Material Artifact that is designed to support an Artifact."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00001045 a owl:Class ;
    rdfs:label "ArtifactModel"@en ;
    rdfs:subClassOf cco:ont00000319 ;
    skos:definition "A Directive Information Content Entity that prescribes a common set of Functions and Qualities to inhere in a set of artifact instances."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00001047 a owl:Class ;
    rdfs:label "Frequency"@en ;
    skos:exactMatch cco:ont00001047 ;
    mds:hasStudyStage "Result" .

cco:ont00001049 a owl:Class ;
    rdfs:label "ElectricalPowerSource"@en ;
    rdfs:subClassOf cco:ont00000288 ;
    skos:definition "A Power Source that is designed to generate, control, and transfer power in the form of electrical energy."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00001056 a owl:Class ;
    rdfs:label "VisibleLightFrequency"@en ;
    rdfs:comment "Visible light overlaps with near infrared and near ultraviolet" ;
    rdfs:subClassOf cco:ont00000754 ;
    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 400 and 800 terahertz"@en ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:UV-Vis ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Light&oldid=1062630851"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00001065 a owl:Class ;
    rdfs:label "TwoDimensionalExtent"@en ;
    rdfs:subClassOf cco:ont00001202 ;
    skos:altLabel "Area"@en ;
    skos:definition "A Size Quality that inheres in a bearer in virtue of the bearer's extension in two dimensions."@en ;
    mds:hasStudyStage "Sample" ;
    cco:ont00001754 "International Organization for Standardization. 2019. Quantities and units -- Part 3: Space and time (ISO 80000-3:2019). International Organization for Standardization. Available at: https://www.iso.org/standard/64974.html."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .

cco:ont00001067 a owl:Class ;
    rdfs:label "Laser"@en ;
    rdfs:subClassOf cco:ont00000995 ;
    skos:definition "A Material Artifact that is designed to emit light coherently through a process of optical amplification based on the stimulated emission of electromagnetic radiation."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Laser&oldid=1059215159"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00001084 a owl:Class ;
    rdfs:label "PortionofProcessedMaterial"@en ;
    rdfs:subClassOf cco:ont00000995 ;
    skos:definition "A Material Artifact that is the output of an Act of Artifact Processing."@en ;
    mds:hasStudyStage "Sample" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00001092 a owl:Class ;
    rdfs:label "ElectricalPowerStorageArtifactFunction"@en ;
    rdfs:subClassOf cco:ont00000098 ;
    skos:altLabel "Capacitance"@en ;
    skos:definition "An Electrical Artifact Function that is realized during events in which a Material Artifact is used to store electrical power to be released at a later time."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00001100 a owl:Class ;
    rdfs:label "MeasurementArtifactFunction"@en ;
    rdfs:subClassOf cco:ont00000323 ;
    skos:definition "An Artifact Function that is realized during events in which an Artifact is used to measure one or more features of a specified object or class of objects."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00001103 a owl:Class ;
    rdfs:label "ArtifactModelName"@en ;
    rdfs:subClassOf cco:ont00000686 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( cco:ont00000686 [ a owl:Restriction ;
                        owl:onProperty cco:ont00001916 ;
                        owl:someValuesFrom cco:ont00001045 ] ) ] ;
    skos:definition "A Designative Information Content Entity that designates some Material Artifact Model."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00001130 a owl:Class ;
    rdfs:label "GeospatialPolygon"@en ;
    skos:exactMatch cco:ont00001130 .

cco:ont00001149 a owl:Class ;
    rdfs:label "DataRangeIntervalEstimateInformationContentEntity"@en ;
    skos:exactMatch cco:ont00001149 ;
    mds:hasStudyStage "Recipe" .

cco:ont00001153 a owl:Class ;
    rdfs:label "DamagingArtifactFunction"@en ;
    rdfs:subClassOf cco:ont00000323 ;
    skos:definition "An Artifact Function that is realized in a process in which the structural integrity of an entity is impaired."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00001154 a owl:Class ;
    rdfs:label "Multi-SecondTemporalInterval"@en ;
    rdfs:comment "This is a defined class."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001924 ;
            owl:someValuesFrom cco:ont00000992 ],
        bfo:BFO_0000038 ;
    skos:definition "A one-dimensional temporal region that is measured in Seconds and spans at least one Second."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI .

cco:ont00001158 a owl:Class ;
    rdfs:label "ActofDataTransformation"@en ;
    rdfs:subClassOf cco:ont00000366 ;
    skos:definition "An Act of Information Processing in which an algorithm is executed to act upon one or more input Information Content Entities into one or more output Information Content Entities."@en ;
    skos:exactMatch cco:ont00001158 ;
    skos:scopeNote "It is not a requirement that the output Information Content Entity(ies) be qualitatively distinct from the input(s) as a result of an Act of Data Transformation, though doing so is typically the goal of performing this Act. Consider, for example, selecting a column in an Excel spreadsheet then executing the \"Remove Duplicates\" Algorithm on it. The intent is to remove rows in that column containing duplicate content. If no duplicate values are present, the information in the column remains unchanged but an Act of Data Transformation was nonetheless performed."@en ;
    mds:hasStudyStage " General",
        "Analysis" ;
    mds:inDomain mdsdom:Raster ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00001160 a owl:Class ;
    rdfs:label "SolventArtifactFunction"@en ;
    skos:altLabel "Solvent"@en ;
    rdfs:subClassOf cco:ont00000791 ;
    mds:hasStudyStage "Sample",
        "Synthesis" ;
    skos:definition "A Chemical Reaction Artifact Function that is realized in the dissolving of other substances (namely, solutes) without change in the former's chemical structure."@en ;
    mds:inDomain mdsdom:Reactions ,
        mdsdom:Formulation.

cco:ont00001163 a owl:Class ;
    rdfs:label "MeasurementInformationContentEntity"@en ;
    skos:definition "A Descriptive Information Content Entity that describes the extent, dimensions, quantity, or quality of an Entity relative to some standard."@en ;
    skos:exactMatch cco:ont00001163 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Raster .

cco:ont00001180 a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:comment "Members of organizations are either Organizations themselves or individual Persons. Members can bear specific Organization Member Roles that are determined in the organization rules. The organization rules also determine how decisions are made on behalf of the Organization by the organization members."@en ;
    rdfs:subClassOf cco:ont00000300 ;
    skos:definition "A Group of Agents which can be the bearer of roles, has members, and has a set of organization rules."@en ;
    skos:exactMatch cco:ont00001180 ;
    cco:ont00001754 "http://purl.obolibrary.org/obo/OBI_0000245" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .

cco:ont00001196 a owl:Class ;
    rdfs:label "ActofArtifactAssembly"@en ;
    rdfs:comment "Many Acts of Manufacturing and Construction involve one or more Acts of Artifact Assembly, but Acts of Artifact Assembly can also occur in isolation from these activities."@en ;
    rdfs:subClassOf cco:ont00000908 ;
    skos:definition "An Act of Artifact Processing wherein a new Artifact is created by fitting component parts together."@en ;
    skos:example "putting together a piece of furniture purchased from Ikea" ;
    mds:hasStudyStage "Materials Processing" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00001200 a owl:Class ;
    rdfs:label "StructuralSupportArtifactFunction"@en ;
    rdfs:subClassOf cco:ont00000323 ;
    skos:definition "An Artifact Function that is realized by a Material Artifact providing physical support to another object."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00001202 a owl:Class ;
    rdfs:label "SizeQuality"@en ;
    rdfs:subClassOf bfo:BFO_0000019 ;
    skos:definition "A Quality that inheres in a bearer in virtue of the bearer's extension in one or more dimensions."@en ;
    mds:hasStudyStage "Sample" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .

cco:ont00001207 a owl:Class ;
    rdfs:label "OpticalLens"@en ;
    rdfs:subClassOf cco:ont00000136 ;
    skos:altLabel "Lens"@en ;
    skos:definition "An Optical Instrument that is designed to focus or disperse a beam of light entering the lens by means of refraction."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001754 "https://en.wikipedia.org/wiki/Lens_(optics)" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00001218 a owl:Class ;
    rdfs:label "SignalProcessingArtifactFunction"@en ;
    rdfs:subClassOf cco:ont00000323 ;
    skos:definition "An Artifact Function that is realized in the process of transferring or processing information contained in signals."@en ;
    mds:hasStudyStage "Sample" ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Signal_processing&oldid=1062720685"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00001222 a owl:Class ;
    rdfs:label "SolarPanelSystem"@en ;
    rdfs:subClassOf cco:ont00001049 ;
    skos:altLabel "Photovoltaic System"@en,
        "Solar Array"@en ;
    skos:definition "An Electrical Power Source that consists in part of one or more Solar Panels, a power inverter, electrical wiring between the components, a mounting and support structure, and may also include a battery and/or a solar tracking system and is the bearer of functions realized in processes of deriving, transferring, and storing electrical energy derived from light energy."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Photovoltaic_system&oldid=1063366598"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00001242 a owl:Class ;
    rdfs:label "Actuator"@en ;
    rdfs:subClassOf cco:ont00000736 ;
    skos:definition "A Transducer that is designed to convert some control signal into mechanical motion."@en ;
    mds:hasStudyStage "Tool" ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Actuator&oldid=1064000375"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00001262 a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:subClassOf cco:ont00000562 ;
    skos:altLabel "Human"@en ;
    skos:definition "An Animal that is a member of the species Homo sapiens."@en ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Human&oldid=1063145185"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .

cco:ont00001294 a owl:Class ;
    rdfs:label "ThreeDimensionalExtent"@en ;
    rdfs:subClassOf cco:ont00001202 ;
    skos:altLabel "Volume"@en ;
    skos:definition "A Size Quality that inheres in a bearer in virtue of the bearer's extension in three dimensions."@en ;
    mds:hasStudyStage "Sample" ;
    cco:ont00001754 "International Organization for Standardization. 2019. Quantities and units -- Part 3: Space and time (ISO 80000-3:2019). International Organization for Standardization. Available at: https://www.iso.org/standard/64974.html."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .

cco:ont00001304 a owl:Class ;
    rdfs:label "DimensionSpecification"@en ;
    rdfs:subClassOf cco:ont00000575 ;
    skos:definition "An Quality Specification that prescribes some Size Quality."@en ;
    mds:hasStudyStage "Sample" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

cco:ont00001309 a owl:Class ;
    rdfs:label "LotNumber"@en ;
    rdfs:subClassOf cco:ont00000077 ;
    skos:definition "A Code Identifier that designates a particular quantity or lot of material from a single manufacturer."@en ;
    mds:hasStudyStage "Sample" ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Lot_number&oldid=1061846325"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

cco:ont00001332 a owl:Class ;
    rdfs:label "UltravioletLightFrequency"@en ;
    rdfs:subClassOf cco:ont00000610 ;
    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 750 terahertz and 30 petahertz"@en ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:UV-Vis ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ultraviolet&oldid=1062593453"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00001337 a owl:Class ;
    rdfs:label "InfraredLightFrequency"@en ;
    rdfs:subClassOf cco:ont00000754 ;
    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 300 gigahertz and 430 tetrahertz."@en ;
    mds:hasStudyStage "Recipe" ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Infrared&oldid=1064111319"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00001357 a owl:Class ;
    rdfs:label "MeasurementUnitofTime"@en ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of temporal regions."@en ;
    skos:exactMatch cco:ont00001357 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Raster .

cco:ont00001359 a owl:Class ;
    rdfs:label "ActofManufacturing"@en ;
    rdfs:comment "An Act of Manufacturing typically involves the mass production of goods."@en ;
    rdfs:subClassOf cco:ont00000908 ;
    skos:definition "An Act of Artifact Processing wherein Artifacts are created in a Facility for the purpose of being sold to consumers."@en ;
    mds:hasStudyStage "Materials Processing" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00001360 a owl:Class ;
    rdfs:label "ThreeDimensionalShape"@en ;
    rdfs:subClassOf cco:ont00001059 ;
    skos:definition "A Shape Quality that inheres only in a three dimensional entity."@en ;
    mds:hasStudyStage "Sample" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .

cco:ont00001367 a owl:Class ;
    rdfs:label "OneDimensionalExtent"@en ;
    skos:exactMatch cco:ont00001367 .

cco:ont00001376 a owl:Class ;
    rdfs:label "Torque"@en ;
    rdfs:subClassOf cco:ont00000570 ;
    skos:altLabel "Moment of Force"@en ;
    skos:definition "A Force that is applied to an object in a direction that would tend to cause the object to rotate around an Axis of Rotation and is the rate of change of an object's Angular Momentum."@en ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Torque&oldid=1063339484"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

cco:ont00001384 a owl:Class ;
    rdfs:label "Opacity"@en ;
    rdfs:subClassOf cco:ont00000628 ;
    skos:definition "An Electromagnetic Radiation Property that inheres in a bearer in virtue of that bearer's capacity to transmit electromagnetic radiation of a given frequency through the bearer instead of reflecting, scattering, or absorbing electromangentic radiation of that frequency."@en ;
    mds:hasStudyStage "Sample" ;
    cco:ont00001754 "https://en.wikipedia.org/wiki/Opacity_(optics)" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .

goo:AdministrativeAreaScopedEntity a owl:Class ;
    rdfs:label "Administrativearea-scopedentity"@en ;
    rdfs:comment "An entity associated with or representing an administrative area such as a U.S. county, state, territory, or the District of Columbia."@en ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:AquaImage a owl:Class ;
    rdfs:label "AquaImage"@en ;
    rdfs:comment "A subclass of mds:Image representing NASA Aqua satellite images."@en ;
    rdfs:subClassOf goo:SatelliteImage ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:County a owl:Class ;
    rdfs:label "County"@en ;
    rdfs:comment "A U.S. county with geospatial coordinate metadata and links to external resources such as DBpedia and Wikidata."@en ;
    rdfs:subClassOf geosparql:Feature,
        geosparql:SpatialThing,
        mds:GeospatialFeature,
        goo:AdministrativeAreaScopedEntity ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:CountyScopedEntity a owl:Class ;
    rdfs:label "County-scopedentity"@en ;
    rdfs:comment "An entity associated with or representing a county."@en ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:CustomerOutageRecord a owl:Class ;
    rdfs:label "CustomerOutageRecord"@en ;
    rdfs:comment "Numerical outage record per customer for county at date and time from Eagle-I dataset."@en ;
    rdfs:subClassOf goo:CountyScopedEntity,
        goo:TabularData ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:GOESImage a owl:Class ;
    rdfs:label "GOESImage"@en ;
    rdfs:comment "A subclass of mds:Image representing NOAA GOES satellite images."@en ;
    rdfs:subClassOf goo:SatelliteImage ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:HurricaneEventRecord a owl:Class ;
    rdfs:label "HurricaneEventRecord"@en ;
    rdfs:comment "A hurricane event from the NOAA HURDAT Database."@en ;
    rdfs:subClassOf goo:HurricaneObservationEntity,
        goo:TabularData ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:HurricaneObservationEntity a owl:Class ;
    rdfs:label "Hurricaneobservationentity"@en ;
    rdfs:comment "A grouping class for tabular records that contain hurricane observation metadata, such as wind speed, pressure, status, basin, or storm identifier."@en ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:HurricaneTrackRecord a owl:Class ;
    rdfs:label "HurricaneTrackRecord"@en ;
    rdfs:comment "A specific 6-hourly position and intensity record for a hurricane event."@en ;
    rdfs:subClassOf goo:HurricaneObservationEntity,
        goo:TabularData ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:NTLImage a owl:Class ;
    rdfs:label "NTLImage"@en ;
    rdfs:comment "A subclass of mds:Image representing Nighttime Light images from Black Marble Dataset."@en ;
    rdfs:subClassOf goo:SatelliteImage ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:OutageMap a owl:Class ;
    rdfs:label "OutageMap"@en ;
    rdfs:comment "A geospatial raster map representing power outage severity, generated from NTL Imagery."@en ;
    rdfs:subClassOf mds:GeospatialRaster,
        goo:CountyScopedEntity ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:Satellite a owl:Class ;
    rdfs:label "Satellite"@en ;
    rdfs:comment "A satellite in orbit used for collecting geospatial data."@en ;
    rdfs:subClassOf mds:Satellite ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:SatelliteDatasetProduct a owl:Class ;
    rdfs:label "SatelliteDatasetProduct"@en ;
    rdfs:comment "A named satellite data product or collection used to derive satellite imagery, such as a NASA Earthdata product."@en ;
    rdfs:subClassOf mds:Dataset ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:SatelliteGranule a owl:Class ;
    rdfs:label "SatelliteGranule"@en ;
    rdfs:comment "A source satellite granule, tile, or scene from which an image was produced."@en ;
    rdfs:subClassOf mds:GeospatialRaster ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:SatelliteImage a owl:Class ;
    rdfs:label "SatelliteImage"@en ;
    rdfs:comment "A satellite image used in the GeoOutageKG."@en ;
    rdfs:subClassOf mds:GeospatialRaster,
        goo:CountyScopedEntity,
        goo:SpectralBandScopedEntity ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:SatelliteOrbit a owl:Class ;
    rdfs:label "SatelliteOrbit"@en ;
    rdfs:comment "An orbital configuration or orbit classification associated with a satellite."@en ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:Sensor a owl:Class ;
    rdfs:label "SatelliteSensor"@en ;
    rdfs:comment "A sensor aboard a satellite used for collecting geospatial data."@en ;
    rdfs:subClassOf mds:Sensor,
        goo:SpectralBandScopedEntity ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:SpatialReferenceSystem a owl:Class ;
    rdfs:label "SpatialReferenceSystem"@en ;
    rdfs:comment "A coordinate reference system, projection, or grid used by a geospatial raster."@en ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:SpectralBand a owl:Class ;
    rdfs:label "SpectralBand"@en ;
    rdfs:comment "A specific spectral band of a satellite sensor, characterized by its wavelength and type."@en ;
    rdfs:subClassOf mds:Band ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:SpectralBandScopedEntity a owl:Class ;
    rdfs:label "Spectralband-scopedentity"@en ;
    rdfs:comment "An entity associated with one or more spectral bands, such as a satellite image or sensor."@en ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:State a owl:Class ;
    rdfs:label "U.S.State"@en ;
    rdfs:comment "A U.S. state, territory, or the District of Columbia with geospatial coordinate metadata and links to external resources such as DBpedia and Wikidata."@en ;
    rdfs:subClassOf geosparql:Feature,
        geosparql:SpatialThing,
        mds:GeospatialFeature,
        goo:AdministrativeAreaScopedEntity ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:StormEpisodeRecord a owl:Class ;
    rdfs:label "StormEpisodeRecord"@en ;
    rdfs:comment "A larger overarching weather episode that may contain multiple individual storm events."@en ;
    rdfs:subClassOf goo:TabularData ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:StormEventRecord a owl:Class ;
    rdfs:label "StormEventRecord"@en ;
    rdfs:comment "A storm event that from the NOAA Storm Events Database."@en ;
    rdfs:subClassOf goo:TabularData ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:SVIRecord a owl:Class ;
    rdfs:label "SVIRecord"@en ;
    rdfs:comment "A record from the CDC Social Vulnerability Index dataset for a specific county and year."@en ;
    rdfs:subClassOf goo:CountyScopedEntity,
        goo:TabularData ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:TabularData a owl:Class ;
    rdfs:label "TabularData"@en ;
    rdfs:comment "A tabular dataset, such as numerical outage records or storm event records."@en ;
    rdfs:subClassOf mds:Dataset ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:TerraImage a owl:Class ;
    rdfs:label "TerraImage"@en ;
    rdfs:comment "A subclass of mds:Image representing NASA Terra satellite images."@en ;
    rdfs:subClassOf goo:SatelliteImage ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:TornadoEventRecord a owl:Class ;
    rdfs:label "TornadoEventRecord"@en ;
    rdfs:comment "A specific type of storm event representing a tornado, containing specific track and intensity metadata."@en ;
    rdfs:subClassOf goo:StormEventRecord ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:WONDERRecord a owl:Class ;
    rdfs:label "CDCWONDERRecord"@en ;
    rdfs:comment "A record from the CDC WONDER database containing health indicators for a specific county and year."@en ;
    rdfs:subClassOf goo:CountyScopedEntity,
        goo:TabularData ;
    mds:inDomain mdsdom:GeoOutageOnto .

mds:2theta a owl:Class ;
    rdfs:label "2Theta"@en ;
    rdfs:subClassOf mds:DataLabel ;
    skos:definition "The angle between the projection of the x-ray source and the detector. " ;
    mds:hasStudyStage "Data" ;
    mds:inDomain mdsdom:XRD .

mds:3DPrinting a owl:Class ;
    rdfs:label "3DPrinting"@en ;
    rdfs:subClassOf cco:ont00001359 ;
    skos:altLabel "Additive Manufacturing" ;
    skos:definition "3D printing or additive manufacturing (AM) is a process with ayer-by-layer fabrication using silicone-based inks or resins"@en ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:Absorbance a owl:Class ;
    rdfs:label "Absorbance" ;
    rdfs:subClassOf mds:AnalyticalResult ;
    skos:altLabel " " ;
    skos:definition "Absorbance (A), also known as optical density (OD), is the quantity of light absorbed by a solution [Molecular Devices]" ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:FTIR,
        mdsdom:UV-Vis ;
    cco:ont00001754 "https://www.moleculardevices.com/technology/absorbance"@en .

mds:AcceleratingVoltage a owl:Class ;
    rdfs:label "AcceleratingVoltage"@en ;
    qudt:applicableUnit unit:KiloV ;
    rdfs:subClassOf mds:ImagingParameter,
        mds:ProcessingParameter ;
    skos:altLabel "",
        "Acceleration Voltage",
        "Beam Voltage" ;
    skos:definition "An imaging parameter describing the electrical potential difference used to accelerate electrons toward a sample."@en,
        "The voltage used to accelerate charged particles in an electron beam or ion beam processing system."@en ;
    mds:hasStudyStage "Process",
        "Tool" ;
    mds:inDomain mdsdom:EDS,
        mdsdom:MaterialsProcessing,
        mdsdom:SEM .

mds:AccelerationError a owl:Class ;
    rdfs:label "AccelerationError" ;
    qudt:applicableUnit unit:MilliM-PER-SEC2 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom mds:AxisAcceleration ],
        mds:KinematicError ;
    skos:altLabel " " ;
    skos:definition "A Kinematic Error describing the offset between projected and measured acceleration along an axis." ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:AccelerationMeasurement a owl:Class ;
    rdfs:label "AccelerationMeasurement" ;
    qudt:applicableUnit unit:MilliM-PER-SEC2 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom mds:AxisAcceleration ],
        mds:KinematicMeasurement ;
    skos:altLabel " " ;
    skos:definition "A Kinematic Measurement describing the sensor-measured acceleration of the build platform along an axis." ;
    mds:hasStudyStage "Process" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:Accessory a owl:Class ;
    rdfs:label "Accessory" ;
    rdfs:subClassOf cco:ont00000581 ;
    skos:altLabel " " ;
    skos:definition "An accessory is an additional component or device such as crystal, gas cell, or sample holder, that enhances or modifies the functionality of the instrument." ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:FTIR,
        mdsdom:UV-Vis .

mds:AccumulativeUVADose a owl:Class ;
    rdfs:label "AccumulativeUVADose" ;
    rdfs:subClassOf mds:AnalyticalResult ;
    skos:altLabel "TotalUVADose" ;
    skos:definition "Accumulative UVA dose a sample was exposed to under accelerated exposure conditions." ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:Accelerated .

mds:AcquisitionDate a owl:Class ;
    rdfs:label "AcquisitionDate" ;
    rdfs:subClassOf cco:ont00000529 ;
    skos:altLabel "CaptureDate",
        "DataCollectionDate",
        "ObservationDate" ;
    skos:definition "Datetime when the vector data was collected." ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Vector .

mds:AcquisitionTime a owl:Class ;
    rdfs:label "AcquisitionTime"@en ;
    rdfs:subClassOf mds:ImagingParameter ;
    skos:altLabel "" ;
    skos:definition "The total duration over which EDS data are collected."@en ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:EDS .

mds:ActOfCharacterizing a owl:Class ;
    rdfs:label "ActOfCharacterizing"@en ;
    rdfs:subClassOf cco:ont00000345 ;
    skos:altLabel "Assaying",
        "Characterization",
        "Assaying"@en ;
    skos:closeMatch bfo:OBI_0000070 ;
    skos:definition "Characterization in materials science is the broad and general process by which a material's structure and properties are probed and measured."@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions ;
    cco:ont00001754 "https://en.wikipedia.org/wiki/Characterization_(materials_science)"@en .

mds:ActOfCircuitBoardRework a owl:Class ;
    rdfs:label "ActOfCircuitBoardRework" ;
    rdfs:subClassOf cco:ont00000228 ;
    skos:altLabel "Act Of Printed Circuit Board Rework, PCB Rework" ;
    skos:definition "An Planned Act wherein an Agent uses some combination of Artifacts to add or remove Electronic Components from a Printed Circuit Board." ;
    mds:inDomain mdsdom:Electrical .

mds:ActOfCommercialDistribution a owl:Class ;
    rdfs:label "ActofCommercialDistribution" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001833 ;
            owl:someValuesFrom mds:Supplier ],
        cco:ont00000228 ;
    skos:altLabel "Act of Commercial Supplying" ;
    skos:definition "A Planned Act wherein a supplier engages the act of distributing goods or services as the result of a commercial transaction." ;
    mds:inDomain mdsdom:General .

mds:ActOfDeSoldering a owl:Class ;
    rdfs:label "ActOfDeSoldering" ;
    rdfs:subClassOf cco:ont00000908 ;
    skos:altLabel "DeSoldering Act" ;
    skos:definition "An Act of Artifact Processing wherein an Agent uses some array of tools to melt and remove solder from a desired Location." ;
    mds:inDomain mdsdom:General .

mds:ActOfElectronicComponentInstallation a owl:Class ;
    rdfs:label "ActOfElectronicComponentInstallation" ;
    rdfs:subClassOf mds:ActOfCircuitBoardRework ;
    skos:altLabel "Component Installation Act" ;
    skos:definition "An Act Of Circuit Board Rework wherein an Agent uses some combination of Artifacts to add Electronic Components from a Printed Circuit Board." ;
    mds:inDomain mdsdom:Electrical .

mds:ActOfElectronicComponentRemoval a owl:Class ;
    rdfs:label "ActOfElectronicComponentRemoval" ;
    rdfs:subClassOf mds:ActOfCircuitBoardRework ;
    skos:altLabel "Component Removal Act" ;
    skos:definition "An Act Of Circuit Board Rework wherein an Agent uses some combination of Artifacts to remove Electronic Components from a Printed Circuit Board." ;
    mds:inDomain mdsdom:Electrical .

mds:ActOfFluxUse a owl:Class ;
    rdfs:label "ActOfFluxUse" ;
    rdfs:subClassOf cco:ont00000228 ;
    skos:altLabel "Flux Usage Act" ;
    skos:definition "A Planned Act wherein an Agent uses some Portion of Flux to aid in a soldering process." ;
    mds:inDomain mdsdom:General .

mds:ActOfOpening a owl:Class ;
    rdfs:label "ActOfOpening" ;
    rdfs:subClassOf cco:ont00000228 ;
    skos:altLabel "Act of Unpacking" ;
    skos:definition "A Planned Act in which some agent opens a package containing another artifact." ;
    mds:inDomain mdsdom:General .

mds:ActOfSoldering a owl:Class ;
    rdfs:label "ActOfSoldering" ;
    rdfs:subClassOf cco:ont00000908 ;
    skos:altLabel "Soldering Act" ;
    skos:definition "An Act of Artifact Processing wherein an Agent uses some array of tools to melt and add solder from a desired Location." ;
    mds:inDomain mdsdom:General .

mds:AdditionFunnel a owl:Class ;
    rdfs:label "AdditionFunnel"@en ;
    rdfs:subClassOf mds:ReactionVesselAttachment,
        cco:ont00000581 ;
    skos:altLabel " " ;
    skos:definition "A glassware with a stopcock for controlled, slow reagent addition, preventing side reactions. [Wikipedia]"@en ;
    mds:hasStudyStage "Synthesis",
        "Tool" ;
    mds:inDomain mdsdom:Reactions ;
    cco:ont00001754 "https://en.wikipedia.org/wiki/Dropping_funnel"@en .

mds:AdditionSpeed a owl:Class ;
    rdfs:label "AdditionSpeed"@en ;
    rdfs:subClassOf cco:ont00000830 ;
    skos:altLabel " " ;
    skos:definition "An addition speed is the speed at which a component is added into a reaction mixture during InputAddition process."@en ;
    mds:hasStudyStage "Recipe",
        "Synthesis" ;
    mds:inDomain mdsdom:Reactions .

mds:AdditionTemperature a owl:Class ;
    rdfs:label "AdditionTemperature"@en ;
    rdfs:subClassOf cco:ont00000441 ;
    skos:altLabel "" ;
    skos:definition "Aheat addition temperature in thermodynamics, temperature adjustments in medicine, or reaction temperatures in chemistry."@en ;
    mds:hasStudyStage "Recipe",
        "Synthesis" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:Reactions .

mds:AdditionTime a owl:Class ;
    rdfs:label "AdditionTime"@en ;
    rdfs:subClassOf bfo:BFO_0000035 ;
    skos:altLabel "" ;
    skos:definition "An addition time is a process boundary that a component is added into the reaction mixture with respect to the total reaction time of a chemical reaction."@en ;
    mds:hasStudyStage "Recipe",
        "Synthesis" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:Reactions .

mds:Additive a owl:Class ;
    rdfs:label "Additive"@en ;
    rdfs:comment "This term is reused from Allotrope Foundation Material Ontology"@en ;
    skos:altLabel "" ;
    skos:definition "An additive function that is realized in a material used to add to a mixture. Its function is specialized property enhancement"@en ;
    skos:exactMatch afm:AFM_0000059 ;
    mds:hasStudyStage "Formulation",
        "Sample" ;
    mds:inDomain mdsdom:Formulation .

mds:AdhesionPromoter a owl:Class ;
    rdfs:label "AdhesionPromoter"@en ;
    rdfs:subClassOf cco:ont00000323 ;
    skos:altLabel "" ;
    skos:definition "A adhesion promoter function that is realized in a compound used for bonding formulations to substrates"@en ;
    mds:hasStudyStage "Formulation",
        "Sample" ;
    mds:inDomain mdsdom:Formulation .

mds:Adhesive a owl:Class ;
    rdfs:label "Adhesive" ;
    rdfs:subClassOf cco:ont00000995 ;
    skos:altLabel " " ;
    skos:definition "Any non-metallic substance applied to one or both surfaces of two separate items that binds them together and resists their separation" ;
    mds:hasStudyStage "Formulation" ;
    mds:inDomain mdsdom:General .

mds:AeroTiltX a owl:Class ;
    rdfs:label "AeroTiltX" ;
    rdfs:subClassOf bfo:BFO_0000019 ;
    skos:definition "Aero Stage X-Axis Tilt" ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:XRD .

mds:AeroTiltXOffset a owl:Class ;
