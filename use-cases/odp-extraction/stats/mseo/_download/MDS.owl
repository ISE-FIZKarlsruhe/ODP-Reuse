    rdfs:subClassOf mds:AnalyticalResult,
        mds:PhysicalProperty,
        cco:ont00000441 ;
    skos:altLabel "",
        "Glass-liquid transition",
        "Glass-liquid transition temperature" ;
    skos:definition "Represents the glass transition temperature of a material",
        "The temperature at which the viscosity of the glass is.(IUPAC)",
        "Temperature at which an amorphous material transitions from a hard, glassy state to a soft, rubbery state"@en ;
    skos:scopeNote "This property is a measured result for a cured polymer"@en ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:EnerMat,
