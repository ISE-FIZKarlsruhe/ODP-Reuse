    skos:altLabel " " ;
    skos:definition "A horizontal bar that spreads and smooths liquid polymer in vat photopolymerization or powder for powder bed fusion and binder jet processes to create a uniform and flat layer before the build material is solidified, sintered, melted, or bonded."@en ;
    skos:exactMatch lpbfo:LPBFO_00022 ;
