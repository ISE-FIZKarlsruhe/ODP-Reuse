    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:SEM .

mds:RDKitDensity a owl:Class ;
    rdfs:label "RDKitDensity"@en ;
    rdfs:subClassOf cco:ont00000009 ;
