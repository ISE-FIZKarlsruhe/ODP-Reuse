mds:DateMade a owl:Class ;
    rdfs:label "DateMade" ;
    rdfs:subClassOf cco:ont00000529 ;
    skos:altLabel "Acquisition Date",
        "Capture Date",
        "DataCollection Date",
        "Observation Date" ;
    skos:definition "Datetime when the data was received or acquired." ;
    mds:hasStudyStage "General" ;
    mds:inDomain mdsdom:General .

mds:DatetimeRegion a owl:Class ;
    rdfs:label "DatetimeRegion" ;
    rdfs:subClassOf mds:TemporalRegion ;
    skos:definition "ISO 8601 Standard for time intervals:  using Year-Month-Day Hour:Minute." ;
    cco:ont00001767 mds:USGS .

mds:DeadTime a owl:Class ;
    rdfs:label "DeadTime"@en ;
    rdfs:subClassOf mds:ImagingParameter ;
    skos:altLabel "" ;
    skos:definition "The period during which an EDS detector is unable to record additional X-ray events following a detection event."@en ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:EDS .

mds:DecimalLatitudeValue a owl:Class ;
    rdfs:label "DecimalLatitudeValue" ;
    rdfs:subClassOf cco:ont00000958 ;
    skos:definition "An Information Content Entity used to designate a decimal latitude value." ;
    cco:ont00001766 mds:USGS .

mds:DecimalLongitudeValue a owl:Class ;
    rdfs:label "DecimalLongitudeValue" ;
    rdfs:subClassOf cco:ont00000958 ;
    skos:definition "An Information Content Entity used to designate a decimal longitude value." ;
    cco:ont00001764 mds:USGS .

mds:DecompositionTemperature a owl:Class ;
    rdfs:label "Thermaldecomposition" ;
    rdfs:subClassOf cco:ont00000441 ;
    skos:altLabel "Thermal Decomposition ",
        "Thermolysis" ;
    skos:definition "The decomposition temperature of a substance is the temperature at which the substance chemically decomposes.",
        "The substrate temperature during a deposition process."@en ;
    skos:exactMatch mds:DepositionTemperature ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:EnerMat .

mds:DeepFeatureLearning a owl:Class ;
    rdfs:label "DeepFeatureLearning" ;
    rdfs:subClassOf mds:FeatureExtraction ;
    skos:altLabel "DNNs",
        "Deep Feature Learning",
        "Deep Neural Networks",
        "Neural Network Feature Extraction"@en ;
    skos:definition "A feature extraction process that uses a deep neural network to learn hierarchical feature representations from input data."@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:UQ .

mds:DeepKernelLearning a owl:Class ;
    rdfs:label "DeepKernelLearning"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom mds:DeepFeatureLearning ;
            owl:onProperty mds:usesFeatureExtraction ],
        [ a owl:Restriction ;
            owl:allValuesFrom mds:GaussianProcessRegression ;
            owl:onProperty mds:usesRegressionMethod ],
        mds:KernelUsingUQAnalysisProcess ;
    skos:altLabel "DKL"@en ;
    skos:definition "An analysis process that combines deep feature learning with Gaussian process regression to perform probabilistic prediction from learned feature representations."@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:UQ .

mds:Defect a owl:Class ;
    rdfs:label "Defect" ;
    rdfs:comment "(Elucidation) A Defect is conceptualized to be some region (or a discontinuous aggregate of regions) in a material in direct contact with a crystal, that contains or lacks material entities in a way that disrupts the repeating patterns of a perfect crystal." ;
    rdfs:subClassOf bfo:BFO_0000004 ;
    skos:altLabel " " ;
    skos:definition "An Immaterial Entity that disrupts the continuity of unit cell repetition in a solid substance." ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:DefectDensity a owl:Class ;
    rdfs:label "DefectDensity" ;
    rdfs:subClassOf mds:StructuralQuality ;
    skos:altLabel " " ;
    skos:definition " " ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder .

