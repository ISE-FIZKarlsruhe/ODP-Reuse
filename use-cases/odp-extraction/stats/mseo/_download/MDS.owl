mds:DSpacing020Plane a owl:Class ;
    rdfs:label "DSpacing020plane"@en ;
    rdfs:subClassOf mds:DSpacing ;
    skos:altLabel mds:d020 ;
    skos:definition "The distance or separation between successive and identical parallel planes in the crystal lattice of atoms with the Miller index 020. "@en ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:XRD .

mds:DSpacing110Plane a owl:Class ;
    rdfs:label "DSpacing110plane"@en ;
    rdfs:subClassOf mds:DSpacing ;
    skos:altLabel mds:d110 ;
    skos:definition "The distance or separation between successive and identical parallel planes in the crystal lattice of atoms with the Miller index 110. "@en ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:XRD .

mds:DSpacing200Plane a owl:Class ;
    rdfs:label "DSpacing200plane"@en ;
    rdfs:subClassOf mds:DSpacing ;
    skos:altLabel mds:d200 ;
    skos:definition "The distance or separation between successive and identical parallel planes in the crystal lattice of atoms with the Miller index 200. "@en ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:XRD .

mds:Durometer a owl:Class ;
