    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "Spatially resolved laser beam characterization in plane."@en ;
    skos:exactMatch lpbfo:LPBFO_00741 ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:LPBF .

mds:LaserMode a owl:Class ;
    rdfs:label "LaserMode"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:subClassOf bfo:BFO_0000019 ;
    skos:altLabel " " ;
    skos:definition "Laser mode used for AM wehere the distribution of the phase position of the waves perpendicular to the direction of propagation is called transverse modes. E.g. With a cylindrical cross-section of the laser, the beam intensity ideally has a Gaussian profile; this mode is known as TEM00 mode."@en ;
    skos:exactMatch lpbfo:LPBFO_00024 ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:LPBF .

mds:LaserOpeningProcess a owl:Class ;
    rdfs:label "LaserOpeningProcess"@en ;
    rdfs:subClassOf cco:ArtifactDesign ;
    skos:altLabel "Laser Ablation Opening Process"@en,
        "Laser Contact Opening"@en ;
    skos:definition "A materials-processing operation in which laser energy selectively removes or modifies a surface layer to create an opening in a photovoltaic cell."@en ;
    mds:hasStudyStage "Materials Processing",
        "Synthesis" ;
    mds:inDomain mdsdom:PV-Cell .

mds:LaserPowderBedFusion a owl:Class ;
    rdfs:label "LaserPowderBedFusion"@en ;
    dcmi:source "ASTM F2792-12a",
        "ISO/ASTM 52900:2021" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:LaserPowerParameter ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:ScanSpeed ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:LayerThickness ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:HatchSpacing ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:TrackOverlap ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:Wavelength ],
        mds:MaterialsProcessing ;
    skos:altLabel "DMLS",
        "Direct Metal Laser Sintering",
        "L-PBF",
        "LPBF",
        "SLM",
        "Selective Laser Melting" ;
    skos:definition "An additive manufacturing process in which thermal energy selectively fuses regions of a powder bed using a laser beam. The process builds parts layer by layer from metal or polymer powders."@en ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:LPBF .

mds:LaserPower a owl:Class ;
    rdfs:label "LaserPower"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO"@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "Chosen power of the laser used for the additive manufacturing process."@en ;
    skos:exactMatch lpbfo:LPBFO_00502 ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:LPBF .

mds:LaserPowerParameter a owl:Class ;
    rdfs:label "LaserPower"@en ;
    qudt:applicableUnit unit:W ;
    rdfs:subClassOf mds:ProcessingParameter ;
    skos:altLabel "Beam Power",
        "Laser Output Power" ;
    skos:definition "The optical power of the laser beam used in a laser-based materials processing operation."@en ;
    mds:hasStudyStage "Process" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:LaserPulseTemporalProfile a owl:Class ;
    rdfs:label "LaserPulseTemporalProfile"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "Time-resolved profile of the laser power output for a pulsed laser system."@en ;
    skos:exactMatch lpbfo:LPBFO_00723 ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:LPBF .

mds:LaserScanSpeedParameter a owl:Class ;
    rdfs:label "LaserSpeed"@en ;
    rdfs:subClassOf mds:ProcessingParameter ;
    skos:altLabel "Laser Scan Speed"@en ;
    skos:definition "The velocity of the laser beam used in a laser-based materials processing operation."@en ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:LaserSpeed a owl:Class ;
    rdfs:label "LaserSpeed"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO"@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "Chosen laser velocity used for the additive manufacturing process."@en ;
    skos:exactMatch lpbfo:LPBFO_00503 ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:LPBF .

mds:LaserSpotSize a owl:Class ;
    rdfs:label "LaserSpotSize"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "Diameter of the laser beam used for additive manufacturing."@en ;
    skos:exactMatch lpbfo:LPBFO_00506 ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:LPBF .

mds:LaserType a owl:Class ;
    rdfs:label "LaserType"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:subClassOf bfo:BFO_0000019 ;
    skos:altLabel " " ;
    skos:definition "Type of the laser unit used for AM, e.g. CW- or pulse Laser."@en ;
    skos:exactMatch lpbfo:LPBFO_00027 ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:LPBF .

mds:LaserUnit a owl:Class ;
    rdfs:label "LaserUnit"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "The engineering object as part of the AMSystem that produces the energy to melt the powder in the AM process."@en ;
    skos:exactMatch lpbfo:LPBFO_00021 ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:LPBF .

mds:Latitude a owl:Class ;
    rdfs:label "Latitude" ;
    rdfs:subClassOf mds:SiteParameter ;
    skos:altLabel "Lat" ;
    skos:definition "North/south position of a point on the Earth, decimal format." ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:PV-Site .

mds:LatticeParameter a owl:Class ;
    rdfs:label "LatticeParameter" ;
    rdfs:subClassOf mds:StructuralQuality ;
    skos:altLabel " " ;
    skos:definition "The unit cell dimension(s) of a crystalline material, determined from XRD data and used to describe the size and geometry of its crystal lattice."@en ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:XRD .

mds:LaunchDate a owl:Class ;
    rdfs:label "LaunchDate" ;
    rdfs:subClassOf cco:ont00000529 ;
    skos:altLabel "LaunchDay",
        "SatelliteLaunchDate" ;
    skos:definition "A single channel or range of the electromagnetic spectrum recorded by the sensor." ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Satellite .

mds:LaunchSite a owl:Class ;
    rdfs:label "LaunchSite" ;
