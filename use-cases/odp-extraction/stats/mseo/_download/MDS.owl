mds:CyclicQUV a owl:Class ;
    rdfs:label "CyclicQUV" ;
    rdfs:comment " Conditions in this study: Cyclic Exposure of 8 h of UVA light at 1.55 W/m 2 at 340 nm, 70 °C and 4 h of condensing humidity at50 °C in dark" ;
    rdfs:seeAlso "https://doi.org/10.1007/s40192-023-00322-6" ;
    rdfs:subClassOf mds:ExposureStress ;
    mds:hasStudyStage "Exposure" .

mds:CzochralskiMethod a owl:Class ;
    rdfs:label "CzochralskiMethod"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:PullRate ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:RotationSpeed ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:GrowthTime ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:SolventFlux ],
        mds:MaterialsProcessing ;
    skos:altLabel "CZ Method",
        "Crystal Pulling",
        "Czochralski Process" ;
    skos:definition "A method of crystal growth used to obtain single crystals by slowly pulling a seed crystal from a melt while rotating it."@en ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:D10 a owl:Class ;
    rdfs:label "D10"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "The portion of particles with diameters smaller than this value is 10%."@en ;
    skos:exactMatch lpbfo:LPBFO_00065 ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:LPBF .

mds:D50 a owl:Class ;
    rdfs:label "D50"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "The portions of particles with diameters smaller and larger than this value are 50%. Also known as the median diameter."@en ;
    skos:exactMatch lpbfo:LPBFO_00066 ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:LPBF .

mds:D90 a owl:Class ;
    rdfs:label "D90"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "The portion of particles with diameters below this value is 90%."@en ;
    skos:exactMatch lpbfo:LPBFO_00067 ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:LPBF .

mds:DarkCorrection a owl:Class ;
    rdfs:label "DarkCorrection" ;
    rdfs:subClassOf cco:ont00001158 ;
    skos:altLabel " " ;
    skos:definition "A calibration procedure where an offset map is subtracted from X-ray exposures." ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:XRD .

mds:DataFile a owl:Class ;
    rdfs:label "DataFile"@en ;
    rdfs:seeAlso dcat:distribution,
        mds:FileURI ;
    rdfs:subClassOf cco:ont00000958 ;
    skos:altLabel " " ;
    skos:closeMatch goo:TabularData ;
    skos:definition "A single file (e.g., a CSV or Parquet time-series file) produced by a project about a PV site, organized into time-stamped data rows."@en ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:PV-Site .

mds:DataLabel a owl:Class ;
    rdfs:label "DataLabel"@en ;
    rdfs:subClassOf cco:ont00000253 ;
    skos:definition "An additional label for the data to denote an important discrepancy/information" ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:EnerMat .

mds:DataProcessing a owl:Class ;
    rdfs:label "DataProcessing" ;
    rdfs:subClassOf bfo:BFO_0000015 ;
    skos:definition "Manipulation, transformation and analyis of Information and data" .

mds:DataRow a owl:Class ;
    rdfs:label "DataRow"@en ;
    rdfs:subClassOf cco:ont00000958 ;
    skos:altLabel " " ;
    skos:definition "A single row (record) of a data file, carrying a timestamp and a recorded channel value."@en ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:PV-Site .

mds:Dataset a owl:Class ;
    rdfs:label "Dataset"@en ;
    rdfs:subClassOf cco:ont00000958 ;
    skos:altLabel " " ;
    skos:definition "A dataset is a collection of data. In the Open Reaction Database, a dataset is an information content entity that is a collection of reactions from the database."@en ;
    mds:hasStudyStage "Analysis",
        "Modeling",
        "Result" ;
    mds:inDomain mdsdom:Reactions .

mds:DateEntered a owl:Class ;
    rdfs:label "DateEntered" ;
    rdfs:subClassOf mds:Date ;
    skos:altLabel "Date Entered",
        "Entry Date",
        "Received Date" ;
    skos:definition "The date the material was first added to the inventory system or received by the laboratory" ;
    mds:hasStudyStage "Formulation",
        "Materials Processing",
        "Sample" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:Reactions .

mds:DateIdentifier a owl:Class ;
    rdfs:label "DateIdentifier" ;
    rdfs:subClassOf bfo:BFO_0000008 ;
    skos:altLabel "Date" ;
    skos:definition "A Temporal Interval Identifier that designates some Day."@en ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:DateImaged a owl:Class ;
    rdfs:label "DateImaged" ;
    rdfs:subClassOf cco:ont00000529 ;
