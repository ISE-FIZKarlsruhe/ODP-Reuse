    rdfs:label "LPBFTrackCompleteness"@en ;
    rdfs:subClassOf cco:ont00000293 ;
    skos:altLabel "LPBF Track Completeness Label"@en ;
    skos:definition "A binary nominal classification indicating whether an LPBF track satisfies the dimensional criterion used to classify the track as complete."@en ;
    skos:scopeNote "A value of true or 1 indicates that the track is classified as complete. A value of false or 0 indicates that the track is classified as incomplete."@en ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:LPBF .

mds:LPBFTrackID a owl:Class ;
    rdfs:label "LPBFTrackID"@en ;
    rdfs:subClassOf cco:ont00000649 ;
    skos:altLabel " " ;
    skos:definition "A sample identifier that uniquely designates an individual track produced during a laser powder bed fusion experiment within a specified dataset or build plate."@en ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:LPBF .

mds:MachineCoordinateSystem a owl:Class ;
    rdfs:label "MachineCoordinateSystem" ;
    rdfs:subClassOf cco:ont00000275 ;
    skos:altLabel " " ;
    skos:definition "A Spatial Reference System defined by a fixed point on the build platform." ;
    mds:hasStudyStage "General" ;
    mds:inDomain mdsdom:General .

mds:MachineDesignParameter a owl:Class ;
    rdfs:label "MachineDesignParameter"@en ;
    bfo:IAO_0000112 "main flow direction and flow rate of the shielding gas"@en,
        "velocity of the recoater"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "Design parameters of the additive machine that influence the manufacturing process and are set by default and cannot be changed by the operator. Examples are as the direction and velocity of the recoater, the main flow direction and the flow rate of the shielding gas, or the type of preheating system etc."@en ;
    skos:exactMatch lpbfo:LPBFO_00705 ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:LPBF .

mds:MachineInstructionCode a owl:Class ;
    rdfs:label "MachineInstructionCode" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001803 ;
            owl:someValuesFrom cco:ont00001359 ],
        cco:ont00000965 ;
    skos:altLabel " " ;
    skos:definition "A Directive Information Content Entity that consists of a sequence of coded instructions directing the operations of a manufacturing machine." ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:MachineLearningDataType a owl:Class ;
    rdfs:label "MachineLearningDataType"@en ;
    rdfs:subClassOf mds:Dataset ;
    skos:definition "Specific data grouping for a machine learning data split. Specified as training (train), validating (val,valid), or testing (test)" ;
    mds:hasStudyStage "Sample" .

mds:MachineThreshold a owl:Class ;
    rdfs:label "MachineThreshold"@en ;
    rdfs:subClassOf cco:ont00000908 ;
    skos:definition "Threshold of machine for measurements" ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:EnerMat .

mds:MagneticPlate a owl:Class ;
    rdfs:label "MagneticPlate" ;
    rdfs:subClassOf mds:SamplePositionHolder ;
    skos:altLabel "Magnetic Chuck" ;
    skos:definition "Magnetic plate holding specimen during grinding." ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:MagneticProperty a owl:Class ;
    rdfs:label "MagneticProperty" ;
    rdfs:subClassOf mds:MaterialProperty ;
    skos:altLabel " " ;
    skos:definition "A Material Property which measures the relation between the strength of the response of a material to the strength of an applied (external) magnetic field." ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:MagnetronSputtering a owl:Class ;
    rdfs:label "MagnetronSputtering"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:SputterPower ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:SputterPressure ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:VacuumLevel ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:FilmThickness ],
        mds:MaterialsProcessing ;
    skos:altLabel "DC Sputtering",
        "RF Sputtering",
        "Sputter Deposition" ;
    skos:definition "A physical vapor deposition method where atoms are ejected from a target material by ion bombardment and deposited onto a substrate to form a thin film."@en ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:Magnification a owl:Class ;
    rdfs:label "Magnification",
        "Magnification"@en ;
    rdfs:subClassOf bfo:BFO_0000001,
        mds:ImagingParameter ;
    skos:altLabel "",
        " " ;
    skos:broader mds:Recipe ;
    skos:definition " ",
        "An imaging parameter describing the apparent enlargement of an imaged region relative to its actual size."@en ;
    mds:hasStudyStage "Recipe",
        "Tool" ;
    mds:inDomain mdsdom:EDS,
        mdsdom:Pyrometry,
        mdsdom:SEM .

mds:MaiaClass a owl:Class ;
    rdfs:label "MaiaClass" ;
    rdfs:subClassOf mds:MaiaDetector ;
    skos:altLabel " " ;
    skos:definition "Maia X-ray detector." ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:XRD .

mds:MaiaDetector a owl:Class ;
    rdfs:label "MaiaDetector" ;
    rdfs:subClassOf mds:XrayDetector ;
    skos:altLabel " " ;
    skos:definition "X-ray detectors manufactured by Maia." ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:XRD .

mds:Manufacturer a owl:Class ;
    rdfs:label "Manufacturer" ;
    rdfs:subClassOf bfo:BFO_0000001,
        cco:ont00001180 ;
    skos:altLabel " " ;
    skos:definition "An Organization  responsible for the creation or production of Material Entities or Equipment.",
        "A manufacturer is an organization that makes goods or products for sale."@en ;
    skos:exactMatch mds:Manufacturer ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:Masking a owl:Class ;
    rdfs:label "Masking" ;
    rdfs:subClassOf cco:ont00000908 ;
    skos:altLabel " " ;
    skos:broader mds:Sample ;
    skos:definition "Value describing the masking of an interdigitated comb" ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:Interdig .

mds:MassSpectrometryMeasurement a owl:Class ;
    rdfs:label "MassSpectrometryMeasurement"@en ;
    rdfs:subClassOf mds:AnalyticalResult ;
    skos:altLabel "MS Measurement"@en ;
    skos:definition "A mass spectrometry measurement representing the mass-to-charge ratio of ions resulting from a mass spec analytical technique."@en ;
    mds:hasStudyStage "Analysis" ;
    mds:inDomain mdsdom:Reactions .

mds:Material a owl:Class ;
    rdfs:label "Material"@en ;
    rdfs:subClassOf cco:ont00000995 ;
    skos:altLabel " Formulation " ;
    skos:definition "A Material that is a solid substance, and is used as a precursor or input to a manufacturing process in order to produce a finished product." ;
    mds:hasStudyStage "Formulation",
        "Sample" ;
    mds:inDomain mdsdom:General .

mds:MaterialCode a owl:Class ;
    rdfs:label "MaterialCode" ;
    rdfs:subClassOf mds:CodeIdentifier ;
    skos:altLabel "Inventory ID",
        "Material Code" ;
    skos:definition "Name to identify the material in the Live Chemical Inventory" ;
    mds:hasStudyStage "Formulation",
        "Materials Processing",
        "Sample" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:Reactions .

mds:MaterialComposition a owl:Class ;
    rdfs:label "MaterialComposition"@en ;
    rdfs:subClassOf bfo:BFO_0000019 ;
    skos:altLabel "Alloy Composition",
        "Chemical Composition" ;
    skos:definition "A quality of a material that consists in the identity and relative amounts of its constituent chemical elements or compounds."@en ;
    mds:hasStudyStage "Materials Processing",
        "Sample" ;
    mds:inDomain mdsdom:General .

mds:MaterialName a owl:Class ;
    rdfs:label "MaterialName" ;
    rdfs:subClassOf mds:Sample ;
    skos:altLabel " " ;
    skos:definition "The name of the sample" ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:FTIR,
        mdsdom:Formulation,
        mdsdom:MaterialsProcessing,
        mdsdom:Reactions,
        mdsdom:UV-Vis .

mds:MaterialProperty a owl:Class ;
    rdfs:label "MaterialProperty" ;
    rdfs:subClassOf bfo:BFO_0000019 ;
    skos:altLabel " " ;
    skos:definition "A Quality of a material that describes the relation between the strength or the change in strength of an applied field (magnetic, electric, mechanical stress, etc...) and the strength of the response to that field or to the change in that field in the material, or the extent or nature of chemical changes of a material in response to the presence of some gaseous or liquid substance." ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:General .

mds:Materials a owl:Class ;
    rdfs:label "Materials" ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "Materials involved in sample's production or that are part of the sample." ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:MaterialsProcessing a owl:Class ;
    rdfs:label "MaterialsProcessing"@en ;
    dcmi:source "ISO 9000:2015" ;
    rdfs:subClassOf cco:ActofManufacturing,
        cco:ont00000908 ;
    skos:altLabel "Fabrication Process",
        "Manufacturing Process",
        "Material Processing" ;
    skos:definition "The act of performing a series of mechanical or chemical operations on something. Ex: polymerization reacting, coating process",
        "A process that transforms, modifies, or fabricates materials through physical, chemical, thermal, or mechanical means to achieve desired properties, shapes, or structures. This includes additive manufacturing, subtractive manufacturing, forming, joining, heat treatment, surface treatment, and other material transformation processes."@en ;
    skos:exactMatch mds:MaterialsProcessing ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:MaterialSupplier a owl:Class ;
    rdfs:label "MaterialSupplier"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:isDefinedBy "ISO/ASTM 52900"@en ;
    rdfs:subClassOf bfo:BFO_0000023 ;
    skos:altLabel " " ;
    skos:definition "Suppliers of materials / base materials that are to be processed in the additive manufacturing system."@en ;
    skos:exactMatch lpbfo:LPBFO_00016 ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:LPBF .

mds:MaterialType a owl:Class ;
    rdfs:label "MaterialType" ;
    rdfs:subClassOf mds:Sample ;
    skos:altLabel " " ;
    skos:definition "The type of material used as sample" ;
    mds:hasStudyStage "Formulation" ;
    mds:inDomain mdsdom:FTIR,
        mdsdom:UV-Vis .

mds:MaxBeamSize a owl:Class ;
    rdfs:label "MaxBeamSize" ;
    rdfs:subClassOf bfo:BFO_0000019 ;
    skos:altLabel " " ;
    skos:definition "The maximum size of the incoming X-ray beam." ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:XRD .

mds:MaxFrameRate a owl:Class ;
    rdfs:label "MaxFrameRate" ;
    rdfs:subClassOf cco:ont00001047 ;
    skos:altLabel " " ;
    skos:definition "The maximum number of frames the detector can capture per second." ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:XRD .

mds:MaximumDetonationVelocity a owl:Class ;
    rdfs:label "MaximumDetonationVelocity"@en ;
    rdfs:subClassOf mds:DetonationVelocity ;
    skos:definition "Theoretical maximum detonation velocity of a compound" ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:EnerMat .

mds:MaximumPartialAtomicCharge a owl:Class ;
    rdfs:label "MaximumPartialAtomicCharge"@en ;
    rdfs:subClassOf mds:ElectricalProperty ;
    skos:altLabel "MaxPartialAtomicCharge"@en ;
    skos:definition "Maximum positive partial electric charge found on any single atom of a system" ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:EnerMat .

mds:MaximumPowerPoint a owl:Class ;
    rdfs:label "MaximumPowerPoint" ;
    rdfs:subClassOf mds:AnalyticalResult ;
    skos:altLabel "Pmax",
        "Pmp" ;
    skos:definition "The maximum power point measured by a current voltage process." ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:Electrical,
        mdsdom:PV-Cell,
        mdsdom:PV-Module .

mds:McFaddenPseudoRSquared a owl:Class ;
    rdfs:label "McFaddenPseudoRSquared" ;
    rdfs:subClassOf mds:RSquared ;
    skos:altLabel "pseudoR2.mcfadden" ;
    mds:hasStudyStage " Modeling" ;
    mds:inDomain mdsdom:Analysis,
        mdsdom:netsem .

mds:MeanAbsoluteError a owl:Class ;
    rdfs:label "MeanAbsoluteError"@en ;
    rdfs:subClassOf cco:ont00000958 ;
    skos:altLabel "MAE" ;
    skos:definition "The mean of the absolute differences between observed and predicted values."@en ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:Analysis,
        mdsdom:UQ .

mds:MeanStandardizedLogLoss a owl:Class ;
    rdfs:label "MeanStandardizedLogLoss"@en ;
    rdfs:subClassOf cco:ont00000958 ;
    skos:altLabel "MSLL" ;
    skos:definition "The mean standardized log loss that evaluates the quality of probabilistic predictions relative to a baseline model."@en ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:Analysis,
        mdsdom:UQ .

mds:Measurement a owl:Class ;
    rdfs:label "Measurement" ;
    rdfs:subClassOf mds:AnalyticalResult ;
    skos:altLabel " " ;
    skos:definition "A measurement is an analytical result from a study about a sample and some of its properties." ;
    mds:hasStudyStage "Analysis",
        "Result" ;
    mds:inDomain mdsdom:FTIR,
        mdsdom:UV-Vis .

mds:MeasurementMethod a owl:Class ;
    rdfs:label "MeasurementMethod"@en ;
    rdfs:subClassOf mds:EnergeticProperties ;
    skos:definition "Method used to create a measurement" ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:EnerMat .

mds:MeasurementNumber a owl:Class ;
    rdfs:label "MeasurementNumber" ;
    rdfs:subClassOf mds:Number ;
    skos:altLabel "" ;
    skos:definition "" ;
    mds:hasStudyStage "Result" ;
    mds:inDomain mdsdom:General .

mds:MeasurementStep a owl:Class ;
    rdfs:label "MeasurementStep" ;
    skos:definition "A measurement step is the step at which a study object is characterized in a step-wise study protocol."@en ;
    mds:hasStudyStage "Analysis",
        "Result" .

mds:MeasuringDevice a owl:Class ;
    rdfs:label "MeasuringDevice"^^xsd:string ;
    rdfs:subClassOf cco:ont00000581 ;
    skos:altLabel " " ;
    skos:definition "A measuring device is a tool that is used to measure some quality or attributes of some entity." ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:MechanicalProperty a owl:Class ;
    rdfs:label "MechanicalProperty" ;
    rdfs:subClassOf bfo:BFO_0000019,
        mds:MaterialProperty ;
    skos:altLabel " " ;
    skos:definition " ",
        "A property that involves a relationship between stress and strain or a reaction to an applied force" ;
    skos:exactMatch mds:MechanicalProperty ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:MechanismName a owl:Class ;
    rdfs:label "MechanismName"@en ;
    rdfs:subClassOf cco:ont00000003 ;
    skos:altLabel "" ;
    skos:definition "Name of specific mechanism used to link polymers. "@en ;
    mds:hasStudyStage "Formulation" ;
    mds:inDomain mdsdom:Formulation .

mds:MechanisticVariable a owl:Class ;
    rdfs:label "MechanisticVariable" ;
    rdfs:subClassOf cco:ont00001163 ;
    skos:altLabel " " ;
    skos:definition "Intermediate varialbe that links Stressor to the Response. It represents measurable change that explains how the stressor causes the response" ;
    mds:hasStudyStage " Modeling" ;
    mds:inDomain mdsdom:Analysis,
        mdsdom:netsem .

mds:MeltingTemperature a owl:Class ;
    rdfs:label "MeltingTemperature"@en ;
    rdfs:subClassOf mds:ThermalProperty,
        cco:ont00000441 ;
    skos:definition "Temperature at which the last trace of crystallinity disappears upon heating. (IUPAC)",
        "The temperature of molten material during processing."@en ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:EnerMat .

mds:MeltTemperature a owl:Class ;
    rdfs:label "MeltTemperature"@en ;
    qudt:applicableUnit unit:DEG_C ;
    rdfs:subClassOf mds:ProcessingTemperature,
        mds:ThermalProperty,
        cco:ont00000441 ;
    skos:definition "Temperature at which the last trace of crystallinity disappears upon heating. (IUPAC)",
        "The temperature of molten material during processing."@en ;
    skos:exactMatch mds:MeltTemperature ;
    mds:hasStudyStage "Process",
        "Sample" ;
    mds:inDomain mdsdom:EnerMat,
        mdsdom:MaterialsProcessing .

mds:Metadata a owl:Class ;
    rdfs:label "Metadata"^^xsd:string ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:altLabel " " ;
    skos:definition "Descriptive information about an XRD experiment, such as instrument settings, sample details, acquisition parameters, timestamps, and measurement conditions, that accompanies the diffraction data."@en ;
    mds:hasStudyStage "Analysis",
        "Result" ;
    mds:inDomain mdsdom:XRD .

mds:MetadataFormat a owl:Class ;
    rdfs:label "MetadataFormat" ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:broader mds:AnalyticalResult ;
    skos:definition " " ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:Pyrometry .

mds:MetallicMaterial a owl:Class ;
    rdfs:label "MetallicMaterial"@en ;
    rdfs:subClassOf mds:Material ;
    owl:disjointWith mds:PolymericMaterial ;
    skos:altLabel " " ;
    skos:definition "A material in which at least one constituent element is a metal, and where the dominant mode of bonding across all bulk phases is metallic bonding." ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:General .

mds:MetalMatrixComposite a owl:Class ;
    rdfs:label "MetalMatrixComposite" ;
    rdfs:subClassOf mds:CompositeMaterial ;
    owl:disjointWith mds:PolymerMatrixComposite ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( mds:CompositeMaterial [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty mds:hasReinforcement ;
                                    owl:someValuesFrom mds:CeramicMaterial ] [ a owl:Restriction ;
                                    owl:onProperty mds:hasReinforcement ;
                                    owl:someValuesFrom mds:PolymericMaterial ] ) ] [ a owl:Restriction ;
                        owl:onProperty mds:hasMatrix ;
                        owl:someValuesFrom mds:MetallicMaterial ] ) ] ;
    skos:altLabel " " ;
    skos:definition " " ;
    mds:hasStudyStage "Formulation" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:MetalPowder a owl:Class ;
    rdfs:label "MetalPowder"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl." ;
    rdfs:subClassOf bfo:BFO_0000027 ;
    skos:altLabel " " ;
    skos:definition "Metal powder that is supplied to an AM machine as a starting material or that leaves the construction cycle as unused powder." ;
    skos:exactMatch lpbfo:LPBFO_00001 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:LPBF .

mds:MethodOfIntegration a owl:Class ;
    rdfs:label "MethodOfIntegration" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:altLabel "method" ;
    skos:definition "The computational algorithm used for integration." ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:XRD .

mds:MicroController a owl:Class ;
    rdfs:label "MicroController"@en ;
    rdfs:subClassOf cco:ont00000781 ;
    skos:altLabel "µC, uC"@en ;
    skos:definition "A Control System that controls the input and output of electrical signals, pulses or flow."@en ;
    mds:hasStudyStage "Tool"@en ;
    mds:inDomain mdsdom:Electrical .

mds:Microhardness a owl:Class ;
    rdfs:label "Microhardness" ;
    rdfs:subClassOf mds:Hardness ;
    skos:altLabel " " ;
    skos:definition " Property that reflects the micro-scale resistance of nanocomposite coatings to deformation due to applied forces" ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:Microplate a owl:Class ;
    rdfs:label "Microplate" ;
    rdfs:subClassOf mds:Accessory ;
    skos:altLabel " " ;
    skos:definition "A plate with wells used to hold samples" ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:UV-Vis .

mds:MicrowaveReactionVial a owl:Class ;
    rdfs:label "MicrowaveReactionVial" ;
    rdfs:subClassOf mds:ReactionVessel ;
    skos:altLabel " " ;
    skos:definition "A glass vial designed for safe and efficient heating. [Chemglass]" ;
    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:Reactions ;
    cco:ont00001754 "https://chemglass.com/microwave-reaction-vials-heavy-wall-type-1-class-a-borosilicate-glass-complete-packages" .

mds:MillingSpeed a owl:Class ;
    rdfs:label "MillingSpeed"@en ;
    qudt:applicableUnit unit:REV-PER-MIN ;
    rdfs:subClassOf mds:RotationSpeed ;
    skos:definition "The rotational speed of a ball mill."@en ;
    mds:hasStudyStage "Process" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:MillingTime a owl:Class ;
    rdfs:label "MillingTime"@en ;
    qudt:applicableUnit unit:HR ;
    rdfs:subClassOf mds:ProcessingParameter ;
    skos:definition "The duration of ball milling."@en ;
    mds:hasStudyStage "Process" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:Minimodule a owl:Class ;
    rdfs:label "Minimodule" ;
    rdfs:subClassOf mds:PhotovoltaicModule ;
    skos:altLabel "" ;
    skos:definition "A small-scale photovoltaic module that is used for testing and research purposes." ;
    mds:hasStudyStage "Sample",
        "Synthesis" ;
    mds:inDomain mdsdom:PV-Cell,
        mdsdom:PV-Module .

mds:MinimumPartialAtomicCharge a owl:Class ;
    rdfs:label "MinimumPartialAtomicCharge"@en ;
    rdfs:subClassOf mds:ElectricalProperty ;
    skos:altLabel "MinPartialAtomicCharge"@en ;
    skos:definition "Minimum negative partial electric charge found on any single atom of a system" ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:EnerMat .

mds:MinimumRSquared a owl:Class ;
    rdfs:label "MinimumRSquared" ;
    rdfs:subClassOf cco:ont00000958 ;
    skos:altLabel " " ;
    mds:hasStudyStage " Modeling" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:Mission a owl:Class ;
    rdfs:label "Mission" ;
    rdfs:subClassOf cco:ont00000476 ;
    skos:altLabel "Program",
        "SatelliteProgram",
        "SatelliteProject" ;
