    rdfs:comment "This is an electrical analog for cco:Temperature" ;
    rdfs:subClassOf bfo:BFO_0000019 ;
    skos:altLabel "Voltage" ;
    skos:definition "A Quality that inheres in a bearer in virtue of its electrical energy." ;
