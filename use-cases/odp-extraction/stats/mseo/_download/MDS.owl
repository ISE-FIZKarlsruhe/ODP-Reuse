mds:PolymericMaterial a owl:Class ;
    rdfs:label "PolymericMaterial" ;
    rdfs:subClassOf mds:Material ;
    skos:altLabel " " ;
    skos:definition "A material that consists of very large molecules, or macromolecules, that are constituted by many repeating subunits derived from one or more species of monomers." ;
    skos:exactMatch mds:PolymericMaterial ;
    mds:hasStudyStage "Formulation",
        "Sample" ;
    mds:inDomain mdsdom:Formulation,
        mdsdom:General,
        mdsdom:PV-Cell,
        mdsdom:PV-Module .

mds:Polymerization a owl:Class ;
    rdfs:label "Polymerization"@en ;
    rdfs:subClassOf mds:ChemicalReaction ;
    skos:altLabel "" ;
    skos:definition "A polymerization is a chemical reaction processing during which monomers (of the same type or different types) are bonded into oligomers (short chains < 10 repeating units) or polymers (long chains > 10 repeating units) and it may requires a catalyst"@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Formulation .

mds:PolymerMatrixComposite a owl:Class ;
    rdfs:label "PolymerMatrixComposite" ;
    rdfs:subClassOf mds:CompositeMaterial ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( mds:CompositeMaterial [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty mds:hasReinforcement ;
                                    owl:someValuesFrom mds:CeramicMaterial ] [ a owl:Restriction ;
                                    owl:onProperty mds:hasReinforcement ;
                                    owl:someValuesFrom mds:MetallicMaterial ] ) ] [ a owl:Restriction ;
                        owl:onProperty mds:hasMatrix ;
                        owl:someValuesFrom mds:PolymericMaterial ] ) ] ;
    skos:altLabel " " ;
    skos:definition " " ;
    mds:hasStudyStage "Formulation" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:PolymerName a owl:Class ;
    rdfs:label "PolymerName"@en ;
    rdfs:subClassOf mds:MaterialName ;
    skos:altLabel "PolymerName"@en ;
