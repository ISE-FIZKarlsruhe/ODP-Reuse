    skos:altLabel " " ;
    skos:definition "Flame dry is a process where a piece of vessel is dried (remove residual moisture or solvent) using a flame. This is commonly done in reactions where presence of moisture in the vessel during the reaction will negatively impact the outcome (i.e. lower yield, degradation of reagents, etc.)."@en ;
    mds:hasStudyStage "Synthesis" ;
    mds:inDomain mdsdom:Reactions .

mds:FlameFusion a owl:Class ;
    rdfs:label "FlameFusion"@en ;
    rdfs:subClassOf mds:MaterialsProcessing ;
    skos:altLabel "Flame Synthesis",
        "Verneuil Process" ;
    skos:definition "A method for growing single crystals by melting powdered material in an oxy-hydrogen flame and allowing it to crystallize as it cools."@en ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:FlameResistance a owl:Class ;
    rdfs:label "FlameResistance"@en ;
    rdfs:subClassOf mds:ChemicalProperty ;
    skos:altLabel "" ;
    skos:definition "Resistance to ignition and burning"@en ;
    skos:scopeNote "This property is a measured result for a cured polymer"@en ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:Formulation .

mds:FlashWaitTime a owl:Class ;
    rdfs:label "FlashWaitTime" ;
    rdfs:subClassOf bfo:BFO_0000202 ;
    skos:altLabel " " ;
    skos:definition "The amount of time between flash pulses." ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:Electrical .

mds:Flowability a owl:Class ;
    rdfs:label "Flowability"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO"@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "Flowability is an umbrella term describing the complex behaviour of powder when it is mobilized. Flowability is not one comprehensive property of bulk powder.  The term 'flowability' always must relate to equipment and the way in which it was tested. One example of such a test is the so-called avalanche test which allows a statistical analysis and extraction of distribution characteristics of quite a number of different parameters like avalanche angle, surface fractal, volume expansion rate and many more."@en ;
    skos:exactMatch lpbfo:LPBFO_00718 ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:LPBF .

mds:FlowDirectionOfShieldingGas a owl:Class ;
    rdfs:label "FlowDirectionOfShieldingGas"@en ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl."@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "Main flow direction of the shielding gas in relation to the platform coodinate system."@en ;
    skos:exactMatch lpbfo:LPBFO_00731 ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:LPBF .

mds:FlowOptimizationParameter a owl:Class ;
    rdfs:label "FlowOptimizationParameter" ;
    dcmi:source "EOSPRINT 2"@en ;
    rdfs:comment "Boolean. This term is reused from https://github.com/ThomasBjarsch/ODE_AM/blob/main/PBFAO.ttl"@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "PBF-LB/M Parameter prescribing a vector exposure order against the flow direction"^^xsd:string ;
    skos:exactMatch pbfa:FlowOptimizationParameter ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:LPBF .

mds:FlowProperties a owl:Class ;
    rdfs:label "FlowProperties" ;
    rdfs:subClassOf bfo:BFO_0000019 ;
    skos:definition "defines how a material moves under the force of gravity or other applied forces, covering properties like fluidity, workability, and how easily a powder flows" .

mds:FlowRate a owl:Class ;
    rdfs:label "FlowRate"@en ;
    rdfs:subClassOf bfo:BFO_0000144 ;
    skos:altLabel " " ;
    skos:definition "A flow rate is a process profile where the rate of the flowing of a fluid through a tube is measured."@en ;
    mds:hasStudyStage "Materials Processing",
        "Recipe",
        "Synthesis" ;
    mds:inDomain mdsdom:Reactions .

mds:FlowRateOfShieldingGas a owl:Class ;
