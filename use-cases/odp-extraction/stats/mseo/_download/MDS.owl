    skos:definition "An electrochemical surface preparation process in which material is selectively removed from a specimen surface using solid electrolyte media under an applied electrical potential" ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:DryIceBath a owl:Class ;
    rdfs:label "DryIceBath"@en ;
    rdfs:subClassOf cco:ont00000581 ;
    skos:altLabel " " ;
    skos:definition "A dry ice bath is a material artifact that uses dry ice (CO2) to control the temperature of a reaction mixture during a chemical reaction process."@en ;
    mds:hasStudyStage "Materials Processing",
        "Synthesis",
        "Tool" ;
    mds:inDomain mdsdom:Reactions .

mds:DryingTube a owl:Class ;
    rdfs:label "DryingTube"@en ;
    rdfs:subClassOf mds:ReactionVesselAttachment ;
    skos:altLabel " " ;
    skos:definition "A tube attached to a reaction vessel to prevent moisture from entering. [Wikipedia]"@en ;
    mds:hasStudyStage "Materials Processing",
        "Synthesis",
        "Tool" ;
    mds:inDomain mdsdom:Reactions ;
    cco:ont00001754 "https://en.wikipedia.org/wiki/Drying_tube"@en .

mds:DryWithMaterial a owl:Class ;
    rdfs:label "DryWithMaterial"@en ;
    rdfs:subClassOf cco:ont00000908 ;
