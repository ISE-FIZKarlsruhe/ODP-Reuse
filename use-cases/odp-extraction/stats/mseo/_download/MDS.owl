    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Satellite .

mds:MissionStatus a owl:Class ;
    rdfs:label "MissionStatus" ;
    rdfs:subClassOf cco:ont00000203 ;
    skos:altLabel "OperationalStatus",
        "Status" ;
    skos:definition "The current operational state of the satellite or the mission." ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Satellite .

mds:MixedPowder a owl:Class ;
    rdfs:label "MixedPowder" ;
    rdfs:comment "This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl." ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:altLabel " " ;
    skos:definition "A mixed powder is a powder that is composed of primary powder and secondary powder." ;
    skos:exactMatch lpbfo:LPBFO_00750 ;
