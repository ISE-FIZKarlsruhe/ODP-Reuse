    rdfs:range mds:Geohash ;
    skos:definition "Indicates the geohash to the west of the current geohash." ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder .

mds:hasXAxis a owl:ObjectProperty ;
    rdfs:label "hasXAxis" ;
    rdfs:domain mds:Sample ;
    rdfs:range mds:Temperature ;
    skos:definition "informs the X axis label from a plot" .

mds:hasYAxis a owl:ObjectProperty ;
    rdfs:label "hasYAxis" ;
    rdfs:domain mds:Sample ;
    rdfs:range mds:HeatFlowNormalised ;
    skos:definition "informs the Y axis label from a plot" .

mds:isAboutSite a owl:ObjectProperty ;
    rdfs:label "isaboutsite"@en ;
    rdfs:domain mds:DataFile ;
    rdfs:range mds:PVSite ;
    rdfs:subPropertyOf cco:ont00001808 ;
    skos:definition "Relates a data file to the PV site whose behavior it records."@en .

mds:isComponentOf a owl:ObjectProperty ;
    rdfs:label "isComponentOf" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( mds:MagneticPlate mds:AnodeFixture mds:CathodeMaterial ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( mds:GrindingMachine mds:ElectropolishSystem ) ] ;
    skos:definition "Relates a physical component to the equipment of which it forms a functional part." .

mds:isExposed a owl:ObjectProperty ;
    rdfs:label "isExposed" ;
    skos:definition "Type of exposure used(Hot QUV,QSUN, etc) "@en .

mds:isLocatedAt a owl:ObjectProperty ;
    rdfs:label "isLocatedAt" ;
    skos:definition "Exact position of something"@en .

mds:isProcessStepOf a owl:ObjectProperty ;
    rdfs:label "isProcessStepOf" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( mds:Grinding mds:DryElectropolishing mds:SampleCleaning mds:SampleSurfaceQualityChecks ) ] ;
    rdfs:range mds:MaterialsProcessing ;
    skos:definition "Relates a materials processing step to the broader sample processing workflow of which it is a constituent part." .

mds:isQualityCheckOf a owl:ObjectProperty ;
    rdfs:label "isQualityCheckOf" ;
    rdfs:domain mds:SampleSurfaceQualityChecks ;
    rdfs:range mds:Sample ;
    skos:definition "Relates a quality check process to the specimen being evaluated."@en .

mds:launchedFrom a owl:ObjectProperty ;
    rdfs:label "launchedFrom" ;
    rdfs:domain mds:Satellite ;
    rdfs:range mds:LaunchSite ;
    skos:definition "Specifies the site where the satellite is launched from." ;
    mds:hasStudyStage " General" .

mds:launchedOn a owl:ObjectProperty ;
    rdfs:label "launchedOn" ;
    rdfs:domain mds:Satellite ;
    rdfs:range mds:LaunchDate ;
    skos:definition "Specifies the launch date of the satellite." ;
    mds:hasStudyStage " General" .

mds:monitorAsset a owl:ObjectProperty ;
    rdfs:label "monitorasset"@en ;
    rdfs:domain mds:Channel ;
    rdfs:range mds:SystemComponent ;
    skos:altLabel "monitorsAsset"@en ;
    skos:definition "Relates a monitoring channel to the system component whose quantity it records."@en .

mds:monitorGrid a owl:ObjectProperty ;
    rdfs:label "monitorgrid"@en ;
    rdfs:domain mds:Channel ;
    rdfs:range mds:UtilityGrid ;
    skos:altLabel "monitorsGrid"@en ;
    skos:definition "Relates a monitoring channel to the utility grid whose quantity it records at the point of utility connection (e.g., import/export energy, grid phase voltages and currents)."@en .

mds:mountedOn a owl:ObjectProperty ;
    rdfs:label "mountedOn" ;
    rdfs:domain mds:Sensor ;
    rdfs:range mds:Satellite ;
    skos:definition "Indicates the satellite on which the sensor is mounted on." ;
    mds:hasStudyStage " General" .

mds:occupiesSpatialRegion a owl:ObjectProperty ;
    rdfs:label "occupiesSpatialRegion" ;
    rdfs:domain mds:GeospatialRaster,
        mds:GeospatialVector,
        mds:GeospatiotemporalData ;
    rdfs:range mds:Geohash ;
    skos:definition "Indicates the geohash spatial region occupied by the data scope." ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder,
        mdsdom:Raster,
        mdsdom:Vector .

mds:ownedByAgency a owl:ObjectProperty ;
    rdfs:label "ownedByAgency" ;
    rdfs:domain mds:Satellite,
        mds:Sensor ;
    rdfs:range mds:Agency ;
    skos:definition "Indicates the agency that owns the object.",
        "Indicates the agency that owns the satellite or sensor instrument." ;
    mds:hasStudyStage " General" .

mds:precedes a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "precedes"@en ;
    skos:definition "A general property indicating that one step occurs before another at some point in the timeline."@en .

mds:processedUsing a owl:ObjectProperty ;
    rdfs:label "processedUsing" ;
    rdfs:domain mds:GeospatialRaster,
        mds:GeospatialVector ;
    rdfs:range mds:ProcessingAlgorithm ;
    skos:definition "Specifies how the data was processed." ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Raster,
        mdsdom:Vector .

mds:producedBy a owl:ObjectProperty ;
    rdfs:label "producedBy" ;
    rdfs:domain mds:Band ;
    rdfs:range mds:Sensor ;
    skos:definition "Specifies the sensor that produced the band." ;
    mds:hasStudyStage " General" .

mds:ThermalProperty a owl:Class,
        owl:ObjectProperty ;
    rdfs:label "ThermalProperty" ;
    rdfs:domain mds:ThermalProperty ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( mds:SpecificHeat mds:HeatCapacity mds:HeatOfFormation mds:HeatofCombustion mds:BoilingTemperature mds:MeltTemperature mds:GlassTransitionTemperature mds:PhaseTransitionTemperature ) ] ;
    rdfs:subClassOf bfo:BFO_0000019,
        mds:MaterialProperty ;
    skos:altLabel " " ;
    skos:definition "A Material Property that measures the relation between the quantity of heat or quantity of heat per u nit  amount of material transferred to the material and the magnitude of the response of the constituent atoms in the material.",
        "A Material Property that measures the relation between the quantity of heat or quantity of heat per unit amount of material transferred to the material and the magnitude of the response of the constituent atoms in the material." ;
    skos:exactMatch mds:ThermalProperty ;
    mds:hasStudyStage "Sample" ;
    mds:inDomain mdsdom:EnerMat,
        mdsdom:PlaceHolder .

mds:undergoesCellFiringProcess a owl:ObjectProperty ;
    rdfs:label "undergoescellfiringprocess"@en ;
    rdfs:domain mds:PhotovoltaicCell ;
    rdfs:range mds:CellFiringProcess ;
    skos:definition "Relates a photovoltaic cell to a cell firing process in which it participates."@en ;
    mds:inDomain mdsdom:PV-Cell .

mds:undergoesCellTexturingProcess a owl:ObjectProperty ;
    rdfs:label "undergoescelltexturingprocess"@en ;
    rdfs:domain mds:PhotovoltaicCell ;
    rdfs:range mds:CellTexturingProcess ;
    skos:definition "Relates a photovoltaic cell or wafer to a cell texturing process in which it participates."@en ;
    mds:inDomain mdsdom:PV-Cell .

mds:undergoesLaserOpeningProcess a owl:ObjectProperty ;
    rdfs:label "undergoeslaseropeningprocess"@en ;
    rdfs:domain mds:PhotovoltaicCell ;
    rdfs:range mds:LaserOpeningProcess ;
    skos:definition "Relates a photovoltaic cell or photovoltaic cell layer to a laser opening process in which it participates."@en ;
    mds:inDomain mdsdom:PV-Cell .

mds:undergoesProcessing a owl:ObjectProperty ;
    rdfs:label "undergoesProcessing" ;
    rdfs:domain mds:Sample ;
    rdfs:range mds:MaterialsProcessing ;
    skos:definition "Relates a specimen to a materials processing workflow it is subjected to."@en .

mds:undergoesScreenPrintingProcess a owl:ObjectProperty ;
    rdfs:label "undergoesscreenprintingprocess"@en ;
    rdfs:domain cco:ont00000995 ;
    rdfs:range mds:ScreenPrintingProcess ;
    skos:definition "Relates a photovoltaic cell, photovoltaic component, or sample to a screen printing process in which it participates."@en ;
    mds:inDomain mdsdom:PV-Cell,
        mdsdom:PV-Module .

mds:usesEquipment a owl:ObjectProperty ;
    rdfs:label "usesEquipment" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( mds:Grinding mds:DryElectropolishing ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( mds:GrindingMachine mds:ElectropolishSystem ) ] ;
    skos:definition "Relates a materials processing step to the equipment employed to carry out that process." .

mds:usesFeatureExtraction a owl:ObjectProperty ;
    rdfs:label "usesFeatureExtraction"@en ;
    rdfs:domain mds:UQAnalysisProcess ;
    rdfs:range mds:FeatureExtraction ;
    skos:definition "Relates an analysis process to the feature extraction process it employs."@en .

mds:usesKernel a owl:ObjectProperty ;
    rdfs:label "usesKernel"@en ;
    rdfs:domain mds:Analysis ;
    rdfs:range cco:ont00000965 ;
    skos:definition "Relates an analysis process to the kernel specification it employs for covariance computation or similarity evaluation."@en .

mds:usesLicense a owl:ObjectProperty ;
    rdfs:label "usesLicense" ;
    rdfs:domain mds:GeospatialRaster ;
    rdfs:range mds:License ;
    skos:definition "Designates the license by which the data was collected." ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:Raster .

mds:usesMedia a owl:ObjectProperty ;
    rdfs:label "usesMedia" ;
    rdfs:domain mds:ElectropolishSystem ;
    rdfs:range mds:ElectrolyteBeadMedia ;
    skos:definition "Relates an equipment system to the medium it employs during operation."@en .

mds:usesRecipe a owl:ObjectProperty ;
    rdfs:label "usesRecipe" ;
    skos:definition "Recipe used for that specific measurement "@en .

mds:usesRegressionMethod a owl:ObjectProperty ;
    rdfs:label "usesRegressionMethod"@en ;
    rdfs:domain mds:UQAnalysisProcess ;
    rdfs:range mds:RegressionMethod ;
    skos:definition "Relates an uncertainty quantification analysis process to the regression method it employs."@en .

mds:usesSpatialReferenceSystem a owl:ObjectProperty ;
    rdfs:label "usesSpatialReferenceSystem" ;
    rdfs:domain mds:Geohash,
        mds:GeospatialRaster,
        mds:GeospatialVector ;
    rdfs:range mds:SpatialReferenceSystem ;
    skos:definition "Indicates the spatial reference system or coordinate reference system used by the data" ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder,
        mdsdom:Raster,
        mdsdom:Vector .

mds:usesTool a owl:ObjectProperty ;
    rdfs:label "usesTool" ;
    skos:definition "Tool (Instrument) used "@en .

cco:ont00001764 a owl:DatatypeProperty,
        owl:NamedIndividual ;
    rdfs:label "haslongitudevalue"@en ;
    rdfs:domain mds:Centroid ;
    rdfs:range xsd:decimal ;
    skos:definition "A Data Property that has as its range the longitude value from some Geospatial Location coordinates set expressed in decimal degrees."@en ;
    skos:exactMatch cco:ont00001764 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder .

cco:ont00001765 a owl:DatatypeProperty ;
    rdfs:label "hastextvalue"@en ;
    rdfs:domain cco:ont00000253 ;
    skos:definition "A data property that has as its range a string value."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

cco:ont00001766 a owl:DatatypeProperty,
        owl:NamedIndividual ;
    rdfs:label "haslatitudevalue"@en ;
    rdfs:domain mds:Centroid ;
    rdfs:range xsd:decimal ;
    skos:definition "A Data Property that has as its range the latitude value from some Geospatial Location coordinates set expressed in decimal degrees."@en ;
    skos:exactMatch cco:ont00001766 ;
    mds:hasStudyStage " General" ;
    mds:inDomain mdsdom:PlaceHolder .

cco:ont00001767 a owl:DatatypeProperty ;
    rdfs:label "hasdatetimevalue"@en ;
    rdfs:domain cco:ont00000253 ;
    rdfs:range xsd:dateTime ;
    skos:definition "A data property that has as its value a datetime value."@en ;
    skos:exactMatch cco:ont00001767 ;
    cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

goo:acquisitionDateTime a owl:DatatypeProperty ;
    rdfs:label "AcquisitionDateTime"@en ;
    rdfs:comment "The date and time when the satellite observation was acquired."@en ;
    rdfs:domain goo:SatelliteImage ;
    rdfs:range xsd:dateTime ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:allCauseMortalityRate a owl:DatatypeProperty ;
    rdfs:label "All-CauseMortalityRate"@en ;
    rdfs:comment "Age-adjusted all-cause mortality rate per 100,000 population."@en ;
    rdfs:domain goo:WONDERRecord ;
    rdfs:range xsd:decimal ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:basin a owl:DatatypeProperty ;
    rdfs:label "Basin"@en ;
    rdfs:comment "The ocean basin where the storm occurred (e.g., ATL, EPAC)."@en ;
    rdfs:domain goo:HurricaneEventRecord ;
    rdfs:range xsd:string ;
    mds:inDomain mdsdom:GeoOutageOnto .

goo:cancerMortalityRate a owl:DatatypeProperty ;
