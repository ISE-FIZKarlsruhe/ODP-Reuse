mds:hasCycle a owl:DatatypeProperty ;
    rdfs:label "hasCycle"@en ;
    mds:hasStudyStage "Formulation" ;
    mds:inDomain mdsdom:Formulation .

mds:hasDataType a owl:DatatypeProperty ;
    rdfs:label "hasdatatype"@en ;
    rdfs:domain mds:DataFile ;
    rdfs:range xsd:string ;
    skos:definition "The kind of data held by a data file, e.g., 'time series'."@en .

mds:hasDepthOfCutPerPass a owl:DatatypeProperty ;
    rdfs:label "hasDepthOfCutPerPass" ;
