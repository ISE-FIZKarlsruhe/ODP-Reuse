    rdfs:label "DetectorZPosition" ;
    rdfs:subClassOf cco:ont00000472 ;
    skos:altLabel "detz" ;
    skos:definition "The positioning of a detector along the Z-axis, typically controlling the sample-to-detector distance." ;
    mds:hasStudyStage "Recipe" ;
    mds:inDomain mdsdom:XRD .

