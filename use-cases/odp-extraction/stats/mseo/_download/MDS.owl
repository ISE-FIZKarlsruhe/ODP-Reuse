    skos:exactMatch bfo:BFO_0000199 .

bfo:BFO_0000210 a owl:ObjectProperty ;
    rdfs:label "occupiesspatialregion"@en ;
    skos:exactMatch bfo:BFO_0000210 .

bfo:RO_0000085 a owl:ObjectProperty ;
    rdfs:label "hasfunction"@en ;
    bfo:IAO_0000112 "this enzyme has function this catalysis function (more colloquially: this enzyme has this catalysis function)"@en ;
    bfo:IAO_0000115 "a relation between an independent continuant (the bearer) and a function, in which the function specifically depends on the bearer for its existence"@en ;
    bfo:IAO_0000116 "A bearer can have many functions, and its functions can exist for different periods of time, but none of its functions can exist when the bearer does not exist. A function need not be realized at all the times that the function exists."@en ;
    bfo:IAO_0000118 "has_function"@en ;
    rdfs:domain bfo:BFO_0000004 ;
    rdfs:range bfo:BFO_0000034 ;
    rdfs:subPropertyOf bfo:RO_0000053 .

bfo:RO_0000086 a owl:ObjectProperty ;
    rdfs:label "hasdisposition"@en ;
    bfo:IAO_0000112 "this apple has quality this red color"@en ;
    bfo:IAO_0000115 "a relation between an independent continuant (the bearer) and a quality, in which the quality specifically depends on the bearer for its existence"@en ;
    bfo:IAO_0000116 "A bearer can have many qualities, and its qualities can exist for different periods of time, but none of its qualities can exist when the bearer does not exist."@en ;
    bfo:IAO_0000118 "has_quality"@en ;
    rdfs:range bfo:BFO_0000019 ;
    rdfs:subPropertyOf bfo:RO_0000053 .

bfo:RO_0000087 a owl:ObjectProperty ;
    rdfs:label "hasrole"@en ;
    bfo:IAO_0000112 "this person has role this investigator role (more colloquially: this person has this role of investigator)"@en ;
    bfo:IAO_0000115 "a relation between an independent continuant (the bearer) and a role, in which the role specifically depends on the bearer for its existence"@en ;
    bfo:IAO_0000116 "A bearer can have many roles, and its roles can exist for different periods of time, but none of its roles can exist when the bearer does not exist. A role need not be realized at all the times that the role exists."@en ;
    bfo:IAO_0000118 "has_role"@en ;
    rdfs:domain bfo:BFO_0000004 ;
    rdfs:range bfo:BFO_0000023 ;
    rdfs:subPropertyOf bfo:RO_0000053 .

bfo:RO_0000091 a owl:ObjectProperty ;
    rdfs:label "hasdisposition"@en ;
    bfo:IAO_0000115 "a relation between an independent continuant (the bearer) and a disposition, in which the disposition specifically depends on the bearer for its existence"@en ;
    rdfs:domain bfo:BFO_0000004 ;
    rdfs:range bfo:BFO_0000016 ;
    rdfs:subPropertyOf bfo:RO_0000053 ;
    owl:inverseOf bfo:RO_0000092 .

cco:bearerOf a owl:ObjectProperty ;
    rdfs:label "bearerOf" .

cco:hasMember a owl:ObjectProperty ;
    rdfs:label "hasMember" .

cco:hasQuality a owl:ObjectProperty ;
    rdfs:label "hasQuality" .

