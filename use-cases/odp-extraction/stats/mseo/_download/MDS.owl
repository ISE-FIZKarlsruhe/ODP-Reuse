    mds:hasStudyStage "Tool" ;
    mds:inDomain mdsdom:Reactions ;
    cco:ont00001754 "https://www.mrclab.com/quartz-tubes#:~:text=Quarts%20tubes%20offer%20excellent%20thermal,holders%20in%20laboratory%20tube%20furnaces."@en .

mds:Quenching a owl:Class ;
    rdfs:label "Quenching"@en ;
    dcmi:source "ISO 4885:2018" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:QuenchingTemperature ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:QuenchingMedia ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:QuenchType ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:CoolingRate ],
        mds:MaterialsProcessing ;
    skos:altLabel "Quench Hardening",
        "Rapid Cooling" ;
    skos:definition "A rapid cooling process used in heat treatment where a material is cooled quickly from an elevated temperature by immersion in water, oil, or another quenching medium to achieve desired mechanical properties such as increased hardness."@en ;
    mds:hasStudyStage "Materials Processing" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:QuenchingMedia a owl:Class ;
    rdfs:label "QuenchingMedia"@en ;
    rdfs:subClassOf mds:ProcessingParameter ;
    skos:altLabel "Cooling Medium",
        "Quench Medium" ;
    skos:definition "The fluid or medium used to rapidly cool material during quenching (e.g., water, oil, air)."@en ;
    mds:hasStudyStage "Process" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:QuenchingTemperature a owl:Class ;
    rdfs:label "QuenchingTemperature"@en ;
    qudt:applicableUnit unit:DEG_C ;
    rdfs:subClassOf mds:ProcessingTemperature ;
    skos:definition "The elevated temperature from which material is rapidly cooled during quenching."@en ;
    mds:hasStudyStage "Process" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:QuenchType a owl:Class ;
    rdfs:label "QuenchType"@en ;
    rdfs:subClassOf mds:ProcessingParameter ;
    skos:altLabel "Quench",
        "Quench Technique",
        "Quenching Method" ;
    skos:definition "The method or technique used for quenching (e.g., direct quench, interrupted quench, martempering)."@en ;
    mds:hasStudyStage "Process" ;
    mds:inDomain mdsdom:MaterialsProcessing .

mds:Racking a owl:Class ;
    rdfs:label "Racking" ;
