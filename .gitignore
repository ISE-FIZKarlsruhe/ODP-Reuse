# ...but the reproducibility apparatus of Track A is published, because the paper
# claims it. Appendix B states that PROVENANCE.md "carries the same table in
# machine-readable form together with the commands that re-verify it"; that is
# false to a reader if the file is not in the clone. These two are not the
# manuscript -- they are a 140-assertion checker and its provenance index -- so
# they ship while the LaTeX stays unpublished during review.
!paper-iri/verify_numbers.py
!paper-iri/PROVENANCE.md

# =============================================================================
#  Publication scope, 2026-08-04
# =============================================================================

# --- iri+label track: not published -------------------------------------------
# The verified-union corpus differs from the released one by 11 ontologies, so
# publishing both would give Zenodo users two near-identical datasets and no way
# to tell which to cite. The whole track is therefore local-only: the second
# corpus, its manifest, its analysis outputs, and the companion manuscript and
# deck built on them. `paper-iri/verify_numbers.py` skips its B-prefixed checks
# when these files are absent, so a fresh clone still verifies cleanly.
release-iri-label/
pipeline/out_iri_label/
pipeline/out/rq_iri-label_gated/
pipeline/out/rq_iri-label_all/
pipeline/out/comparison_tracks/
paper-iri-label/
slides-iri-label/
use-cases/odp-extraction/results/iri-label/
use-cases/odp-recommendation/results_reco/iri-label*/
use-cases/odp-recommendation/stats_iri-label*/

# --- parse and embedding caches: regenerable, never results -------------------
pipeline/out/cache/
pipeline/out/cache_backup/
pipeline/out/patternstats/cache/
pipeline/out/structprobe/cache/
use-cases/odp-recommendation/recobench/.cache/
use-cases/odp-extraction/results/*/clusterstats/raw/

# --- superseded intermediates from earlier gate settings ----------------------
# Kept on disk for provenance, not published: nothing cites them and their
# numbers describe a corpus that is no longer released.
use-cases/odp-extraction/results/iri_g4-10/
use-cases/odp-extraction/results/gated-reuse/
use-cases/odp-recommendation/results/
use-cases/odp-recommendation/results_hashed/
use-cases/odp-recommendation/stats/

# --- run logs ----------------------------------------------------------------
use-cases/*/results/*.log
use-cases/*/results_reco/*.log

# --- pipeline working directories: an allowlist, not a denylist ---------------
# `pipeline/out*` is scratch. Every file in it is regenerable by re-running the
# pipeline, and whatever is worth publishing has already been promoted into
# `release-iri/`. Enumerating what to exclude had the wrong default: each new
# analysis script silently added its output, its caches and its logs to the push.
#
# So the contents are ignored wholesale and the few files that are *evidence* are
# re-included by name. The un-ignored set is therefore exactly the provenance set
# that `paper-iri/verify_numbers.py` reads, and it cannot drift unnoticed: give
# the verifier a new source without listing it here and a fresh clone fails with
# "MISSING FILE", naming the file.
#
# Not re-included, deliberately: `MANIFEST.csv` and `audit/audit_summary.csv`,
# because they are byte-identical to the `release-iri/` copies. Tracking both
# would create two copies of one truth that a partial re-run could desynchronise,
# so the verifier reads the released copies instead -- which is also the more
# faithful check, since the release is what a user actually gets.
pipeline/out/**
pipeline/out_obo/**

# The re-included set is exactly what the manuscripts cite. It is not curated by
# hand: `python pipeline/check_repo_claims.py` extracts every path the LaTeX names
# and fails if one of them would be missing from a clone. Run it after editing
# either this file or a paper.
!pipeline/out/
!pipeline/out/g4_threshold_sensitivity.csv
!pipeline/out/g4_band_1_to_9.csv
!pipeline/out/adjudication/
!pipeline/out/adjudication/human_sample.csv
!pipeline/out/adjudication/ADJUDICATION.md
!pipeline/out/adjudication/METHODS.md
!pipeline/out/g5/
!pipeline/out/g5/g5_causes.csv
!pipeline/out/structprobe/
!pipeline/out/structprobe/summary.json
!pipeline/out/rq_iri_gated/
!pipeline/out/rq_iri_gated/*.csv
!pipeline/out/rq_iri_all/
!pipeline/out/rq_iri_all/rq4_expansion.csv
!pipeline/out/comparison/
!pipeline/out/comparison/population_reconciliation.csv
!pipeline/out/repair/
!pipeline/out/repair/pattern_repair_log_complete.csv
# Only the three patternstats tables the papers cite. The other 722 files in that
# tree are 7.5 MB of intermediate detail that nothing cites and that
# `python -m patternstats` regenerates from the corpus.
!pipeline/out/patternstats/
!pipeline/out/patternstats/sh_by_library.csv
!pipeline/out/patternstats/tl_by_library.csv
!pipeline/out/patternstats/dm_reuse_crosstab.csv

# --- the hashed corpus: a Zenodo artefact, too large for git ------------------
# The IRI-anonymised twin of the corpus: several GiB of N-Triples, built by
# pipeline/hash_corpus.py and published as a Zenodo file, never through git.
release-*/corpus-hashed/

# --- Zenodo upload staging ----------------------------------------------------
# Archives built for a deposition are derived artefacts of files that are either
# already tracked or deliberately Zenodo-only. corpus.zip alone is over a
# gigabyte, and GitHub rejects a single file above 100 MiB, so an accidental
# `git add -A` while staging a release would fail the push.
release-*/*.zip
release-*/zenodo/
