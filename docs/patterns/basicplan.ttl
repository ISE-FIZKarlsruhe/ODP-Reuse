@prefix : <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl#> .
@prefix basicplandescription: <http://www.ontologydesignpatterns.org/cp/owl/basicplandescription.owl#> .
@prefix basicplanexecution: <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#> .
@prefix classification: <http://www.ontologydesignpatterns.org/cp/owl/classification.owl#> .
@prefix description: <http://www.ontologydesignpatterns.org/cp/owl/description.owl#> .
@prefix objectrole: <http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix parameter: <http://www.ontologydesignpatterns.org/cp/owl/parameter.owl#> .
@prefix participation: <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix region: <http://www.ontologydesignpatterns.org/cp/owl/region.owl#> .
@prefix situation: <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#> .
@prefix taskrole: <http://www.ontologydesignpatterns.org/cp/owl/taskrole.owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:GoalSituation a owl:Class ;
    rdfs:label "Goal situation"@en ;
    rdfs:comment "A goal situation is a situation that satisfies a goal.Opposite to the case of subplan executions, a goal situation is not part of a plan execution.In other words, it is not true in general that any situation satisfying a part of a description, is also part of the situation that satisfies the whole description. This helps to account for the following cases: a) Execution of plans containing abort or suspension conditions (the plan would be satisfied even if the goal has not been reached, see below), b) Incidental satisfaction, like when a situation satisfies a goal without being intentionally planned (but anyway desired)."^^xsd:string ;
    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl> ;
    rdfs:subClassOf situation:Situation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( situation:Situation [ a owl:Restriction ;
                        owl:onProperty :satisfies ;
                        owl:someValuesFrom basicplandescription:Goal ] ) ] .

:executesTask a owl:ObjectProperty ;
    rdfs:label "executes task"@en,
        "esegue il task"@it ;
    rdfs:comment "A relation between an action and a task, e.g. 'putting some water in a pot and putting the pot on a fire until the water starts bubbling' executes the task 'boiling'."^^xsd:string ;
    rdfs:domain basicplanexecution:Action ;
    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl> ;
    rdfs:range taskrole:Task ;
    rdfs:subPropertyOf classification:isClassifiedBy ;
    owl:inverseOf :isExecutedIn .

:isConceptualizedBy a owl:ObjectProperty ;
    rdfs:label "is conceptualized by"@en,
        "è concettualizzato da"@it ;
    rdfs:comment "A relation stating that an Agent is internally representing a Description . E.g., 'John believes in the conspiracy theory'; 'Niels Bohr created a solar-system metaphor for his atomic theory'; 'Jacques assumes all swans are white'; 'the task force shares the attack plan'." ;
    rdfs:domain basicplandescription:Plan ;
    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl> ;
    rdfs:range basicplanexecution:Agent ;
    owl:inverseOf :conceptualizes .

classification:Concept a owl:Class ;
    owl:equivalentClass description:Concept,
        parameter:Concept .

objectrole:Role a owl:Class ;
    owl:equivalentClass taskrole:Role .

rdfs:comment a owl:AnnotationProperty .

rdfs:isDefinedBy a owl:AnnotationProperty .

rdfs:label a owl:AnnotationProperty .

owl:versionInfo a owl:AnnotationProperty .

:conceptualizes a owl:ObjectProperty ;
    rdfs:label "conceptualizes"@en,
        "concettualizza"@it ;
    rdfs:comment "A relation stating that an Agent is internally representing a SocialObject . E.g., 'John believes in the conspiracy theory'; 'Niels Bohr created the solar-system metaphor for the atomic theory'; 'Jacques assumes all swans are white'; 'the task force members share the attack plan'." ;
    rdfs:domain basicplanexecution:Agent ;
    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl> ;
    rdfs:range basicplandescription:Plan .

:isParametrizedBy a owl:ObjectProperty ;
    rdfs:label "is parametrized by"@en,
        "è parametrizzato da"@it ;
    rdfs:comment "The relation between a Parameter, e.g. 'MajorAge', and a Region, e.g. '>17 year'." ;
    rdfs:domain region:Region ;
    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl> ;
    rdfs:range parameter:Parameter ;
    rdfs:subPropertyOf classification:isClassifiedBy ;
    owl:inverseOf :parametrizes .

:isSatisfiedBy a owl:ObjectProperty ;
    rdfs:label "is satisfied by"@en,
        "è soddisfatta da"@it ;
    rdfs:comment "A relation between a Situation and a Description, e.g. the execution of a Plan satisfies that plan." ;
    rdfs:domain description:Description ;
    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl> ;
    rdfs:range situation:Situation ;
    owl:inverseOf :satisfies .

basicplandescription:Goal a owl:Class .

basicplanexecution:PlanExecution a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom basicplandescription:Plan ;
            owl:onProperty :satisfies ] ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( situation:Situation [ a owl:Restriction ;
                        owl:onProperty :satisfies ;
                        owl:someValuesFrom basicplandescription:Plan ] ) ] .

objectrole:Object a owl:Class ;
    owl:equivalentClass participation:Object .

objectrole:isRoleOf a owl:ObjectProperty .

parameter:Concept a owl:Class .

participation:Object a owl:Class .

:isExecutedIn a owl:ObjectProperty ;
    rdfs:label "is executed in"@en,
        "è eseguito mediante"@it ;
    rdfs:comment "A relation between an action and a task, e.g. 'putting some water in a pot and putting the pot on a fire until the water starts bubbling' executes the task 'boiling'." ;
    rdfs:domain taskrole:Task ;
    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl> ;
    rdfs:range basicplanexecution:Action ;
    rdfs:subPropertyOf classification:classifies .

:parametrizes a owl:ObjectProperty ;
    rdfs:label "parametrizes"@en,
        "parametrizza"@it ;
    rdfs:comment """The relation between a Parameter, e.g. 'MajorAgeLimit', and a Region, e.g. '18_year'.
For a more data-oriented relation, see hasDataValue""" ;
    rdfs:domain parameter:Parameter ;
    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl> ;
    rdfs:range region:Region ;
    rdfs:subPropertyOf classification:classifies .

basicplanexecution:Agent a owl:Class ;
    owl:disjointWith description:Concept .

classification:classifies a owl:ObjectProperty .

classification:isClassifiedBy a owl:ObjectProperty .

description:Concept a owl:Class ;
    owl:disjointWith situation:Situation .

description:Description a owl:Class .

taskrole:Role a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom objectrole:Object ;
            owl:onProperty objectrole:isRoleOf ] .

taskrole:Task a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom basicplanexecution:Action ;
            owl:onProperty :isExecutedIn ] .

basicplanexecution:Action a owl:Class .

parameter:Parameter a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom region:Region ;
            owl:onProperty :parametrizes ] ;
    owl:disjointWith taskrole:Role .

region:Region a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom parameter:Parameter ;
            owl:onProperty :isParametrizedBy ] .

:satisfies a owl:ObjectProperty ;
    rdfs:label "satisfies"@en,
        "soddisfa"@it ;
    rdfs:comment "A relation between a Situation and a Description, e.g. the execution of a Plan satisfies that plan."^^xsd:string ;
    rdfs:domain situation:Situation ;
    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl> ;
    rdfs:range description:Description .

basicplandescription:Plan a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom basicplanexecution:PlanExecution ;
            owl:onProperty :isSatisfiedBy ] .

situation:Situation a owl:Class .

<http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl> a owl:Ontology ;
    rdfs:comment "The basic plans. This content ontology design patterns represents plans descriptions and their executions. It is defined by combining and expanding other CPs: basic plans description, basic plans execution, and object role. Expansion involves the partial clone of ontology elements from DOLCE Ultra Lite and Plans Lite ontologies."^^rdf:PlainLiteral ;
    owl:imports <http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl>,
        <http://www.ontologydesignpatterns.org/cp/owl/basicplandescription.owl>,
        <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl>,
        <http://www.ontologydesignpatterns.org/cp/owl/classification.owl>,
        <http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl>,
        <http://www.ontologydesignpatterns.org/cp/owl/region.owl>,
        <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
    owl:versionInfo "1.1 added rdfs:isDefinedBy for all named entities"^^xsd:string,
        "Created by Valentina Presutti"^^xsd:string .

