@prefix : <https://purl.org/andreapoltronieri/scorepart/> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix opla: <http://ontologydesignpatterns.org/opla/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

opla:reusesPatternAsTemplate a owl:AnnotationProperty .

dc:creator a owl:AnnotationProperty .

dc:description a owl:AnnotationProperty .

dc:language a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

cpannotationschema:coversRequirements a owl:AnnotationProperty ;
    rdfs:comment "This annotation property is used for exemplifying possible requirements the content pattern provides a solution for. Requirements are expressed as natural language competency questions." .

cpannotationschema:extractedFrom a owl:AnnotationProperty ;
    rdfs:comment "This annotation property should be assigned with a URI, which points to the possible reference ontology which the annotated pattern was extracted from (i.e. the reference ontology that the ontology elements have been deeply or partially cloned by). The range is not explicit in the definition of the annotation property because it would turn the ontology to OWL Full. E.g. The participation pattern is extracted from the Dolce Ultra Lite ontology, hence the value for this annotation property is http://www.ontologydesignpatterns.org/ont/dul/DUL.owl" .

cpannotationschema:hasComponent a owl:AnnotationProperty ;
    rdfs:comment "This annotation property is useful for content ontology design patterns. Its value is a URI, which refers to another content ontology design pattern which is a component of the annotated one." .

cpannotationschema:hasConsequences a owl:AnnotationProperty ;
    rdfs:comment "This annotation property is used for briefly describing the benefits and/or possible trade-offs when using the CP." .

cpannotationschema:hasIntent a owl:AnnotationProperty ;
    rdfs:comment "This annotation property is used in order to describe the intent of the content pattern." .

cpannotationschema:hasUnitTest a owl:AnnotationProperty ;
    rdfs:comment "This property can be used to annotate a unit test (e.g. in the form of a SPARQL query) to be launched to evaluate an ontology against a requirement-based task." .

cpannotationschema:isCloneOf a owl:AnnotationProperty ;
    rdfs:comment "This annotation property is used for referring a cloned ontology entity to its cloning source." .

cpannotationschema:isSpecializationOf a owl:AnnotationProperty ;
    rdfs:comment "This annotation property is useful for content ontology design patterns and its elements. Its value is a URI, which refers either to a content ontology design pattern that is specialized by the annotated one, or to an ontology element that is specialized by the annotated one." .

cpannotationschema:reengineeredFrom a owl:AnnotationProperty ;
    rdfs:comment "This annotation property should be assigned with a URI, which points to the concept schema, page, or anything else from which the annotated pattern was reengineered. If the source does not have any URI e.g., a printed book, this property value should provide information as precise as possible in order to identify the source. This property is alternative to the extractedFrom property because it is used when the pattern come from a concept schema which is not an owl ontology. For example content ontology design patterns, which are reengineered from data model patterns, rdf schemas, etc. should be annotatd with this property. E.g. The basicpersonalfoaf pattern is extracted from the rdf FOAF specification, hence the value for this annotation property is http://xmlns.com/foaf/spec/20071002.rdf" .

cpannotationschema:relatedCPs a owl:AnnotationProperty ;
    rdfs:comment "This annotation property can be used to indicate other CPs (if any) that specialize, generalize, inlcude, or are components of the CP. Furthermore, this field may indicate other CPs that are typically used in conjunction with the described one. Important similarities and differences with other patterns can be also described here." .

cpannotationschema:scenarios a owl:AnnotationProperty ;
    rdfs:comment "This annotation property is used for describing examples of instantiation of the Content OP. For example, for the part-of Content OP (which represents part-whole relations) a possible scenario is the sentence: \"the brain is part of the human body\". Scenarios are expressed as natural language sentences." .

owl:versionInfo a owl:AnnotationProperty .

: a owl:Ontology ;
    rdfs:label "Score Part Pattern"@en ;
    dc:creator "Andrea Poltronieri (University of Bologna)"^^xsd:string ;
    dc:description "The Score Part module models the structure and the hierarchies of a music score."@en ;
    dc:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dc:title "Score Part Pattern"@en ;
    dcterms:issued "2021-07-17" ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    cpannotationschema:coversRequirements "What is the instrument playing a specific score part?, How many voices does the score part have?, Which are the metrics defining the sections of the score part?"@en ;
    cpannotationschema:extractedFrom <https://purl.org/andreapoltronieri/notepattern> ;
    cpannotationschema:hasComponent <http://ontologydesignpatterns.org/wiki/Submissions:PartOf> ;
    cpannotationschema:hasIntent "This content ODP formalises the structure and the hierarchies of a music score/symbolic representation system."@en ;
    cpannotationschema:reengineeredFrom <https://purl.org/andreapoltronieri/HaMSEontology> ;
    rdfs:comment """The Score Part pattern models the structure and the hierarchies of a music score.
In this module are used as template the following Ontology Design Patterns:"""@en ;
    owl:versionInfo "Version 1.0"@en .

:hasMidiProgram a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has midi program"@en ;
    rdfs:comment "The instrument playing a specific part expressed by a MIDI program."@en ;
    rdfs:domain :Instrument ;
    rdfs:range xsd:int .

:hasClef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has clef"@en ;
    rdfs:comment "The clef that describes the hight of a note in a music score fragment."@en ;
    rdfs:domain :HomogeneousFragment ;
    rdfs:range xsd:string .

:hasMetric a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has metric"@en ;
    rdfs:comment "The metric of a specific fragment of a music score."@en ;
    rdfs:domain :HomogeneousFragment ;
    rdfs:range xsd:int .

:hasStaff a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has staff"@en ;
    rdfs:comment "The staff assigned to a specific instrument part in a music score."@en ;
    rdfs:domain :Part ;
    rdfs:range rdfs:Literal .

:hasTempo a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has tempo"@en ;
    rdfs:comment "The tempo of an homogeneous fragment, expressed in bpm (integer)."@en ;
    rdfs:domain :HomogeneousFragment ;
    rdfs:range xsd:int .

:isPlayedBy a owl:ObjectProperty ;
    rdfs:label "is played by"@en ;
    rdfs:comment "Connects the part of the score/symbolic notation to the instrument that is assigned to play such part."@en ;
    rdfs:domain :Part ;
    rdfs:range :Instrument ;
    owl:inverseOf :playsPart .

:hasFragment a owl:ObjectProperty ;
    rdfs:label "has section"@en ;
    rdfs:comment "Connects the part of the score/symbolic notation to its constituing sections."@en ;
    rdfs:domain :Part ;
    rdfs:range :HomogeneousFragment ;
    owl:inverseOf :isFragmentOf .

:hasSection a owl:ObjectProperty ;
    rdfs:label "has section"@en ;
    rdfs:domain :Part ;
    rdfs:range :Section ;
    owl:inverseOf :isSectionOf .

:hasVoice a owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has voice"@en ;
    rdfs:comment "Connects the part of the score/symbolic notation to its constituing sections."@en ;
    rdfs:domain :Part ;
    rdfs:range :Voice ;
    owl:inverseOf :isVoiceOf .

:isFragmentOf a owl:ObjectProperty ;
    rdfs:label "is section of"@en ;
    rdfs:comment "Inverse of hasFragment. Connects the section of the score/symbolic notation to the belongng part."@en ;
    rdfs:domain :HomogeneousFragment ;
    rdfs:range :Part .

:isSectionOf a owl:ObjectProperty ;
    rdfs:label "is section of"@en ;
    rdfs:domain :Section ;
    rdfs:range :Part .

:isVoiceOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "is voice of"@en ;
    rdfs:comment "Inverse of hasVoice. Connects the voice of the score/symbolic notation to the belongng part."@en ;
    rdfs:domain :Voice ;
    rdfs:range :Part .

:playsPart a owl:ObjectProperty ;
    rdfs:label "plays part"@en ;
    rdfs:comment "Inverse of isPlayedBy. Connects an instrument to the the part that the instrument plays."@en ;
    rdfs:domain :Instrument ;
    rdfs:range :Part .

:Voice a owl:Class ;
    rdfs:label "Voice"@en ;
    rdfs:comment "One of several parts that can be performed within the same staff (e.g. alto and soprano)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom :Part ;
            owl:onProperty :isVoiceOf ] ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Part [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :hasVoice ] ) ] .

:Instrument a owl:Class ;
    rdfs:label "Instrument"@en ;
    rdfs:comment "Any of various devices or contrivances that can be used to produce musical tones or sound. Any taxonomy can be used to subsume this concept. The default one is one extracted by Ivan Herman from the Musicbrainz instrument taxonomy, conforming to SKOS. This concept holds a seeAlso link towards this taxonomy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :playsPart ;
            owl:someValuesFrom :Part ] ;
    owl:disjointWith :Section,
        :Voice .

:Section a owl:Class ;
    rdfs:label "Section"@en ;
    rdfs:comment "A section as defined by the repetition signs found on the music score."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :Part ;
            owl:onProperty :isSectionOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Part [ a owl:Restriction ;
                        owl:onClass :Section ;
                        owl:onProperty :hasSection ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] .

:HomogeneousFragment a owl:Class ;
    rdfs:label "Section"@en ;
    rdfs:comment "A group of notes that share the same metric and clef."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom :Part ;
            owl:onProperty :isFragmentOf ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:int ;
            owl:onProperty :hasTempo ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:int ;
            owl:onProperty :hasMetric ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty :hasClef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    owl:disjointWith :Instrument ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Part [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :hasFragment ] ) ] .

:Part a owl:Class ;
    rdfs:label "Part"@en ;
    rdfs:comment "A part of a a score notation or a symbolic notation assigned to a specific instrument."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Voice ;
            owl:onProperty :hasVoice ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Instrument ;
            owl:onProperty :isPlayedBy ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :HomogeneousFragment ;
            owl:onProperty :hasFragment ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:int ;
            owl:onProperty :hasStaff ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Section ;
            owl:onProperty :hasSection ] .

