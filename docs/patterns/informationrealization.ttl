            owl:intersectionOf ( :G [ a owl:Restriction ;
                        owl:allValuesFrom :Flat ;
                        owl:onProperty :hasAccidental ] ) ] .

:Gsharp a owl:Class ;
    rdfs:label "G#"@en ;
    rdfs:subClassOf :SymbolicNote ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :G [ a owl:Restriction ;
                        owl:allValuesFrom :Sharp ;
                        owl:onProperty :hasAccidental ] ) ] .

:belongsToSection a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "belongs to section"@en ;
    rdfs:domain :SymbolicNote ;
    rdfs:range sp:Section ;
    owl:inverseOf :containsNoteEvent .

:belongsToVoice a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "belongs to voice"@en ;
    rdfs:domain :SymbolicNote ;
    rdfs:range sp:Voice ;
    owl:inverseOf :containsNoteEvent .

:hasDynamicAbstraction a owl:ObjectProperty ;
    rdfs:label "is approximation of intensity"@en ;
    rdfs:domain mobj:SoundIntensity ;
    rdfs:range :NoteDynamic ;
    owl:inverseOf :isRealisedAsIntensity .

:hasFrequencyAbstraction a owl:ObjectProperty ;
    rdfs:label "is abstraction of frequency"@en ;
    rdfs:domain mobj:Frequency ;
    rdfs:range :NotePitch ;
    owl:inverseOf :isRealisedAsFrequency .

:hasMidiPitch a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has midi pitch"@en ;
    rdfs:comment "The pitch of a note expressed by means of its MIDI number."@en ;
    rdfs:domain :NotePitch ;
    rdfs:range xsd:int .

:isDefinedByOctave a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "is defined by octave"@en ;
    rdfs:comment "The octave on which the note is defined."@en ;
    rdfs:domain :NotePitch ;
    rdfs:range xsd:int .

sp:hasMetric rdfs:seeAlso <http://purl.org/ontology/mto/TimeSignature> .

:groupsNoteEvent a owl:ObjectProperty ;
    rdfs:label "groups note event"@en ;
    rdfs:domain sp:HomogeneousFragment ;
    rdfs:range :SymbolicNote .

:hasDurationAbstraction a owl:ObjectProperty ;
    rdfs:label "is approximation of duration"@en ;
    rdfs:domain mobj:MusicalObjectDuration ;
    rdfs:range :NoteDuration ;
    owl:inverseOf :isRealisedAsDuration .

:hasLiteralDynamic a owl:DatatypeProperty ;
    rdfs:label "has literal dynamic"@en ;
    rdfs:comment "The dynamic expressed in a music score by means of adjectives (e.g. piano)."@en ;
    rdfs:domain :NoteDynamic ;
    rdfs:range xsd:string .

:hasMeasure a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has measure"@en ;
    rdfs:comment "The measure (expressed in bars) to which a note belongs in a music score."@en ;
    rdfs:domain :Position ;
    rdfs:range xsd:int .

:hasMidiVelocity a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has midi velocity"@en ;
    rdfs:comment "The dynamics of the note expressed symbolically by means of the MIDI command \"velocity\"."@en ;
    rdfs:domain :NoteDynamic ;
    rdfs:range xsd:int .

:hasNoteDuration a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has note duration"@en ;
    rdfs:comment "Connects a symbolic note to its symbolic quantised duration."@en ;
    rdfs:domain :SymbolicNote ;
    rdfs:range :NoteDuration ;
    owl:inverseOf :isDurationOfNote .

:hasNoteDynamic a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has note dynamic"@en ;
    rdfs:comment "Connects a symbolic note to its symbolic dynamic."@en ;
    rdfs:domain :SymbolicNote ;
    rdfs:range :NoteDynamic ;
    owl:inverseOf :isDynamicOf .

:hasNotePitch a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has note pitch"@en ;
    rdfs:comment "Connects a symbolic note to its symbolic pitch."@en ;
    rdfs:domain :SymbolicNote ;
    rdfs:range :NotePitch ;
    owl:inverseOf :isPitchOf .

:hasPosition a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has position"@en ;
    rdfs:domain :SymbolicNote ;
    rdfs:range :Position ;
    owl:inverseOf :isPositionOf .

:hasRealisation a owl:ObjectProperty ;
    rdfs:label "has realisation"@en ;
    rdfs:comment "Connects a symbolic note to its corresponding musical object, which is the realisation o f such symbolic note in a particular performance."@en ;
    rdfs:domain :SymbolicNote ;
    rdfs:range mobj:MusicalObject ;
    owl:inverseOf :isRealisationOf .

:isAccidentalOf a owl:ObjectProperty ;
    rdfs:label "is accidental of" ;
    rdfs:domain :Accidental ;
    rdfs:range :SymbolicNote .

:containsNoteEvent a owl:ObjectProperty ;
    rdfs:label "contains note event"@en ;
    rdfs:domain sp:Section,
        sp:Voice ;
    rdfs:range :SymbolicNote .

:isDurationOfNote a owl:ObjectProperty ;
    rdfs:label "is duration of note"@en ;
    rdfs:comment "Inverse of hasNoteDuration. Connects a duration class to the symbolic note that have this specific duration."@en ;
    rdfs:domain :NoteDuration ;
    rdfs:range :SymbolicNote .

:isDynamicOf a owl:ObjectProperty ;
    rdfs:label "is dynamic of"@en ;
    rdfs:comment "Inverse of hasNoteDynamic. Connects a duration class to the symbolic note that have this specific dynamic."@en ;
    rdfs:domain :NoteDynamic ;
    rdfs:range :SymbolicNote .

:isPitchOf a owl:ObjectProperty ;
    rdfs:label "is pitch of"@en ;
    rdfs:comment "Inverse of hasNotePitch. Connects a duration class to the symbolic note that have this specific pitch."@en ;
    rdfs:domain :NotePitch ;
    rdfs:range :SymbolicNote .

:isPositionOf a owl:ObjectProperty ;
    rdfs:label "is position of"@en ;
    rdfs:domain :Position ;
    rdfs:range :SymbolicNote .

:isRealisationOf a owl:ObjectProperty ;
    rdfs:label "is realisation of"@en ;
    rdfs:comment "Inverse of hasRealisation. Connects a musical object to the music symbolic music note of the same composition."@en ;
    rdfs:domain mobj:MusicalObject ;
    rdfs:range :SymbolicNote .

:isRealisedAsDuration a owl:ObjectProperty ;
    rdfs:label "is realised as duration"@en ;
    rdfs:domain :NoteDuration ;
    rdfs:range mobj:MusicalObjectDuration .

:isRealisedAsFrequency a owl:ObjectProperty ;
    rdfs:label "is realised as frequency"@en ;
    rdfs:domain :NotePitch ;
    rdfs:range mobj:Frequency .

:isRealisedAsIntensity a owl:ObjectProperty ;
    rdfs:label "is realised as intensity"@en ;
    rdfs:domain :NoteDynamic ;
    rdfs:range mobj:SoundIntensity .

mobj:Frequency a owl:Class .

mobj:MusicalObject a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom :SymbolicNote ;
            owl:onProperty :isRealisationOf ] .

mobj:MusicalObjectDuration a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasDurationAbstraction ;
            owl:someValuesFrom :NoteDuration ] ;
    owl:disjointWith :NoteDuration .

mobj:SoundIntensity a owl:Class .

:belongsToFragment a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "belongs to fragment"@en ;
    rdfs:domain :SymbolicNote ;
    rdfs:range sp:HomogeneousFragment ;
    owl:inverseOf :groupsNoteEvent .

sp:Section a owl:Class .

:A a owl:Class ;
    rdfs:label "A"@en ;
    rdfs:subClassOf :SymbolicNote ;
    owl:disjointWith :B,
        :C,
        :D,
        :E,
        :F,
        :G .

:Position a owl:Class ;
    rdfs:label "Position"@en ;
    rdfs:comment "The position of a symbolic note"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :SymbolicNote ;
            owl:onProperty :isPositionOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:int ;
            owl:onProperty :hasMeasure ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

:B a owl:Class ;
    rdfs:label "B"@en ;
    rdfs:subClassOf :SymbolicNote ;
    owl:disjointWith :C,
        :D,
        :E,
        :F,
        :G .

:Accidental a owl:Class ;
    rdfs:label "Accidental"@en ;
    rdfs:comment "The accidental of a note (e.g. sharp)."@en .

:C a owl:Class ;
    rdfs:label "C"@en ;
    rdfs:subClassOf :SymbolicNote ;
    owl:disjointWith :D,
        :E,
        :F,
        :G .

:DoubleFlat a owl:Class ;
    rdfs:label "Double Flat"@en ;
    rdfs:subClassOf :Accidental .

:DoubleSharp a owl:Class ;
    rdfs:label "Double Sharp"@en ;
    rdfs:subClassOf :Accidental .

:Flat a owl:Class ;
    rdfs:label "Flat"@en ;
    rdfs:subClassOf :Accidental .

:Natural a owl:Class ;
    rdfs:label "Natural"@en ;
    rdfs:subClassOf :Accidental .

:NoteDuration a owl:Class ;
    rdfs:label "Note Duration"@en ;
    rdfs:comment "The quantised duration of a symbolic music note."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :isRealisedAsDuration ;
            owl:someValuesFrom mobj:MusicalObjectDuration ],
        [ a owl:Restriction ;
            owl:onClass :SymbolicNote ;
            owl:onProperty :isDurationOfNote ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

:NoteDynamic a owl:Class ;
    rdfs:label "Note Dynamic"@en ;
    rdfs:comment "The dynamic of a symbolic note."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :isRealisedAsIntensity ;
            owl:someValuesFrom mobj:SoundIntensity ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:int ;
            owl:onProperty :hasMidiVelocity ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom :SymbolicNote ;
            owl:onProperty :isDynamicOf ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty :hasLiteralDynamic ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

:NotePitch a owl:Class ;
    rdfs:label "Note Pitch"@en ;
    rdfs:comment "The pitch of a symbolic note."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom :SymbolicNote ;
            owl:onProperty :isPitchOf ],
        [ a owl:Restriction ;
            owl:onProperty :isRealisedAsFrequency ;
            owl:someValuesFrom mobj:Frequency ] .

:Sharp a owl:Class ;
    rdfs:label "Sharp"@en ;
    rdfs:subClassOf :Accidental .

:D a owl:Class ;
    rdfs:label "D"@en ;
    rdfs:subClassOf :SymbolicNote ;
    owl:disjointWith :E,
        :F,
        :G .

:E a owl:Class ;
    rdfs:label "E"@en ;
    rdfs:subClassOf :SymbolicNote ;
    owl:disjointWith :F,
        :G .

:F a owl:Class ;
    rdfs:label "F"@en ;
    rdfs:subClassOf :SymbolicNote ;
    owl:disjointWith :G .

:G a owl:Class ;
    rdfs:label "G"@en ;
    rdfs:subClassOf :SymbolicNote .

:hasAccidental a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has accidental" ;
    rdfs:domain :SymbolicNote ;
    rdfs:range :Accidental ;
    owl:inverseOf :isAccidentalOf .

:SymbolicNote a owl:Class ;
    rdfs:label "Note Event"@en ;
    rdfs:comment "A music note from the western temperament system."@en ;
    rdfs:seeAlso <http://purl.org/ontology/mto/Note> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :NoteDynamic ;
            owl:onProperty :hasNoteDynamic ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass sp:HomogeneousFragment ;
            owl:onProperty :belongsToFragment ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :Position ;
            owl:onProperty :hasPosition ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :NotePitch ;
            owl:onProperty :hasNotePitch ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass sp:Voice ;
            owl:onProperty :belongsToFragment ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :hasRealisation ;
            owl:someValuesFrom mobj:MusicalObject ],
        [ a owl:Restriction ;
            owl:onClass :NoteDuration ;
            owl:onProperty :hasNoteDuration ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass sp:Section ;
            owl:onProperty :belongsToFragment ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

