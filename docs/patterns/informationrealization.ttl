    rdfs:subClassOf :SymbolicNote ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :D [ a owl:Restriction ;
                        owl:allValuesFrom :Sharp ;
                        owl:onProperty :hasAccidental ] ) ] .

