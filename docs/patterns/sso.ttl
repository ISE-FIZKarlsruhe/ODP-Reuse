@prefix dul: <http://www.loa-cnr.it/ontologies/DUL.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .

ssn:hasResult a owl:ObjectProperty ;
    rdfs:label "has result"@en ;
    rdfs:comment "The result (value or state) yielded by the observation."@en ;
    rdfs:domain ssn:Observation ;
    rdfs:range ssn:Property .

ssn:hasStimulus a owl:ObjectProperty ;
    rdfs:label "has stimulus"@en ;
    rdfs:comment "The stimulus that triggers / is involved in the observation."@en ;
    rdfs:domain ssn:Observation ;
    rdfs:range ssn:Stimulus .

ssn:isPropertyOf a owl:ObjectProperty ;
    rdfs:label "is property of"@en ;
    rdfs:comment "Associates a property with the feature of interest."@en ;
    rdfs:domain ssn:Property ;
    rdfs:range ssn:FeatureOfInterest .

ssn:madeBySensor a owl:ObjectProperty ;
    rdfs:label "made by sensor"@en ;
    rdfs:comment "The sensor that made the observation."@en ;
    rdfs:domain ssn:Observation ;
    rdfs:range ssn:Sensor .

ssn:observes a owl:ObjectProperty ;
    rdfs:label "observes"@en ;
    rdfs:comment "Which property the observation is about."@en ;
    rdfs:domain ssn:Observation ;
    rdfs:range ssn:Property .

ssn:FeatureOfInterest a owl:Class ;
    rdfs:label "FeatureOfInterest"@en ;
    rdfs:comment "The entity in the world whose property is observed."@en .

ssn:Sensor a owl:Class ;
    rdfs:label "Sensor"@en ;
    rdfs:comment "A device or mechanism that registers or detects a stimulus."@en .

ssn:Stimulus a owl:Class ;
    rdfs:label "Stimulus"@en ;
    rdfs:comment "A detectable environmental change that triggers a sensor."@en ;
    rdfs:subClassOf dul:Event .

ssn:Property a owl:Class ;
    rdfs:label "Property"@en ;
    rdfs:comment "A measurable property or characteristic of a feature of interest."@en .

ssn:Observation a owl:Class ;
    rdfs:label "Observation"@en ;
    rdfs:comment "The act or result of measurement or detection performed by a sensor."@en ;
    rdfs:subClassOf dul:Event .

