  <rdf:Description rdf:nodeID="n6f90a163dee245dcadbee249159b2339b14">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="n6f90a163dee245dcadbee249159b2339b17"/>
