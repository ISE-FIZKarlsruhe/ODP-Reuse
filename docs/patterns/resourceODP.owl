<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:odp="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:nodeID="n6f90a163dee245dcadbee249159b2339b22">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://w3id.org/CEON/ontology/resourceODP/Constituent"/>
    <owl:onProperty rdf:resource="http://w3id.org/CEON/ontology/resourceODP/hasConstituent"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/Constituent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Constituent</rdfs:label>
    <rdfs:comment>A constituent is a component of object.</rdfs:comment>
    <rdfs:seeAlso>http://emmo.info/emmo#EMMO_ceaaf9f7_fd11_424b_8fda_9afa186af186</rdfs:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/BatchOfObjects">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Batch Of Objects</rdfs:label>
    <rdfs:comment>A batch of objects is a collection of physical objects that are of the same type, e.g. a set of items (product instances) adhering to the same product model.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="n6f90a163dee245dcadbee249159b2339b14"/>
    <rdfs:subClassOf rdf:nodeID="n6f90a163dee245dcadbee249159b2339b19"/>
    <rdfs:subClassOf rdf:resource="http://w3id.org/CEON/ontology/resourceODP/Resource"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6f90a163dee245dcadbee249159b2339b3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://w3id.org/CEON/ontology/resourceODP/BatchOfObjects"/>
    <owl:onProperty rdf:resource="http://w3id.org/CEON/ontology/resourceODP/hasBatch"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/DigitalObject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Digital object</rdfs:label>
    <rdfs:comment>A digital object, e.g. a computer file, that is located on some server, hard drive, or on the web. Most often the digital object is the realization of some piece of information.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://w3id.org/CEON/ontology/resourceODP/Resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/Resource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Resource</rdfs:label>
    <rdfs:comment>Asset from which a solution is created or implemented. Depending on the context, reference to “resource” includes “raw material”, “feedstock”, “material” or “component”. Resource includes any energy type (e.g. the energy content or energy potential of materials). Note 4 to entry: Resources can be considered concerning both stocks and flows.</rdfs:comment>
    <rdfs:isDefinedBy>ISO 59004:2024 - 3.1.5 resource</rdfs:isDefinedBy>
    <rdfs:subClassOf rdf:nodeID="n6f90a163dee245dcadbee249159b2339b30"/>
    <rdfs:subClassOf rdf:nodeID="n6f90a163dee245dcadbee249159b2339b35"/>
    <rdfs:subClassOf rdf:nodeID="n6f90a163dee245dcadbee249159b2339b40"/>
    <rdfs:subClassOf rdf:resource="http://w3id.org/CEON/ontology/resourceODP/Asset"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:contributor>Eva Blomqvist</dcterms:contributor>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-03-20</dcterms:created>
    <dcterms:creator>Huanyu Li</dcterms:creator>
    <dcterms:description>A core ODP of the CEON ontology network defining aspects of the resource concept.</dcterms:description>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-06-30</dcterms:issued>
    <dcterms:license>https://creativecommons.org/licenses/by/4.0/</dcterms:license>
    <dcterms:publisher>Onto-DESIDE</dcterms:publisher>
    <dcterms:title>Circular Economy Ontology Network (CEON) - Resource ODP</dcterms:title>
    <vann:preferredNamespacePrefix>ceon-resourceODP</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>http://w3id.org/CEON/ontology/resourceODP/</vann:preferredNamespaceUri>
    <odp:coversRequirements>Covers the following requirements from Onto-DESIDE D3.1: CVN-Resource-1,3, CVN-Composition-1,2, CVN-ResrouceType-4, C7-3, E2-2, E4-6, E5-1, E6-3, T3-1.</odp:coversRequirements>
    <odp:coversRequirements>Covers the following requirements from Onto-DESIDE D3.2: CE1-2, CE3-3, CE4-3, CE5-2, CE9-1, CE10-1, CE11-8, CE12-2, CE12-4, C7-3, E2-2, E4-6, E5-1, E6-3, T3-1, T19-1, T20-1, T22-2.</odp:coversRequirements>
    <rdfs:seeAlso rdf:resource="https://github.com/LiUSemWeb/CEON"/>
    <owl:priorVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.4</owl:priorVersion>
    <owl:versionIRI rdf:resource="http://w3id.org/CEON/ontology/resourceODP/0.5/"/>
    <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6f90a163dee245dcadbee249159b2339b43">
    <rdf:first rdf:nodeID="n6f90a163dee245dcadbee249159b2339b41"/>
    <rdf:rest rdf:nodeID="n6f90a163dee245dcadbee249159b2339b44"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/batchLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>batch label</rdfs:label>
    <rdfs:comment>label for a batch</rdfs:comment>
    <rdfs:domain rdf:resource="http://w3id.org/CEON/ontology/resourceODP/BatchOfObjects"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/batchSize">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>batch size</rdfs:label>
    <rdfs:comment>batchSize intends to repsent how many physical objects are belong to a batch of objects.</rdfs:comment>
    <rdfs:domain rdf:resource="http://w3id.org/CEON/ontology/resourceODP/BatchOfObjects"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/PhysicalObject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Physical object</rdfs:label>
    <rdfs:comment>A physical object is a collection of matter.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="n6f90a163dee245dcadbee249159b2339b20"/>
    <rdfs:subClassOf rdf:nodeID="n6f90a163dee245dcadbee249159b2339b25"/>
    <rdfs:subClassOf rdf:resource="http://w3id.org/CEON/ontology/resourceODP/Resource"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6f90a163dee245dcadbee249159b2339b8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://w3id.org/CEON/ontology/resourceODP/PhysicalObject"/>
    <owl:onProperty rdf:resource="http://w3id.org/CEON/ontology/resourceODP/hasPhysicalObject"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/hasResourceQuality">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has resource quality</rdfs:label>
    <rdfs:comment>A resource can has specifc qualities.</rdfs:comment>
    <rdfs:domain rdf:resource="http://w3id.org/CEON/ontology/resourceODP/Resource"/>
    <rdfs:range rdf:resource="http://w3id.org/CEON/ontology/resourceODP/ResourceQuality"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6f90a163dee245dcadbee249159b2339b7">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://w3id.org/CEON/ontology/resourceODP/hasPhysicalObject"/>
    <owl:someValuesFrom rdf:resource="http://w3id.org/CEON/ontology/resourceODP/PhysicalObject"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6f90a163dee245dcadbee249159b2339b19">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    <owl:onProperty rdf:resource="http://w3id.org/CEON/ontology/resourceODP/batchSize"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6f90a163dee245dcadbee249159b2339b31">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://w3id.org/CEON/ontology/resourceODP/hasResourceCondition"/>
    <owl:someValuesFrom rdf:resource="http://w3id.org/CEON/ontology/resourceODP/ResourceCondition"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/hasPart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label>has part</rdfs:label>
    <rdfs:comment>Indicating that something is part of or is contained by something else.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6f90a163dee245dcadbee249159b2339b10">
    <rdf:first rdf:nodeID="n6f90a163dee245dcadbee249159b2339b8"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6f90a163dee245dcadbee249159b2339b9">
    <rdf:first rdf:nodeID="n6f90a163dee245dcadbee249159b2339b7"/>
    <rdf:rest rdf:nodeID="n6f90a163dee245dcadbee249159b2339b10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6f90a163dee245dcadbee249159b2339b23">
    <rdf:first rdf:nodeID="n6f90a163dee245dcadbee249159b2339b21"/>
    <rdf:rest rdf:nodeID="n6f90a163dee245dcadbee249159b2339b24"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/batchID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>batch ID</rdfs:label>
    <rdfs:comment>identifier for a batch</rdfs:comment>
    <rdfs:domain rdf:resource="http://w3id.org/CEON/ontology/resourceODP/BatchOfObjects"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/isRealizationOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>is realization of</rdfs:label>
    <rdfs:comment>Relates a thing, e.g. a digital object, or a physical object, to the information it is a realization of. C.f. a physical book that is the realization of a novel, or a pdf or Excel-file that is a realization of a certain data sheet.</rdfs:comment>
    <rdfs:range rdf:resource="http://w3id.org/CEON/ontology/resourceODP/Information"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6f90a163dee245dcadbee249159b2339b37">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://w3id.org/CEON/ontology/resourceODP/ResourceProperty"/>
    <owl:onProperty rdf:resource="http://w3id.org/CEON/ontology/resourceODP/hasResourceProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6f90a163dee245dcadbee249159b2339b2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://w3id.org/CEON/ontology/resourceODP/hasBatch"/>
    <owl:someValuesFrom rdf:resource="http://w3id.org/CEON/ontology/resourceODP/BatchOfObjects"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#wktLiteral">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/hasResourceLocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has resource location</rdfs:label>
    <rdfs:comment>Defines the location of a resource.</rdfs:comment>
    <rdfs:domain rdf:resource="http://w3id.org/CEON/ontology/resourceODP/Resource"/>
    <rdfs:range rdf:resource="http://w3id.org/CEON/ontology/location/Location"/>
    <rdfs:subPropertyOf rdf:resource="http://w3id.org/CEON/ontology/location/hasLocation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/Asset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Asset</rdfs:label>
    <rdfs:comment>Asset is sth that is valuable and useful to be used in activities, or owned by actors.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/Information">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Information</rdfs:label>
    <rdfs:comment>Information is an abstract concept that represents any kind of interpretations. For instance, information can be data generated by software systems or data used by people for communications.</rdfs:comment>
    <rdfs:seeAlso>http://emmo.info/emmo#EMMO_64c72d00_7582_44ea_a0b5_3a14e50acc36</rdfs:seeAlso>
    <rdfs:subClassOf rdf:resource="http://w3id.org/CEON/ontology/resourceODP/Asset"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6f90a163dee245dcadbee249159b2339b18">
    <rdf:first rdf:nodeID="n6f90a163dee245dcadbee249159b2339b16"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/license">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/containsInformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>contains information</rdfs:label>
    <rdfs:comment>Indicating that some piece of information is contained in a larger collection of information, e.g. a data sheet contains a statement about a certain parameter of a product.</rdfs:comment>
    <rdfs:domain rdf:resource="http://w3id.org/CEON/ontology/resourceODP/Information"/>
    <rdfs:range rdf:resource="http://w3id.org/CEON/ontology/resourceODP/Information"/>
    <rdfs:subPropertyOf rdf:resource="http://w3id.org/CEON/ontology/resourceODP/hasPart"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6f90a163dee245dcadbee249159b2339b21">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://w3id.org/CEON/ontology/resourceODP/hasConstituent"/>
    <owl:someValuesFrom rdf:resource="http://w3id.org/CEON/ontology/resourceODP/Constituent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6f90a163dee245dcadbee249159b2339b15">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://w3id.org/CEON/ontology/resourceODP/hasPhysicalObject"/>
    <owl:someValuesFrom rdf:resource="http://w3id.org/CEON/ontology/resourceODP/PhysicalObject"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/SetOfObjects">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Set of objects</rdfs:label>
    <rdfs:comment>A set of objects is a set of physical objects (items) that can be of different types, i.e. different kinds of items.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="n6f90a163dee245dcadbee249159b2339b1"/>
    <rdfs:subClassOf rdf:nodeID="n6f90a163dee245dcadbee249159b2339b6"/>
    <rdfs:subClassOf rdf:resource="http://w3id.org/CEON/ontology/resourceODP/Resource"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6f90a163dee245dcadbee249159b2339b17">
    <rdf:first rdf:nodeID="n6f90a163dee245dcadbee249159b2339b15"/>
    <rdf:rest rdf:nodeID="n6f90a163dee245dcadbee249159b2339b18"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6f90a163dee245dcadbee249159b2339b26">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://w3id.org/CEON/ontology/resourceODP/hasMatter"/>
    <owl:someValuesFrom rdf:resource="http://w3id.org/CEON/ontology/resourceODP/Matter"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6f90a163dee245dcadbee249159b2339b25">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="n6f90a163dee245dcadbee249159b2339b28"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/hasMatter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has matter</rdfs:label>
    <rdfs:comment>hasMatter intends to represent that a physical object can have a collection of matter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://w3id.org/CEON/ontology/resourceODP/PhysicalObject"/>
    <rdfs:range rdf:resource="http://w3id.org/CEON/ontology/resourceODP/Matter"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/ResourceProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Resource Property</rdfs:label>
    <rdfs:comment>The characteristics or attribuets of a resource.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6f90a163dee245dcadbee249159b2339b29">
    <rdf:first rdf:nodeID="n6f90a163dee245dcadbee249159b2339b27"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6f90a163dee245dcadbee249159b2339b1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="n6f90a163dee245dcadbee249159b2339b4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/created">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/Matter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Matter</rdfs:label>
    <rdfs:comment>A matter is a physical substance.</rdfs:comment>
    <rdfs:seeAlso>http://emmo.info/emmo#EMMO_5b2222df_4da6_442f_8244_96e9e45887d1</rdfs:seeAlso>
  </rdf:Description>
