  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/hasResourceCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has resource condition</rdfs:label>
