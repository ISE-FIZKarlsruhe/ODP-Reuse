  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/ResourceQuality">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Resource Quality</rdfs:label>
    <rdfs:comment>Resource quality is derived based on assessments of resources considering the conditions and properties.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/hasConstituent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has constituent</rdfs:label>
    <rdfs:comment>hasConstitutent intends to represent that a physical object can have a collection of composing components.</rdfs:comment>
    <rdfs:domain rdf:resource="http://w3id.org/CEON/ontology/resourceODP/PhysicalObject"/>
    <rdfs:range rdf:resource="http://w3id.org/CEON/ontology/resourceODP/Constituent"/>
    <rdfs:subPropertyOf rdf:resource="http://w3id.org/CEON/ontology/resourceODP/hasPart"/>
  </rdf:Description>
