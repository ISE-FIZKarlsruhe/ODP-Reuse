  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/CEON/ontology/resourceODP/ResourceCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Resource Condition</rdfs:label>
