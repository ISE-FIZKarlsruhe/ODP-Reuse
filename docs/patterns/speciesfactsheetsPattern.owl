<rdf:RDF xmlns="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesfactsheets.owl#" xml:base="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesfactsheets.owl" xmlns:species_taxonomic="http://www.fao.org/aims/aos/fi/species_taxonomic.owl#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:water_FAO_areas="http://www.fao.org/aims/aos/fi/water_FAO_areas.owl#" xmlns:owl2xml="http://www.w3.org/2006/12/owl2-xml#" xmlns:speciesfactsheet="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesfactsheet.owl#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:speciesspeciesfactsheets="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesspeciesfactsheets.owl#" xmlns:speciesfactsheets="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesfactsheets.owl#" xmlns:place="http://www.ontologydesignpatterns.org/cp/owl/place.owl#">
    <owl:Ontology rdf:about="">
        <owl:versionInfo>1.1
-  changed bathymetry datatype properties to xsd:int range for compatibility with data export</owl:versionInfo>
        <rdfs:comment>A design pattern that extends the RTMS taxonomic ontology, in order to give room for some factsheet-specific concepts.</rdfs:comment>
        <owl:imports rdf:resource="http://www.fao.org/aims/aos/fi/species_taxonomic.owl"/>
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/place.owl"/>
    </owl:Ontology>
    


