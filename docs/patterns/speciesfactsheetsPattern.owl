    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesfactsheet.owl#foundIn -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesfactsheet.owl#foundIn">
        <rdfs:label>hasFishingArea</rdfs:label>
        <rdfs:domain rdf:resource="http://www.fao.org/aims/aos/fi/species_taxonomic.owl#Species"/>
        <rdfs:range rdf:resource="http://www.fao.org/aims/aos/fi/water_FAO_areas.owl#FAO_fishing_area"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesfactsheets.owl#areaOfSpecies -->

    <owl:ObjectProperty rdf:about="#areaOfSpecies">
        <rdfs:label>isFishingAreaOf</rdfs:label>
        <rdfs:range rdf:resource="http://www.fao.org/aims/aos/fi/species_taxonomic.owl#Species"/>
        <rdfs:domain rdf:resource="http://www.fao.org/aims/aos/fi/water_FAO_areas.owl#FAO_fishing_area"/>
    </owl:ObjectProperty>
    


