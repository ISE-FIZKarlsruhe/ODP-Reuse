        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>hasMaxBathymetryValue</rdfs:label>
        <rdfs:domain rdf:resource="http://www.fao.org/aims/aos/fi/species_taxonomic.owl#Species"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesspeciesfactsheets.owl#hasMinBathymetryValue -->

