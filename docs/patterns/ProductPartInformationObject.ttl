@prefix : <https://raw.githubusercontent.com/FSCHOEN/CO-PLM/master/Ontology_Patterns/ProductPartInformationObject.owl#> .
@prefix DUL: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix om-2: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://raw.githubusercontent.com/FSCHOEN/CO-PLM/master/Ontology_Patterns/ProductPartInformationObject.owl> a owl:Ontology ;
    owl:imports om-2:,
        <https://raw.githubusercontent.com/FSCHOEN/CO-PLM/master/Ontology_Patterns/ProductPartInformationEntity.owl> .

:2DProductPartModel a owl:Class ;
    rdfs:subClassOf :GeometricalProductPartInformation .

:3DProductPartModel a owl:Class ;
    rdfs:subClassOf :GeometricalProductPartInformation .

:CircuitDiagram a owl:Class ;
    rdfs:subClassOf :GeometricalProductPartInformation .

:HydraulicPlan a owl:Class ;
    rdfs:subClassOf :GeometricalProductPartInformation .

:ProductPartManual a owl:Class ;
    rdfs:subClassOf :ProductPartForm .

:ProductPartMetainformation a owl:Class ;
    rdfs:subClassOf <https://raw.githubusercontent.com/FSCHOEN/CO-PLM/master/Ontology_Patterns/ProductPartInformationEntity.owl#ProductPartInformationObject> .

:ProductPartSpecification a owl:Class ;
    rdfs:subClassOf :ProductPartForm .

:ProductPartTestReport a owl:Class ;
    rdfs:subClassOf :ProductPartForm .

:hasBillOfMaterials a owl:ObjectProperty ;
    rdfs:domain <https://raw.githubusercontent.com/FSCHOEN/CO-PLM/master/Ontology_Patterns/ProductPartInformationEntity.owl#ProductPartInformationEntity> ;
    rdfs:range :BillOfMaterials ;
    rdfs:subPropertyOf DUL:associatedWith .

:PartEntry a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :BillOfMaterials ;
            owl:onProperty DUL:isConstituentOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <https://raw.githubusercontent.com/FSCHOEN/CO-PLM/master/Ontology_Patterns/ProductPartInformationEntity.owl#ProductPartInformationEntity> ;
            owl:onProperty DUL:hasConstituent ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass om-2:Measure ;
            owl:onProperty DUL:hasConstituent ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <https://raw.githubusercontent.com/FSCHOEN/CO-PLM/master/Ontology_Patterns/ProductPartInformationEntity.owl#ProductPartInformationObject> .

:BillOfMaterials a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty DUL:hasConstituent ;
            owl:someValuesFrom :PartEntry ],
        <https://raw.githubusercontent.com/FSCHOEN/CO-PLM/master/Ontology_Patterns/ProductPartInformationEntity.owl#ProductPartInformationObject> .

:ProductPartForm a owl:Class ;
    rdfs:subClassOf <https://raw.githubusercontent.com/FSCHOEN/CO-PLM/master/Ontology_Patterns/ProductPartInformationEntity.owl#ProductPartInformationObject> .

:GeometricalProductPartInformation a owl:Class ;
    rdfs:subClassOf <https://raw.githubusercontent.com/FSCHOEN/CO-PLM/master/Ontology_Patterns/ProductPartInformationEntity.owl#ProductPartInformationObject> .

<https://raw.githubusercontent.com/FSCHOEN/CO-PLM/master/Ontology_Patterns/ProductPartInformationEntity.owl#ProductPartInformationObject> a owl:Class .

