@prefix : <http://www.ontologydesignpatterns.org/cp/owl/bag.owl#> .
@prefix collectionentity: <http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.ontologydesignpatterns.org/cp/owl/bag.owl> a owl:Ontology ;
    cpannotationschema:coversRequirements "What are the items contained in this bag? "^^xsd:string,
        "What bag is this item an element of?"^^xsd:string,
        "What is the size of this bag?"^^xsd:string,
        "What resource does this item refer to?"^^xsd:string ;
    cpannotationschema:extractedFrom "http://swan.mindinformatics.org/ontologies/1.2/collections.owl"^^xsd:string ;
    cpannotationschema:hasAuthor "PaoloCiccarese"^^xsd:string ;
    cpannotationschema:hasComponent "http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl"^^xsd:string ;
    cpannotationschema:hasIntent "To model bags of items (elements). The Bag is characterized by a collection that can have multiple copies of each object. "^^xsd:string ;
    cpannotationschema:reengineeredFrom "http://swan.mindinformatics.org/ontologies/1.2/collections.owl"^^xsd:string ;
    cpannotationschema:relatedCPs "http://www.ontologydesignpatterns.org/cp/owl/list.owl"^^xsd:string,
        "http://www.ontologydesignpatterns.org/cp/owl/set.owl"^^xsd:string ;
    rdfs:comment "The Bag is characterized by a collection that can have multiple copies of each object. This is performed through the Item entity. The Item is linking exaclty one resource through the relationship itemContent."^^xsd:string ;
    owl:imports <http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl>,
        <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
    owl:versionInfo "Created with TopBraid Composer"^^xsd:string .

:itemOf a owl:ObjectProperty ;
    rdfs:label "item of"^^xsd:string ;
    rdfs:comment "item of - The link from an item to the Bag where it is contained"^^xsd:string ;
    rdfs:domain :Item ;
    rdfs:range :Bag ;
    rdfs:subPropertyOf collectionentity:isMemberOf ;
    owl:inverseOf :hasItem .

:size a owl:DatatypeProperty ;
    rdfs:label "size"^^xsd:string ;
    rdfs:comment "size - The number of items belonging to a collection"^^xsd:string ;
    rdfs:domain collectionentity:Collection ;
    rdfs:range xsd:integer .

:hasItem a owl:ObjectProperty ;
    rdfs:label "has item"^^xsd:string ;
    rdfs:comment "has item - The link to every item of the Bag"^^xsd:string ;
    rdfs:domain :Bag ;
    rdfs:range :Item ;
    rdfs:subPropertyOf collectionentity:hasMember .

:itemContent a owl:ObjectProperty ;
    rdfs:label "item content"^^xsd:string ;
    rdfs:comment "itemContent - The link to the actual resource to which the item refers."^^xsd:string ;
    rdfs:domain :Item ;
    rdfs:range [ a owl:Class ;
            owl:complementOf :Item ] .

:Bag a owl:Class ;
    rdfs:label "(collections) Bag"^^xsd:string ;
    rdfs:comment "Bag - Collection that can have a number of copies of each object"^^xsd:string ;
    rdfs:subClassOf collectionentity:Collection .

:Item a owl:Class ;
    rdfs:label "item"^^xsd:string ;
    rdfs:comment "Item - Element belonging to a Bag"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :itemContent ],
        owl:Thing ;
    owl:disjointWith collectionentity:Collection .

