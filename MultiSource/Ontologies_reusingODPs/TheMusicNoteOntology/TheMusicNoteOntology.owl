<?xml version="1.0"?>
<rdf:RDF xmlns="https://purl.org/andreapoltronieri/musicalobject#"
     xml:base="https://purl.org/andreapoltronieri/musicalobject"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:opla="http://ontologydesignpatterns.org/opla/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:owl2xml="http://www.w3.org/2006/12/owl2-xml#"
     xmlns:cpannotationschema="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#">
    <owl:Ontology rdf:about="https://purl.org/andreapoltronieri/musicalobject">
        <dc:creator>Andrea Poltronieri (University of Bologna)</dc:creator>
        <dc:description xml:lang="en">The Musical Object pattern models the acoustic features of a music note played in an actual performance.</dc:description>
        <dc:description xml:lang="en">The Note Pattern models a music note both in relation to a music score and in relation to the musical object produced by playing such note.</dc:description>
        <dc:description xml:lang="en">The Score Part module models the structure and the hierarchies of a music score.</dc:description>
        <dc:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/>
        <dc:title xml:lang="en">2021-07-17</dc:title>
        <dc:title xml:lang="en">Musical Object Pattern</dc:title>
        <dc:title xml:lang="en">Note Pattern</dc:title>
        <dc:title xml:lang="en">Score Part Pattern</dc:title>
        <terms:issued>2021-07-17</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/"/>
        <cpannotationschema:coversRequirements xml:lang="en">What is the instrument playing a specific score part?, How many voices does the score part have?, Which are the metrics defining the sections of the score part?</cpannotationschema:coversRequirements>
        <cpannotationschema:coversRequirements xml:lang="en">what is the fundamental frequency of a musical object?, what are the different frequencies that make up the spectrum of a musical object?, what is the duration in seconds of a musical object, in a given performance?, how is the envelope of a musical object shaped?</cpannotationschema:coversRequirements>
        <cpannotationschema:coversRequirements xml:lang="en">what is the name of a note?, what part of the score does a note belong to?, what are the dynamic indications referring to a note in the score?, what is the fundamental frequency of a note?, what are the different frequencies that make up the spectrum of a note?, what is the duration in seconds of a note, in a given performance?, how is the envelope of a note shaped?</cpannotationschema:coversRequirements>
        <cpannotationschema:extractedFrom rdf:resource="https://purl.org/andreapoltronieri/notepattern"/>
        <cpannotationschema:hasComponent rdf:resource="http://ontologydesignpatterns.org/wiki/Submissions:PartOf"/>
        <cpannotationschema:hasComponent rdf:resource="http://purl.org/net/nary-relation"/>
        <cpannotationschema:hasComponent rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl"/>
        <cpannotationschema:hasIntent xml:lang="en">The Music Note ODP models a symbolic note and its symbolic attributes.</cpannotationschema:hasIntent>
        <cpannotationschema:hasIntent xml:lang="en">This content ODP formalises the structure and the hierarchies of a music score/symbolic representation system.</cpannotationschema:hasIntent>
        <cpannotationschema:hasIntent xml:lang="en">This content ODP models the acoustic features of a music note played in a performance.</cpannotationschema:hasIntent>
        <cpannotationschema:hasUnitTest>SELECT ?note ?accidental
WHERE {?note rdf:type ?type.
  ?type rdfs:subClassOf* np:SymbolicNote
  OPTIONAL {?note np:hasAccidental ?accidental}}</cpannotationschema:hasUnitTest>
        <cpannotationschema:hasUnitTest>SELECT ?note ?durationSec
WHERE {?note np:hasRealisation ?musicalObj .  
  ?musicalObj mop:hasDuration ?duration . 
  ?duration mop:hasDurationInSeconds ?durationSec}</cpannotationschema:hasUnitTest>
        <cpannotationschema:hasUnitTest>SELECT ?note ?foundamFreq
WHERE {?note np:hasRealisation ?musicalObj .  
  ?musicalObj mop:hasFrequency ?foundamFreq . 
  ?foundamFreq a mop:FundamentalFrequency.}</cpannotationschema:hasUnitTest>
        <cpannotationschema:hasUnitTest>SELECT ?note ?freq
WHERE {?note np:hasRealisation ?musicalObj .  
  ?musicalObj mop:hasFrequency ?freq.}</cpannotationschema:hasUnitTest>
        <cpannotationschema:hasUnitTest>SELECT ?note ?literalDynamic ?midiVelocity
WHERE {?note np:hasNoteDynamic ?noteDynamic. 
  ?noteDynamic np:hasMidiVelocity ?midiVelocity 
  OPTIONAL {?noteDynamic np:hasLiteralDynamic ?literalDynamic}}</cpannotationschema:hasUnitTest>
        <cpannotationschema:hasUnitTest>SELECT ?note ?sustain ?decay ?release ?attack
WHERE {?note np:hasRealisation ?musicalObj .  
  ?musicalObj mop:hasEnvelope ?envelope . 
  ?envelope mop:hasSustain ?sustain;
 mop:hasDecay ?decay;
 mop:hasRelease ?release;
 mop:hasAttack ?attack.}</cpannotationschema:hasUnitTest>
        <cpannotationschema:hasUnitTest>SELECT DISTINCT ?note ?part
WHERE {{?note np:belongsToVoice ?voice. 
   ?voice spp:isVoiceOf ?part} 
  UNION {?note np:belongsToSection ?section. 
    ?section spp:isSectionOf ?part}}</cpannotationschema:hasUnitTest>
        <cpannotationschema:reengineeredFrom rdf:resource="https://purl.org/andreapoltronieri/HaMSEontology"/>
        <cpannotationschema:relatedCPs rdf:resource="https://purl.org/andreapoltronieri/musicalobject"/>
        <cpannotationschema:relatedCPs rdf:resource="https://purl.org/andreapoltronieri/scorepart"/>
        <rdfs:comment xml:lang="en">The Musical Object pattern models the acoustic features of a music note played in an actual performance.</rdfs:comment>
        <rdfs:comment xml:lang="en">The Note Pattern models a music note both in relation to a music score and in relation to the musical object produced by playing such note.</rdfs:comment>
        <rdfs:comment xml:lang="en">The Score Part pattern models the structure and the hierarchies of a music score.
In this module are used as template the following Ontology Design Patterns:</rdfs:comment>
        <rdfs:label xml:lang="en">Musical Object Pattern</rdfs:label>
        <rdfs:label xml:lang="en">Note Pattern</rdfs:label>
        <rdfs:label xml:lang="en">Score Part Pattern</rdfs:label>
        <owl:versionInfo xml:lang="en">Version 1.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://ontologydesignpatterns.org/opla/reusesPatternAsTemplate -->

    <owl:AnnotationProperty rdf:about="http://ontologydesignpatterns.org/opla/reusesPatternAsTemplate"/>
    


    <!-- http://purl.org/dc/elements/1.1/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/dc/elements/1.1/issued -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/issued"/>
    


    <!-- http://purl.org/dc/elements/1.1/language -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/language"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://purl.org/dc/terms/issued -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements">
        <rdfs:comment>This annotation property is used for exemplifying possible requirements the content pattern provides a solution for. Requirements are expressed as natural language competency questions.</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#extractedFrom -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#extractedFrom">
        <rdfs:comment>This annotation property should be assigned with a URI, which points to the possible reference ontology which the annotated pattern was extracted from (i.e. the reference ontology that the ontology elements have been deeply or partially cloned by). The range is not explicit in the definition of the annotation property because it would turn the ontology to OWL Full. E.g. The participation pattern is extracted from the Dolce Ultra Lite ontology, hence the value for this annotation property is http://www.ontologydesignpatterns.org/ont/dul/DUL.owl</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasComponent -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasComponent">
        <rdfs:comment>This annotation property is useful for content ontology design patterns. Its value is a URI, which refers to another content ontology design pattern which is a component of the annotated one.</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences">
        <rdfs:comment>This annotation property is used for briefly describing the benefits and/or possible trade-offs when using the CP.</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent">
        <rdfs:comment>This annotation property is used in order to describe the intent of the content pattern.</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasUnitTest -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasUnitTest">
        <rdfs:comment>This property can be used to annotate a unit test (e.g. in the form of a SPARQL query) to be launched to evaluate an ontology against a requirement-based task.</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isCloneOf -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isCloneOf">
        <rdfs:comment>This annotation property is used for referring a cloned ontology entity to its cloning source.</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isSpecializationOf -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isSpecializationOf">
        <rdfs:comment>This annotation property is useful for content ontology design patterns and its elements. Its value is a URI, which refers either to a content ontology design pattern that is specialized by the annotated one, or to an ontology element that is specialized by the annotated one.</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#reengineeredFrom -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#reengineeredFrom">
        <rdfs:comment>This annotation property should be assigned with a URI, which points to the concept schema, page, or anything else from which the annotated pattern was reengineered. If the source does not have any URI e.g., a printed book, this property value should provide information as precise as possible in order to identify the source. This property is alternative to the extractedFrom property because it is used when the pattern come from a concept schema which is not an owl ontology. For example content ontology design patterns, which are reengineered from data model patterns, rdf schemas, etc. should be annotatd with this property. E.g. The basicpersonalfoaf pattern is extracted from the rdf FOAF specification, hence the value for this annotation property is http://xmlns.com/foaf/spec/20071002.rdf</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#relatedCPs -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#relatedCPs">
        <rdfs:comment>This annotation property can be used to indicate other CPs (if any) that specialize, generalize, inlcude, or are components of the CP. Furthermore, this field may indicate other CPs that are typically used in conjunction with the described one. Important similarities and differences with other patterns can be also described here.</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios">
        <rdfs:comment>This annotation property is used for describing examples of instantiation of the Content OP. For example, for the part-of Content OP (which represents part-whole relations) a possible scenario is the sentence: &quot;the brain is part of the human body&quot;. Scenarios are expressed as natural language sentences.</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2002/07/owl#versionInfo -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#versionInfo"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://purl.org/andreapoltronieri/musicalobject/hasDuration -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/musicalobject/hasDuration">
        <owl:inverseOf rdf:resource="https://purl.org/andreapoltronieri/musicalobject/isDurationOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/musicalobject/MusicalObject"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/musicalobject/MusicalObjectDuration"/>
        <rdfs:comment xml:lang="en">Connects a musical object to its duration.</rdfs:comment>
        <rdfs:label xml:lang="en">has duration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/musicalobject/hasEnvelope -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/musicalobject/hasEnvelope">
        <owl:inverseOf rdf:resource="https://purl.org/andreapoltronieri/musicalobject/isEnvelopeOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/musicalobject/MusicalObject"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/musicalobject/Envelope"/>
        <rdfs:comment xml:lang="en">Connects a musical object to the envelope of the soundwave it produces.</rdfs:comment>
        <rdfs:label xml:lang="en">has envelope</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/musicalobject/hasFrequency -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/musicalobject/hasFrequency">
        <owl:inverseOf rdf:resource="https://purl.org/andreapoltronieri/musicalobject/isFrequencyOf"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/musicalobject/MusicalObject"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/musicalobject/Frequency"/>
        <rdfs:comment xml:lang="en">Connects a musical object to the frequencies it produces.</rdfs:comment>
        <rdfs:label xml:lang="en">has frequency</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/musicalobject/hasSoundIntensity -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/musicalobject/hasSoundIntensity">
        <owl:inverseOf rdf:resource="https://purl.org/andreapoltronieri/musicalobject/isSoundIntensityOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/musicalobject/MusicalObject"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/musicalobject/SoundIntensity"/>
        <rdfs:comment xml:lang="en">Connects a musical object to the sound intensity produced.</rdfs:comment>
        <rdfs:label xml:lang="en">has sound intensity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/musicalobject/isDurationOf -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/musicalobject/isDurationOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/musicalobject/MusicalObjectDuration"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/musicalobject/MusicalObject"/>
        <rdfs:comment xml:lang="en">Inverse of hasDuration. Connects the duration of a musical event to the musical event itself.</rdfs:comment>
        <rdfs:label xml:lang="en">is duration of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/musicalobject/isEnvelopeOf -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/musicalobject/isEnvelopeOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/musicalobject/Envelope"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/musicalobject/MusicalObject"/>
        <rdfs:comment xml:lang="en">Inverse of hasEvelope. Connects the envelope of a musical event to the musical event itself.</rdfs:comment>
        <rdfs:label xml:lang="en">is envelope of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/musicalobject/isFrequencyOf -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/musicalobject/isFrequencyOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/musicalobject/Frequency"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/musicalobject/MusicalObject"/>
        <rdfs:comment xml:lang="en">Inverse of hasFrequency. Connects the frequency of a musical event to the musical event itself.</rdfs:comment>
        <rdfs:label xml:lang="en">is frequency of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/musicalobject/isSoundIntensityOf -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/musicalobject/isSoundIntensityOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/musicalobject/SoundIntensity"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/musicalobject/MusicalObject"/>
        <rdfs:comment xml:lang="en">Inverse of hasSoundIntensity. Connects the sound intensity of a musical event to the musical event itself.</rdfs:comment>
        <rdfs:label xml:lang="en">is sound intensity of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/belongsToFragment -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/belongsToFragment">
        <owl:inverseOf rdf:resource="https://purl.org/andreapoltronieri/notepattern/groupsNoteEvent"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/notepattern/SymbolicNote"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/scorepart/HomogeneousFragment"/>
        <rdfs:label xml:lang="en">belongs to fragment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/belongsToSection -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/belongsToSection">
        <owl:inverseOf rdf:resource="https://purl.org/andreapoltronieri/notepattern/containsNoteEvent"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/notepattern/SymbolicNote"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/scorepart/Section"/>
        <rdfs:label xml:lang="en">belongs to section</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/belongsToVoice -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/belongsToVoice">
        <owl:inverseOf rdf:resource="https://purl.org/andreapoltronieri/notepattern/containsNoteEvent"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/notepattern/SymbolicNote"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/scorepart/Voice"/>
        <rdfs:label xml:lang="en">belongs to voice</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/containsNoteEvent -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/containsNoteEvent">
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/scorepart/Section"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/scorepart/Voice"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/notepattern/SymbolicNote"/>
        <rdfs:label xml:lang="en">contains note event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/groupsNoteEvent -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/groupsNoteEvent">
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/scorepart/HomogeneousFragment"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/notepattern/SymbolicNote"/>
        <rdfs:label xml:lang="en">groups note event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/hasAccidental -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/hasAccidental">
        <owl:inverseOf rdf:resource="https://purl.org/andreapoltronieri/notepattern/isAccidentalOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/notepattern/SymbolicNote"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/notepattern/Accidental"/>
        <rdfs:label>has accidental</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/hasDurationAbstraction -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/hasDurationAbstraction">
        <owl:inverseOf rdf:resource="https://purl.org/andreapoltronieri/notepattern/isRealisedAsDuration"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/musicalobject/MusicalObjectDuration"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/notepattern/NoteDuration"/>
        <rdfs:label xml:lang="en">is approximation of duration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/hasDynamicAbstraction -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/hasDynamicAbstraction">
        <owl:inverseOf rdf:resource="https://purl.org/andreapoltronieri/notepattern/isRealisedAsIntensity"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/musicalobject/SoundIntensity"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/notepattern/NoteDynamic"/>
        <rdfs:label xml:lang="en">is approximation of intensity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/hasFrequencyAbstraction -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/hasFrequencyAbstraction">
        <owl:inverseOf rdf:resource="https://purl.org/andreapoltronieri/notepattern/isRealisedAsFrequency"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/musicalobject/Frequency"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/notepattern/NotePitch"/>
        <rdfs:label xml:lang="en">is abstraction of frequency</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/hasNoteDuration -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/hasNoteDuration">
        <owl:inverseOf rdf:resource="https://purl.org/andreapoltronieri/notepattern/isDurationOfNote"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/notepattern/SymbolicNote"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/notepattern/NoteDuration"/>
        <rdfs:comment xml:lang="en">Connects a symbolic note to its symbolic quantised duration.</rdfs:comment>
        <rdfs:label xml:lang="en">has note duration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/hasNoteDynamic -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/hasNoteDynamic">
        <owl:inverseOf rdf:resource="https://purl.org/andreapoltronieri/notepattern/isDynamicOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/notepattern/SymbolicNote"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/notepattern/NoteDynamic"/>
        <rdfs:comment xml:lang="en">Connects a symbolic note to its symbolic dynamic.</rdfs:comment>
        <rdfs:label xml:lang="en">has note dynamic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/hasNotePitch -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/hasNotePitch">
        <owl:inverseOf rdf:resource="https://purl.org/andreapoltronieri/notepattern/isPitchOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/notepattern/SymbolicNote"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/notepattern/NotePitch"/>
        <rdfs:comment xml:lang="en">Connects a symbolic note to its symbolic pitch.</rdfs:comment>
        <rdfs:label xml:lang="en">has note pitch</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/hasPosition -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/hasPosition">
        <owl:inverseOf rdf:resource="https://purl.org/andreapoltronieri/notepattern/isPositionOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/notepattern/SymbolicNote"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/notepattern/Position"/>
        <rdfs:label xml:lang="en">has position</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/hasRealisation -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/hasRealisation">
        <owl:inverseOf rdf:resource="https://purl.org/andreapoltronieri/notepattern/isRealisationOf"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/notepattern/SymbolicNote"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/musicalobject/MusicalObject"/>
        <rdfs:comment xml:lang="en">Connects a symbolic note to its corresponding musical object, which is the realisation o f such symbolic note in a particular performance.</rdfs:comment>
        <rdfs:label xml:lang="en">has realisation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/isAccidentalOf -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/isAccidentalOf">
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/notepattern/Accidental"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/notepattern/SymbolicNote"/>
        <rdfs:label>is accidental of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/isDurationOfNote -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/isDurationOfNote">
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/notepattern/NoteDuration"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/notepattern/SymbolicNote"/>
        <rdfs:comment xml:lang="en">Inverse of hasNoteDuration. Connects a duration class to the symbolic note that have this specific duration.</rdfs:comment>
        <rdfs:label xml:lang="en">is duration of note</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/isDynamicOf -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/isDynamicOf">
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/notepattern/NoteDynamic"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/notepattern/SymbolicNote"/>
        <rdfs:comment xml:lang="en">Inverse of hasNoteDynamic. Connects a duration class to the symbolic note that have this specific dynamic.</rdfs:comment>
        <rdfs:label xml:lang="en">is dynamic of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/isPitchOf -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/isPitchOf">
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/notepattern/NotePitch"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/notepattern/SymbolicNote"/>
        <rdfs:comment xml:lang="en">Inverse of hasNotePitch. Connects a duration class to the symbolic note that have this specific pitch.</rdfs:comment>
        <rdfs:label xml:lang="en">is pitch of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/isPositionOf -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/isPositionOf">
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/notepattern/Position"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/notepattern/SymbolicNote"/>
        <rdfs:label xml:lang="en">is position of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/isRealisationOf -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/isRealisationOf">
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/musicalobject/MusicalObject"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/notepattern/SymbolicNote"/>
        <rdfs:comment xml:lang="en">Inverse of hasRealisation. Connects a musical object to the music symbolic music note of the same composition.</rdfs:comment>
        <rdfs:label xml:lang="en">is realisation of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/isRealisedAsDuration -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/isRealisedAsDuration">
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/notepattern/NoteDuration"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/musicalobject/MusicalObjectDuration"/>
        <rdfs:label xml:lang="en">is realised as duration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/isRealisedAsFrequency -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/isRealisedAsFrequency">
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/notepattern/NotePitch"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/musicalobject/Frequency"/>
        <rdfs:label xml:lang="en">is realised as frequency</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/isRealisedAsIntensity -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/isRealisedAsIntensity">
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/notepattern/NoteDynamic"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/musicalobject/SoundIntensity"/>
        <rdfs:label xml:lang="en">is realised as intensity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/scorepart/hasFragment -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/scorepart/hasFragment">
        <owl:inverseOf rdf:resource="https://purl.org/andreapoltronieri/scorepart/isFragmentOf"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/scorepart/Part"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/scorepart/HomogeneousFragment"/>
        <rdfs:comment xml:lang="en">Connects the part of the score/symbolic notation to its constituing sections.</rdfs:comment>
        <rdfs:label xml:lang="en">has section</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/scorepart/hasSection -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/scorepart/hasSection">
        <owl:inverseOf rdf:resource="https://purl.org/andreapoltronieri/scorepart/isSectionOf"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/scorepart/Part"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/scorepart/Section"/>
        <rdfs:label xml:lang="en">has section</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/scorepart/hasVoice -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/scorepart/hasVoice">
        <owl:inverseOf rdf:resource="https://purl.org/andreapoltronieri/scorepart/isVoiceOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/scorepart/Part"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/scorepart/Voice"/>
        <rdfs:comment xml:lang="en">Connects the part of the score/symbolic notation to its constituing sections.</rdfs:comment>
        <rdfs:label xml:lang="en">has voice</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/scorepart/isFragmentOf -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/scorepart/isFragmentOf">
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/scorepart/HomogeneousFragment"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/scorepart/Part"/>
        <rdfs:comment xml:lang="en">Inverse of hasFragment. Connects the section of the score/symbolic notation to the belongng part.</rdfs:comment>
        <rdfs:label xml:lang="en">is section of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/scorepart/isPlayedBy -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/scorepart/isPlayedBy">
        <owl:inverseOf rdf:resource="https://purl.org/andreapoltronieri/scorepart/playsPart"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/scorepart/Part"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/scorepart/Instrument"/>
        <rdfs:comment xml:lang="en">Connects the part of the score/symbolic notation to the instrument that is assigned to play such part.</rdfs:comment>
        <rdfs:label xml:lang="en">is played by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/scorepart/isSectionOf -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/scorepart/isSectionOf">
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/scorepart/Section"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/scorepart/Part"/>
        <rdfs:label xml:lang="en">is section of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/scorepart/isVoiceOf -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/scorepart/isVoiceOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/scorepart/Voice"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/scorepart/Part"/>
        <rdfs:comment xml:lang="en">Inverse of hasVoice. Connects the voice of the score/symbolic notation to the belongng part.</rdfs:comment>
        <rdfs:label xml:lang="en">is voice of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/andreapoltronieri/scorepart/playsPart -->

    <owl:ObjectProperty rdf:about="https://purl.org/andreapoltronieri/scorepart/playsPart">
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/scorepart/Instrument"/>
        <rdfs:range rdf:resource="https://purl.org/andreapoltronieri/scorepart/Part"/>
        <rdfs:comment xml:lang="en">Inverse of isPlayedBy. Connects an instrument to the the part that the instrument plays.</rdfs:comment>
        <rdfs:label xml:lang="en">plays part</rdfs:label>
    </owl:ObjectProperty>
    


