    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://purl.org/andreapoltronieri/musicalobject#hasIntensityValue -->

    <owl:DatatypeProperty rdf:about="https://purl.org/andreapoltronieri/musicalobject#hasIntensityValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/musicalobject/SoundIntensity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">The value of the sound intensity of a musical object.</rdfs:comment>
        <rdfs:label xml:lang="en">intensity value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/andreapoltronieri/musicalobject/hasAttack -->

    <owl:DatatypeProperty rdf:about="https://purl.org/andreapoltronieri/musicalobject/hasAttack">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/musicalobject/Envelope"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Describes the attack time (epressed in seconds) of the soundwave&apos;s envelope, according to the ADSR model.</rdfs:comment>
        <rdfs:label xml:lang="en">has attack</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/andreapoltronieri/musicalobject/hasDecay -->

    <owl:DatatypeProperty rdf:about="https://purl.org/andreapoltronieri/musicalobject/hasDecay">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/musicalobject/Envelope"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Describes the decay time (epressed in seconds) of the soundwave&apos;s envelope, according to the ADSR model.</rdfs:comment>
        <rdfs:label xml:lang="en">has decay</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/andreapoltronieri/musicalobject/hasDurationInSeconds -->

    <owl:DatatypeProperty rdf:about="https://purl.org/andreapoltronieri/musicalobject/hasDurationInSeconds">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/musicalobject/MusicalObjectDuration"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Expresses the duration in seconds of a musical object.</rdfs:comment>
        <rdfs:label xml:lang="en">has duration in seconds</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/andreapoltronieri/musicalobject/hasFrequencyMagnitude -->

    <owl:DatatypeProperty rdf:about="https://purl.org/andreapoltronieri/musicalobject/hasFrequencyMagnitude">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/musicalobject/Frequency"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">The amplitude of a frequency component of a complex sound.</rdfs:comment>
        <rdfs:label xml:lang="en">has frequency amplitude</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/andreapoltronieri/musicalobject/hasRelease -->

    <owl:DatatypeProperty rdf:about="https://purl.org/andreapoltronieri/musicalobject/hasRelease">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/musicalobject/Envelope"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Describes the release time (epressed in seconds) of the soundwave&apos;s envelope, according to the ADSR model.</rdfs:comment>
        <rdfs:label xml:lang="en">has release</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/andreapoltronieri/musicalobject/hasSustain -->

    <owl:DatatypeProperty rdf:about="https://purl.org/andreapoltronieri/musicalobject/hasSustain">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/musicalobject/Envelope"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Describes the sustain time (epressed in seconds) of the soundwave&apos;s envelope, according to the ADSR model.</rdfs:comment>
        <rdfs:label xml:lang="en">has sustain</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern#hasPositionInMeasure -->

    <owl:DatatypeProperty rdf:about="https://purl.org/andreapoltronieri/notepattern#hasPositionInMeasure">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/notepattern/Position"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label xml:lang="en">has position in measure</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/hasLiteralDynamic -->

    <owl:DatatypeProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/hasLiteralDynamic">
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/notepattern/NoteDynamic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The dynamic expressed in a music score by means of adjectives (e.g. piano).</rdfs:comment>
        <rdfs:label xml:lang="en">has literal dynamic</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/hasMeasure -->

    <owl:DatatypeProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/hasMeasure">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/notepattern/Position"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">The measure (expressed in bars) to which a note belongs in a music score.</rdfs:comment>
        <rdfs:label xml:lang="en">has measure</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/hasMidiPitch -->

    <owl:DatatypeProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/hasMidiPitch">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/notepattern/NotePitch"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">The pitch of a note expressed by means of its MIDI number.</rdfs:comment>
        <rdfs:label xml:lang="en">has midi pitch</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/hasMidiVelocity -->

    <owl:DatatypeProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/hasMidiVelocity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/notepattern/NoteDynamic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">The dynamics of the note expressed symbolically by means of the MIDI command &quot;velocity&quot;.</rdfs:comment>
        <rdfs:label xml:lang="en">has midi velocity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/andreapoltronieri/notepattern/isDefinedByOctave -->

    <owl:DatatypeProperty rdf:about="https://purl.org/andreapoltronieri/notepattern/isDefinedByOctave">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/notepattern/NotePitch"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">The octave on which the note is defined.</rdfs:comment>
        <rdfs:label xml:lang="en">is defined by octave</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/andreapoltronieri/scorepart/hasClef -->

    <owl:DatatypeProperty rdf:about="https://purl.org/andreapoltronieri/scorepart/hasClef">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/scorepart/HomogeneousFragment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The clef that describes the hight of a note in a music score fragment.</rdfs:comment>
        <rdfs:label xml:lang="en">has clef</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/andreapoltronieri/scorepart/hasMetric -->

    <owl:DatatypeProperty rdf:about="https://purl.org/andreapoltronieri/scorepart/hasMetric">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/andreapoltronieri/scorepart/HomogeneousFragment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">The metric of a specific fragment of a music score.</rdfs:comment>
        <rdfs:label xml:lang="en">has metric</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.org/ontology/mto/TimeSignature"/>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/andreapoltronieri/scorepart/hasMidiProgram -->

    <owl:DatatypeProperty rdf:about="https://purl.org/andreapoltronieri/scorepart/hasMidiProgram">
